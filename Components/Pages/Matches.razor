    private async Task LoadCourtBothTeamsAsync()
    {
        if (!SelectedMatchId.HasValue || SelectedMatch is null)
        {
            _spatialHome = null;
            _spatialAway = null;
            _isCourtBothLoading = false;
            return;
        }

        var matchId = SelectedMatchId.Value;
        var attackFilter = MatchAttackTypeFilter is "all" or "" ? null : MatchAttackTypeFilter;
        var attackSuffix = attackFilter is null ? string.Empty : $"|{attackFilter}";
        var cacheKeyHome = $"court-home{attackSuffix}";
        var cacheKeyAway = $"court-away{attackSuffix}";
        var cache = GetMatchDetailCache(matchId);

        var homeHit = cache.SpatialByContext.TryGetValue(cacheKeyHome, out var cachedHome) && cachedHome is not null;
        var awayHit = cache.SpatialByContext.TryGetValue(cacheKeyAway, out var cachedAway) && cachedAway is not null;

        if (homeHit && awayHit)
        {
            _spatialHome = cachedHome;
            _spatialAway = cachedAway;
            _isCourtBothLoading = false;
            await InvokeAsync(StateHasChanged);
            return;
        }

        _isCourtBothLoading = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            var opts = BuildMatchSpatialQueryOptions(null);
            var team1Id = SelectedMatch.Team1Id;
            var team2Id = SelectedMatch.Team2Id;

            var homeTask = homeHit
                ? Task.FromResult<MatchSpatialStatsDto?>(cachedHome)
                : StatsApiClient.GetMatchSpatialAsync(matchId, team1Id, attackFilter, opts);
            var awayTask = awayHit
                ? Task.FromResult<MatchSpatialStatsDto?>(cachedAway)
                : StatsApiClient.GetMatchSpatialAsync(matchId, team2Id, attackFilter, opts);

            await Task.WhenAll(homeTask, awayTask);

            if (!SelectedMatchId.HasValue || SelectedMatchId.Value != matchId)
            {
                return;
            }

            var homeResult = await homeTask;
            var awayResult = await awayTask;

            if (homeResult is not null) cache.SpatialByContext[cacheKeyHome] = homeResult;
            if (awayResult is not null) cache.SpatialByContext[cacheKeyAway] = awayResult;

            _spatialHome = homeResult;
            _spatialAway = awayResult;
        }
        catch
        {
            if (!SelectedMatchId.HasValue || SelectedMatchId.Value != matchId)
            {
                return;
            }

            _spatialHome = null;
            _spatialAway = null;
        }
        finally
        {
            if (SelectedMatchId.HasValue && SelectedMatchId.Value == matchId)
            {
                _isCourtBothLoading = false;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private async Task LoadSelectedSpatialAsync(string? focusZoneKey = null)
    {
        if (!SelectedMatchId.HasValue || SelectedMatch is null)
        {
            MatchSpatial = null;
            ActiveZoneKey = null;
            SpatialFocusKey = null;
            IsSpatialLoading = false;
            return;
        }

        var matchId = SelectedMatchId.Value;
        var scopeKey = MatchSpatialScopeKey;
        var teamId = MatchSpatialTeamId;
        var cache = GetMatchDetailCache(matchId);
        var cacheKey = GetMatchSpatialCacheKey(scopeKey, focusZoneKey);
        var loadToken = System.Threading.Interlocked.Increment(ref SpatialLoadToken);

        if (cache.SpatialByContext.TryGetValue(cacheKey, out var cachedSpatial) && cachedSpatial is not null)
        {
            MatchSpatial = cachedSpatial;
            SpatialFocusKey = focusZoneKey;
            ActiveZoneKey = ResolveActiveZoneKey(focusZoneKey);
            IsSpatialLoading = false;
            ErrorMessage = null;
            await InvokeAsync(StateHasChanged);
            return;
        }

        if (cache.SpatialByContext.ContainsKey(cacheKey))
        {
            cache.SpatialByContext.Remove(cacheKey);
        }

        IsSpatialLoading = true;
        await InvokeAsync(StateHasChanged);
        await Task.Yield();

        try
        {
            var spatial = await StatsApiClient.GetMatchSpatialAsync(matchId, teamId, MatchAttackTypeFilter is "all" or "" ? null : MatchAttackTypeFilter, BuildMatchSpatialQueryOptions(focusZoneKey));

            if (loadToken != SpatialLoadToken || !SelectedMatchId.HasValue || SelectedMatchId.Value != matchId || !string.Equals(scopeKey, MatchSpatialScopeKey, StringComparison.OrdinalIgnoreCase))
            {
                return;
            }

            if (spatial is not null)
            {
                cache.SpatialByContext[cacheKey] = spatial;
            }

            MatchSpatial = spatial;
            SpatialFocusKey = focusZoneKey;
            ActiveZoneKey = ResolveActiveZoneKey(focusZoneKey);
            ErrorMessage = null;
        }
        catch (Exception ex)
        {
            if (loadToken != SpatialLoadToken || !SelectedMatchId.HasValue || SelectedMatchId.Value != matchId || !string.Equals(scopeKey, MatchSpatialScopeKey, StringComparison.OrdinalIgnoreCase))
            {
                return;
            }

            MatchSpatial = null;
            ActiveZoneKey = null;
            SpatialFocusKey = null;
            ErrorMessage = ex.Message;
        }
        finally
        {
            if (loadToken == SpatialLoadToken && SelectedMatchId.HasValue && SelectedMatchId.Value == matchId && string.Equals(scopeKey, MatchSpatialScopeKey, StringComparison.OrdinalIgnoreCase))
            {
                IsSpatialLoading = false;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private string GetMatchSpatialCacheKey(string scopeKey, string? focusZoneKey)
    {
        var attackSuffix = MatchAttackTypeFilter is "all" or "" ? string.Empty : $"|{MatchAttackTypeFilter}";
        if (string.IsNullOrWhiteSpace(focusZoneKey))
        {
            return $"{scopeKey}{attackSuffix}";
        }

        return $"{scopeKey}|{focusZoneKey.Trim().ToUpperInvariant()}{attackSuffix}";
    }

    private StatsQueryOptionsDto BuildMatchSpatialQueryOptions(string? focusZoneKey)
    {
        var options = new StatsQueryOptionsDto();

        if (string.IsNullOrWhiteSpace(focusZoneKey))
        {
            return options;
        }

        if (SpatialZoneVisuals.IsTriggerZoneKey(focusZoneKey))
        {
            options.Trigger = SpatialZoneVisuals.ToBackendTriggerKey(focusZoneKey);
        }
        else
        {
            options.ShootShade = focusZoneKey.Trim();
        }

        return options;
    }

    private string? ResolveActiveZoneKey(string? preferredKey = null)
    {
        var allZoneKeys = GoalZones
            .Concat(TriggerZones)
            .Select(zone => zone.Key)
            .Where(key => !string.IsNullOrWhiteSpace(key))
            .ToHashSet(StringComparer.OrdinalIgnoreCase);

        if (!string.IsNullOrWhiteSpace(preferredKey) && allZoneKeys.Contains(preferredKey))
        {
            return preferredKey;
        }

        if (!string.IsNullOrWhiteSpace(ActiveZoneKey) && allZoneKeys.Contains(ActiveZoneKey))
        {
            return ActiveZoneKey;
        }

        return GoalZones.FirstOrDefault(zone => zone.Attempts > 0)?.Key
            ?? TriggerZones.FirstOrDefault(zone => zone.Attempts > 0)?.Key
            ?? GoalZones.FirstOrDefault()?.Key
            ?? TriggerZones.FirstOrDefault()?.Key;
    }

