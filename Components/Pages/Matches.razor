    private IReadOnlyList<MetricPlotPoint> BuildMatchProfileSeries()
    {
        var players = GetScopedMatchPlayers().ToList();
        if (players.Count == 0)
        {
            return [];
        }

        return
        [
            new MetricPlotPoint("Buts", players.Sum(p => p.TotalGoals + p.PenaltyGoalCount)),
            new MetricPlotPoint("Passes", players.Sum(p => p.AssistCount)),
            new MetricPlotPoint("Interceptions", players.Sum(p => p.InterceptionCount)),
            new MetricPlotPoint("Arrets", players.Sum(p => p.SaveCount)),
            new MetricPlotPoint("Pertes", players.Sum(p => p.TurnoverCount)),
            new MetricPlotPoint("Sanctions", players.Sum(p => p.SanctionCount))
        ];
    }

    private IReadOnlyList<MetricPlotPoint> BuildMatchTeamComparisonSeries(int? teamId, string? teamName)
    {
        if (SelectedMatch is null || MatchPlayers.Count == 0)
        {
            return [];
        }

        var teamPlayers = teamId.HasValue
            ? MatchPlayers.Where(player => player.TeamId == teamId).ToList()
            : MatchPlayers.Where(player => string.Equals(player.TeamName?.Trim(), teamName?.Trim(), StringComparison.OrdinalIgnoreCase)).ToList();

        if (teamPlayers.Count == 0)
        {
            return [];
        }

        var goals = teamPlayers.Sum(player => player.TotalGoals);
        var passes = teamPlayers.Sum(player => player.AssistCount);
        var defense = teamPlayers.Sum(player => player.InterceptionCount + player.SaveCount);
        var turnovers = teamPlayers.Sum(player => player.TurnoverCount);
        var volume = goals + passes + defense + turnovers;

        return
        [
            new MetricPlotPoint("Buts", goals),
            new MetricPlotPoint("Passes", passes),
            new MetricPlotPoint("Defense", defense),
            new MetricPlotPoint("Pertes", turnovers),
            new MetricPlotPoint("Volume", volume)
        ];
    }

