@page "/export"
@inject ExportApiClient ExportClient
@inject IApiAuthService AuthService
@inject AnalysisScopeService ScopeService
@inject ReferenceDataService RefData
@inject PlayersApiClient PlayersClient
@inject MatchesApiClient MatchesClient
@implements IDisposable

<PageTitle>Export</PageTitle>

<div class="export-workspace" data-workspace="export">
    @if (!AuthService.Session.IsAuthenticated)
    {
        <AccessRequiredCard Message="Connectez-vous pour générer un export analytique." />
    }
    else
    {
        <div class="wizard__steps" role="navigation" aria-label="Étapes d'export">
            <div class="@WizardStepCss(1)">
                <span class="wizard__step-num">1</span>
                <span class="wizard__step-label">Cible</span>
            </div>
            <div class="wizard__step-sep"></div>
            <div class="@WizardStepCss(2)">
                <span class="wizard__step-num">2</span>
                <span class="wizard__step-label">Contenu</span>
            </div>
            <div class="wizard__step-sep"></div>
            <div class="@WizardStepCss(3)">
                <span class="wizard__step-num">3</span>
                <span class="wizard__step-label">Options</span>
            </div>
        </div>

        @if (_exportStep == 1)
        {
            <div class="wizard__panel">

                <!-- Scope selectors -->
                @if (_refData.Competitions.Count > 0)
                {
                    <div class="export-scope-edit">
                        <div class="export-scope-edit__body">
                            <div class="scope-field">
                                <label class="scope-field__label" for="exp-competition">Compétition</label>
                                <select id="exp-competition"
                                        class="scope-field__select"
                                        value="@_scope.CompetitionId"
                                        @onchange="OnCompetitionChangedAsync">
                                    <option value="">— Toutes les compétitions —</option>
                                    @foreach (var c in _refData.Competitions)
                                    {
                                        <option value="@c.CompetitionId">@c.CompetitionName</option>
                                    }
                                </select>
                            </div>
                            <div class="scope-field">
                                <label class="scope-field__label" for="exp-team">Équipe</label>
                                <select id="exp-team"
                                        class="scope-field__select"
                                        value="@_scope.TeamId"
                                        @onchange="OnTeamChangedAsync">
                                    <option value="">— Toutes les équipes —</option>
                                    @foreach (var t in _scope.GetFilteredTeams(_refData))
                                    {
                                        <option value="@t.TeamId">@t.TeamName</option>
                                    }
                                </select>
                            </div>
                            @if (_availableSeasons.Count > 0)
                            {
                                <div class="scope-field">
                                    <label class="scope-field__label" for="exp-season">Saison</label>
                                    <select id="exp-season"
                                            class="scope-field__select"
                                            value="@_scope.Season"
                                            @onchange="OnSeasonChangedAsync">
                                        <option value="">— Toutes les saisons —</option>
                                        @foreach (var s in _availableSeasons)
                                        {
                                            <option value="@s">@s</option>
                                        }
                                    </select>
                                </div>
                            }
                            else
                            {
                                <div class="scope-field">
                                    <label class="scope-field__label" for="exp-season-text">Saison</label>
                                    <input id="exp-season-text"
                                           class="scope-field__input"
                                           type="text"
                                           placeholder="ex : 2025-2026"
                                           value="@_scope.Season"
                                           @oninput="OnSeasonInputAsync" />
                                </div>
                            }
                            @if (_availableDays.Count > 0)
                            {
                                <div class="scope-field">
                                    <label class="scope-field__label" for="exp-day">Journée</label>
                                    <select id="exp-day"
                                            class="scope-field__select"
                                            value="@_scope.Day"
                                            @onchange="OnDayChanged">
                                        <option value="">— Toutes les journées —</option>
                                        @foreach (var d in _availableDays)
                                        {
                                            <option value="@d">@d</option>
                                        }
                                    </select>
                                </div>
                            }
                            <button type="button" class="export-scope-edit__reset" @onclick="ResetScopeAsync">
                                Reprendre le périmètre actuel
                            </button>
                        </div>
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(_scope.Day))
                {
                    <p class="scope-display__day-note" role="note">
                        <span class="scope-display__day-badge">@_scope.Day</span>
                        Ce filtre est appliqué au fichier généré.
                    </p>
                }

                <!-- 1. Target -->
                <section class="export-panel" aria-labelledby="target-heading">
                    <div class="panel-head">
                        <p class="section-kicker">Étape 1</p>
                        <h3 id="target-heading">Cible</h3>
                    </div>

                    <div class="target-pills" role="radiogroup" aria-label="Cible d'export">
                        @foreach (var t in TargetOptions)
                        {
                            <button type="button"
                                    role="radio"
                                    aria-checked="@(_target == t.Value ? "true" : "false")"
                                    class="target-pill @(_target == t.Value ? "is-active" : "")"
                                    @onclick="() => SetTargetAsync(t.Value)">
                                @t.Label
                            </button>
                        }
                    </div>

                    <!-- Player selector -->
                    @if (_target is ExportTargetType.Players or ExportTargetType.Goalkeepers)
                    {
                        <div class="picker-container" aria-label="Sélection de joueuses">
                            <div class="picker-search">
                                <input type="search"
                                       class="picker-search__input"
                                       placeholder="Rechercher une joueuse…"
                                       aria-label="Rechercher une joueuse"
                                       value="@_playerSearch"
                                       @oninput="OnPlayerSearchInput" />
                            </div>
                            @if (_scope.PlayersLoading)
                            {
                                <p class="picker-loading" aria-live="polite">Chargement…</p>
                            }
                            else
                            {
                                <div class="picker-actions">
                                    <button type="button" class="picker-action" @onclick="SelectAllPlayersInView">Toutes</button>
                                    <button type="button" class="picker-action" @onclick="ClearPlayerSelection">Aucune</button>
                                </div>
                                <ul class="picker-list" role="listbox" aria-multiselectable="true"
                                    aria-label="Liste des joueuses">
                                    @foreach (var p in FilteredPlayers)
                                    {
                                        var isSelected = _selectedPlayerIds.Contains(p.PlayerId);
                                        <li class="picker-item @(isSelected ? "is-selected" : "")"
                                            role="option"
                                            aria-selected="@isSelected"
                                            tabindex="0"
                                            @onclick="() => TogglePlayer(p.PlayerId)"
                                            @onkeydown="(e) => OnPickerKeyDown(e, () => TogglePlayer(p.PlayerId))">
                                            <span class="picker-item__check" aria-hidden="true">@(isSelected ? "☑" : "☐")</span>
                                            <span class="picker-item__name">@p.FullName</span>
                                            <span class="picker-item__meta">
                                                @(p.TeamName ?? "")
                                                @if (!string.IsNullOrWhiteSpace(p.PositionCode))
                                                {<span class="picker-item__pos"> · @p.PositionCode</span>}
                                            </span>
                                        </li>
                                    }
                                    @if (FilteredPlayers.Count == 0 && !_scope.PlayersLoading)
                                    {
                                        <li class="picker-empty">Aucune joueuse trouvée.</li>
                                    }
                                </ul>
                                @if (_selectedPlayerIds.Count > 0)
                                {
                                    <p class="picker-count" aria-live="polite">@_selectedPlayerIds.Count sélectionnée(s)</p>
                                }
                                @if (_outOfScopePlayersRemoved > 0)
                                {
                                    <p class="picker-notice" role="status" aria-live="polite">
                                        @_outOfScopePlayersRemoved joueuse(s) retirée(s) car hors du périmètre.
                                    </p>
                                }
                            }
                        </div>
                    }

                    <!-- Match selector -->
                    @if (_target == ExportTargetType.Matches)
                    {
                        <div class="picker-container" aria-label="Sélection de matchs">
                            <div class="picker-search">
                                <input type="search"
                                       class="picker-search__input"
                                       placeholder="Rechercher équipe ou adversaire…"
                                       aria-label="Rechercher un match"
                                       value="@_matchSearch"
                                       @oninput="OnMatchSearchInput" />
                            </div>
                            @if (_scope.MatchesLoading)
                            {
                                <p class="picker-loading" aria-live="polite">Chargement…</p>
                            }
                            else
                            {
                                <div class="picker-actions">
                                    <button type="button" class="picker-action" @onclick="SelectAllMatchesInView">Tous</button>
                                    <button type="button" class="picker-action" @onclick="ClearMatchSelection">Aucun</button>
                                </div>
                                <ul class="picker-list" role="listbox" aria-multiselectable="true"
                                    aria-label="Liste des matchs">
                                    @foreach (var m in FilteredMatches)
                                    {
                                        var isSelected = _selectedMatchIds.Contains(m.MatchId);
                                        <li class="picker-item @(isSelected ? "is-selected" : "")"
                                            role="option"
                                            aria-selected="@isSelected"
                                            tabindex="0"
                                            @onclick="() => ToggleMatch(m.MatchId)"
                                            @onkeydown="(e) => OnPickerKeyDown(e, () => ToggleMatch(m.MatchId))">
                                            <span class="picker-item__check" aria-hidden="true">@(isSelected ? "☑" : "☐")</span>
                                            <span class="picker-item__name">@FormatMatchLabel(m)</span>
                                            <span class="picker-item__meta">@(m.CompetitionName ?? "") @(m.Day ?? "")</span>
                                        </li>
                                    }
                                    @if (FilteredMatches.Count == 0 && !_scope.MatchesLoading)
                                    {
                                        <li class="picker-empty">Aucun match trouvé.</li>
                                    }
                                </ul>
                                @if (_selectedMatchIds.Count > 0)
                                {
                                    <p class="picker-count" aria-live="polite">@_selectedMatchIds.Count sélectionné(s)</p>
                                }
                                @if (_outOfScopeMatchesRemoved > 0)
                                {
                                    <p class="picker-notice" role="status" aria-live="polite">
                                        @_outOfScopeMatchesRemoved match(s) retiré(s) car hors du périmètre.
                                    </p>
                                }
                            }
                        </div>
                    }
                </section>

                <div class="wizard__nav">
                    <span></span>
                    <button class="btn btn-primary" @onclick='() => _exportStep = 2' type="button">Suivant →</button>
                </div>

            </div>
        }
        else if (_exportStep == 2)
        {
            <div class="wizard__panel">

                <!-- 2. Content -->
                <section class="export-panel" aria-labelledby="content-heading">
                    <div class="panel-head">
                        <p class="section-kicker">Étape 2</p>
                        <h3 id="content-heading">Contenu</h3>
                    </div>

                    <div class="preset-pills" role="radiogroup" aria-label="Profil d'export">
                        @foreach (var p in PresetOptions)
                        {
                            var isActive = _preset == p.Value;
                            <button type="button"
                                    role="radio"
                                    aria-checked="@(isActive ? "true" : "false")"
                                    class="preset-pill @(isActive ? "is-active" : "")"
                                    @onclick="() => SetPreset(p.Value)">
                                @p.Label
                            </button>
                        }
                    </div>

                    @if (_preset == ExportPreset.Custom)
                    {
                        <fieldset class="section-checkboxes" aria-label="Feuilles à inclure">
                            <legend class="section-checkboxes__legend">Feuilles à inclure</legend>
                            @foreach (var sec in ExportSectionCatalog.All.Where(s => !s.IsAdvanced))
                            {
                                var isEnabled = _selectedSections.Contains(sec.ApiKey);
                                <label class="section-checkbox">
                                    <input type="checkbox"
                                           checked="@isEnabled"
                                           aria-label="@sec.Label"
                                           @onchange="() => ToggleSection(sec.ApiKey)" />
                                    <span class="section-checkbox__body">
                                        <strong class="section-checkbox__label">@sec.Label</strong>
                                        <em class="section-checkbox__desc">@sec.Description</em>
                                    </span>
                                </label>
                            }
                        </fieldset>
                    }
                    else
                    {
                        <ul class="preset-section-list" aria-label="Feuilles du profil sélectionné">
                            @foreach (var key in ExportSectionCatalog.ForPreset(_preset))
                            {
                                if (ExportSectionCatalog.ByKey.TryGetValue(key, out var sec))
                                {
                                    <li class="preset-section-item">@sec.Label</li>
                                }
                            }
                        </ul>
                    }
                </section>

                <div class="wizard__nav">
                    <button class="btn btn-ghost" @onclick='() => _exportStep = 1' type="button">← Retour</button>
                    <button class="btn btn-primary" @onclick='() => _exportStep = 3' type="button">Suivant →</button>
                </div>

            </div>
        }
        else if (_exportStep == 3)
        {
            <div class="wizard__panel">

                <!-- 3. Advanced options -->
                <section class="export-panel">
                    <details class="advanced-options">
                        <summary class="advanced-options__toggle">
                            <span class="section-kicker">Étape 3</span>
                            <strong>Options avancées</strong>
                            <span class="advanced-options__chevron" aria-hidden="true">▸</span>
                        </summary>
                        <div class="advanced-options__body">
                            <label class="section-checkbox">
                                <input type="checkbox" @bind="_includeDataQuality" />
                                <span class="section-checkbox__body">
                                    <strong class="section-checkbox__label">Qualité des données</strong>
                                    <em class="section-checkbox__desc">Complétude et fiabilité des données par match.</em>
                                </span>
                            </label>
                            <label class="section-checkbox">
                                <input type="checkbox" disabled />
                                <span class="section-checkbox__body">
                                    <strong class="section-checkbox__label">Coordonnées brutes des tirs — indisponibles</strong>
                                    <em class="section-checkbox__desc">La source stocke les zones de tir, mais pas les coordonnées X/Y brutes.</em>
                                </span>
                            </label>
                            <label class="section-checkbox">
                                <input type="checkbox" @bind="_includeRawEvents" />
                                <span class="section-checkbox__body">
                                    <strong class="section-checkbox__label">Événements bruts</strong>
                                    <em class="section-checkbox__desc section-checkbox__desc--warn">
                                        Log complet de chaque événement. Peut augmenter fortement la taille et le temps de génération.
                                    </em>
                                </span>
                            </label>

                            <div class="advanced-dates">
                                <div class="scope-field">
                                    <label class="scope-field__label" for="exp-date-from">Date de début</label>
                                    <input id="exp-date-from" class="scope-field__input" type="date"
                                           @bind="_scope.DateFrom" />
                                </div>
                                <div class="scope-field">
                                    <label class="scope-field__label" for="exp-date-to">Date de fin</label>
                                    <input id="exp-date-to" class="scope-field__input" type="date"
                                           @bind="_scope.DateTo" />
                                </div>
                            </div>
                        </div>
                    </details>

                    <!-- Validation errors -->
                    @if (_validationErrors.Count > 0)
                    {
                        <ul class="export-validation-errors" role="alert" aria-live="assertive">
                            @foreach (var err in _validationErrors)
                            {
                                <li>@err</li>
                            }
                        </ul>
                    }

                    <!-- Server warnings -->
                    @if (_serverWarnings.Count > 0)
                    {
                        <div class="export-warnings export-warnings--server" role="status" aria-live="polite">
                            <p class="export-warnings__title">Avertissements serveur</p>
                            @foreach (var w in _serverWarnings)
                            {
                                <p class="export-warnings__item">⚠ @w</p>
                            }
                        </div>
                    }

                    <!-- Local warning: large export -->
                    @if (_includeRawEvents)
                    {
                        <p class="export-warning-local" role="note">
                            ⚠ Export volumineux probable : événements bruts activés.
                        </p>
                    }

                    <!-- Error -->
                    @if (_errorMessage is not null)
                    {
                        <div class="export-error" role="alert">
                            <span>@_errorMessage</span>
                            <button type="button" class="export-error__dismiss" aria-label="Fermer l'erreur" @onclick="ClearError">×</button>
                        </div>
                    }

                    <!-- Success result -->
                    @if (_status == ExportGenerationStatus.Completed && _generatedFileName is not null)
                    {
                        <div class="export-result" role="status">
                            <p class="export-result__filename">@_generatedFileName</p>
                            @if (FormattedFileSize is not null)
                            {
                                <p class="export-result__size">@FormattedFileSize</p>
                            }
                            @if (_generatedSchemaVersion is not null || _generatedAtUtc is not null || _generatedSha256 is not null)
                            {
                                <details class="export-result__details">
                                    <summary>Détails techniques</summary>
                                    @if (_generatedSchemaVersion is not null)
                                    {
                                        <p>Version du schéma : @_generatedSchemaVersion</p>
                                    }
                                    @if (_generatedAtUtc is not null)
                                    {
                                        <p>Généré le : @_generatedAtUtc</p>
                                    }
                                    @if (_generatedSha256 is not null)
                                    {
                                        <p>SHA-256 : <code>@_generatedSha256</code></p>
                                    }
                                </details>
                            }
                        </div>
                    }
                </section>

                <!-- Progress / Cancel si génération en cours -->
                @if (IsBusy)
                {
                    <div class="export-actions">
                        <button type="button"
                                class="export-btn export-btn--primary is-loading"
                                disabled
                                aria-busy="true">
                            <span class="export-spinner" aria-hidden="true"></span>
                            <span aria-live="polite">@GetStatusLabel()</span>
                        </button>
                        <button type="button"
                                class="export-btn export-btn--secondary"
                                @onclick="Cancel">
                            Annuler
                        </button>
                    </div>
                }

                <div class="wizard__nav">
                    <button class="btn btn-ghost" @onclick='() => _exportStep = 2' type="button">← Retour</button>
                    @if (!IsBusy)
                    {
                        <button class="btn btn-primary" @onclick="GenerateAndDownloadAsync" type="button">
                            Générer l'export
                        </button>
                    }
                </div>

            </div>
        }

        @if (_showExportSuccessToast)
        {
            <div class="toast toast--success" role="status" aria-live="polite">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="20 6 9 17 4 12"/>
                </svg>
                @_exportSuccessMessage
            </div>
        }
    }
</div>

@code {
    // ── Static options ─────────────────────────────────────────────────────────

    private static readonly IReadOnlyList<(ExportTargetType Value, string Label)> TargetOptions =
    [
        (ExportTargetType.FullScope,   "Tout le périmètre"),
        (ExportTargetType.Team,        "Équipe"),
        (ExportTargetType.Players,     "Joueuses"),
        (ExportTargetType.Goalkeepers, "Gardiennes"),
        (ExportTargetType.Matches,     "Matchs"),
    ];

    private static readonly IReadOnlyList<(ExportPreset Value, string Label)> PresetOptions =
    [
        (ExportPreset.FullAnalysis, "Analyse complète"),
        (ExportPreset.Staff,        "Staff"),
        (ExportPreset.Players,      "Joueuses"),
        (ExportPreset.Matches,      "Matchs"),
        (ExportPreset.Spatial,      "Spatial"),
        (ExportPreset.Custom,       "Personnalisé"),
    ];

    // ── State ──────────────────────────────────────────────────────────────────

    private ExportScopeState _scope = new();
    private AnalyticsReferenceData _refData = AnalyticsReferenceData.Empty;
    private int _exportStep = 1; // 1 = Cible, 2 = Contenu, 3 = Options

    private ExportTargetType _target = ExportTargetType.FullScope;
    private ExportPreset _preset = ExportPreset.FullAnalysis;

    private HashSet<string> _selectedSections = new(
        ExportSectionCatalog.ForPreset(ExportPreset.FullAnalysis),
        StringComparer.OrdinalIgnoreCase);

    private List<int> _selectedPlayerIds = [];
    private List<int> _selectedMatchIds = [];

    private bool _includeRawEvents;
    private bool _includeShotCoordinates;
    private bool _includeDataQuality = true;

    private string _playerSearch = "";
    private string _matchSearch = "";

    private ExportGenerationStatus _status = ExportGenerationStatus.Ready;
    private List<string> _validationErrors = [];
    private List<string> _serverWarnings = [];
    private string? _errorMessage;

    private string? _generatedFileName;
    private long? _generatedFileSizeRaw;
    private string? _generatedSha256;
    private string? _generatedSchemaVersion;
    private string? _generatedAtUtc;

    private CancellationTokenSource? _cts;
    private bool _showExportSuccessToast = false;
    private string _exportSuccessMessage = "";

    // Stale-response protection: each generation attempt gets a unique token.
    private int _generationToken;

    // Scope change tracking
    private int _outOfScopePlayersRemoved;
    private int _outOfScopeMatchesRemoved;

    // Derived filter lists from available matches
    private IReadOnlyList<string> _availableSeasons = [];
    private IReadOnlyList<string> _availableDays = [];

    // ── Computed ───────────────────────────────────────────────────────────────

    private bool HasValidationErrors => _validationErrors.Count > 0;
    private bool IsBusy => _status is ExportGenerationStatus.Validating
        or ExportGenerationStatus.Generating
        or ExportGenerationStatus.Downloading
        or ExportGenerationStatus.Saving;

    private string? FormattedFileSize => _generatedFileSizeRaw.HasValue
        ? $"{((_generatedFileSizeRaw.Value + 512) / 1024):N0} Ko"
        : null;

    private IReadOnlyList<PlayerListItemDto> FilteredPlayers
    {
        get
        {
            IEnumerable<PlayerListItemDto> players = _scope.AvailablePlayers;
            if (_target == ExportTargetType.Goalkeepers)
            {
                players = players.Where(p => p.IsGoalkeeper);
            }
            if (!string.IsNullOrWhiteSpace(_playerSearch))
            {
                var term = _playerSearch.Trim();
                players = players.Where(p =>
                    (p.FullName?.Contains(term, StringComparison.OrdinalIgnoreCase) == true)
                    || (p.TeamName?.Contains(term, StringComparison.OrdinalIgnoreCase) == true)
                    || (p.PositionName?.Contains(term, StringComparison.OrdinalIgnoreCase) == true)
                    || (p.PositionCode?.Contains(term, StringComparison.OrdinalIgnoreCase) == true));
            }
            return players.ToList();
        }
    }

    private IReadOnlyList<MatchListItemDto> FilteredMatches
    {
        get
        {
            IEnumerable<MatchListItemDto> matches = _scope.AvailableMatches;

            // Keep the picker consistent with the day that is also sent to the API.
            if (!string.IsNullOrWhiteSpace(_scope.Day))
            {
                matches = MatchFilterCatalog.ApplySeasonAndDay(matches.ToList(), null, _scope.Day);
            }

            if (!string.IsNullOrWhiteSpace(_matchSearch))
            {
                var term = _matchSearch.Trim();
                matches = matches.Where(m =>
                    (m.Team1Name?.Contains(term, StringComparison.OrdinalIgnoreCase) == true)
                    || (m.Team2Name?.Contains(term, StringComparison.OrdinalIgnoreCase) == true)
                    || (m.CompetitionName?.Contains(term, StringComparison.OrdinalIgnoreCase) == true));
            }
            return matches.ToList();
        }
    }

    private ExportPreviewModel GetPreview()
    {
        var baseSections = _preset == ExportPreset.Custom
            ? (IReadOnlySet<string>)_selectedSections
            : ExportSectionCatalog.ForPreset(_preset);

        var effectiveSections = new HashSet<string>(baseSections, StringComparer.OrdinalIgnoreCase);
        if (_includeDataQuality) effectiveSections.Add("DATA_QUALITY");
        if (_includeRawEvents) effectiveSections.Add("EVENTS");
        if (_includeShotCoordinates) effectiveSections.Add("SHOTS");

        var sectionLabels = effectiveSections
            .Where(k => ExportSectionCatalog.ByKey.ContainsKey(k))
            .Select(k => ExportSectionCatalog.ByKey[k].Label)
            .ToList();

        var targetLabel = _target switch
        {
            ExportTargetType.FullScope => "Tout le périmètre",
            ExportTargetType.Team => string.IsNullOrWhiteSpace(_scope.TeamName) ? "Équipe" : _scope.TeamName,
            ExportTargetType.Players => "Joueuses sélectionnées",
            ExportTargetType.Goalkeepers => "Gardiennes",
            ExportTargetType.Matches => "Matchs sélectionnés",
            _ => "—",
        };

        return new ExportPreviewModel
        {
            ScopeDisplayLine = _scope.ToDisplayLine(),
            TargetLabel = targetLabel,
            PlayerCount = (_target is ExportTargetType.Players or ExportTargetType.Goalkeepers)
                ? _selectedPlayerIds.Count : 0,
            MatchCount = _target == ExportTargetType.Matches ? _selectedMatchIds.Count : 0,
            SectionCount = effectiveSections.Count,
            EnabledSectionLabels = sectionLabels,
            IncludeRawEvents = _includeRawEvents,
            IncludeShotCoordinates = _includeShotCoordinates,
            IncludeDataQuality = _includeDataQuality,
            FormatLabel = "Excel (.xlsx)",
            DayFilterIsDisplayOnly = false,
            DayDisplayValue = _scope.Day,
        };
    }

    private IReadOnlyList<string> GetEffectiveSections()
    {
        var baseSections = _preset == ExportPreset.Custom
            ? (IReadOnlySet<string>)_selectedSections
            : ExportSectionCatalog.ForPreset(_preset);

        var set = new HashSet<string>(baseSections, StringComparer.OrdinalIgnoreCase);
        if (_includeDataQuality) set.Add("DATA_QUALITY");
        if (_includeRawEvents) set.Add("EVENTS");
        if (_includeShotCoordinates) set.Add("SHOTS");
        return set.ToList();
    }

    // ── Lifecycle ──────────────────────────────────────────────────────────────

    protected override async Task OnInitializedAsync()
    {
        if (!AuthService.Session.IsAuthenticated) return;

        ScopeService.Changed += OnGlobalScopeChanged;

        _refData = await RefData.GetReferenceDataAsync();
        _scope = ExportScopeState.FromSnapshot(ScopeService.Current);

        // Derive seasons/days from initial match pool if scope has context
        if (_scope.CompetitionId.HasValue || !string.IsNullOrWhiteSpace(_scope.Season))
        {
            await LoadMatchesAsync();
            _availableSeasons = MatchFilterCatalog.GetSeasons(_scope.AvailableMatches);
            _availableDays = MatchFilterCatalog.GetDays(_scope.AvailableMatches, _scope.Season);
        }

        _validationErrors = RunValidation();
    }

    public void Dispose()
    {
        ScopeService.Changed -= OnGlobalScopeChanged;
        _cts?.Cancel();
        _cts?.Dispose();
    }

    private void OnGlobalScopeChanged()
    {
        InvokeAsync(async () =>
        {
            await ApplyGlobalScopeAsync();
            StateHasChanged();
        });
    }

    // ── Scope handlers ─────────────────────────────────────────────────────────

    private async Task ApplyGlobalScopeAsync()
    {
        _scope = ExportScopeState.FromSnapshot(ScopeService.Current);
        await RefreshScopeDataAsync();
    }

    private async Task ResetScopeAsync()
    {
        _scope = ExportScopeState.FromSnapshot(ScopeService.Current);
        _outOfScopePlayersRemoved = 0;
        _outOfScopeMatchesRemoved = 0;
        await RefreshScopeDataAsync();
        _validationErrors = RunValidation();
    }

    private async Task ResetExportAsync()
    {
        _scope = ExportScopeState.FromSnapshot(ScopeService.Current);
        _target = ExportTargetType.FullScope;
        _preset = ExportPreset.FullAnalysis;
        _selectedSections = new HashSet<string>(
            ExportSectionCatalog.ForPreset(ExportPreset.FullAnalysis),
            StringComparer.OrdinalIgnoreCase);
        _selectedPlayerIds = [];
        _selectedMatchIds = [];
        _includeRawEvents = false;
        _includeShotCoordinates = false;
        _includeDataQuality = true;
        _exportStep = 1;
        _playerSearch = "";
        _matchSearch = "";
        _outOfScopePlayersRemoved = 0;
        _outOfScopeMatchesRemoved = 0;
        _errorMessage = null;
        _serverWarnings = [];
        _generatedFileName = null;
        _generatedFileSizeRaw = null;
        _generatedSha256 = null;
        _generatedSchemaVersion = null;
        _generatedAtUtc = null;
        _status = ExportGenerationStatus.Ready;
        await RefreshScopeDataAsync();
        _validationErrors = RunValidation();
    }

    private async Task RefreshScopeDataAsync()
    {
        await LoadMatchesAsync();
        _availableSeasons = MatchFilterCatalog.GetSeasons(_scope.AvailableMatches);
        _availableDays = MatchFilterCatalog.GetDays(_scope.AvailableMatches, _scope.Season);

        // Prune stale player selections
        if (_target is ExportTargetType.Players or ExportTargetType.Goalkeepers
            && _scope.AvailablePlayers.Count > 0)
        {
            var availableIds = _scope.AvailablePlayers.Select(p => p.PlayerId).ToHashSet();
            var before = _selectedPlayerIds.Count;
            _selectedPlayerIds = _selectedPlayerIds.Where(id => availableIds.Contains(id)).ToList();
            _outOfScopePlayersRemoved = before - _selectedPlayerIds.Count;
        }

        // Prune stale match selections
        if (_target == ExportTargetType.Matches && _scope.AvailableMatches.Count > 0)
        {
            var availableIds = _scope.AvailableMatches.Select(m => m.MatchId).ToHashSet();
            var before = _selectedMatchIds.Count;
            _selectedMatchIds = _selectedMatchIds.Where(id => availableIds.Contains(id)).ToList();
            _outOfScopeMatchesRemoved = before - _selectedMatchIds.Count;
        }
    }

    private async Task OnCompetitionChangedAsync(ChangeEventArgs e)
    {
        _scope.CompetitionId = int.TryParse(e.Value?.ToString(), out var id) ? id : null;
        _scope.CompetitionName = _refData.Competitions
            .FirstOrDefault(c => c.CompetitionId == _scope.CompetitionId)?.CompetitionName;
        _scope.TeamId = null;
        _scope.TeamName = null;
        await RefreshScopeDataAsync();
        _validationErrors = RunValidation();
    }

    private async Task OnTeamChangedAsync(ChangeEventArgs e)
    {
        _scope.TeamId = int.TryParse(e.Value?.ToString(), out var id) ? id : null;
        _scope.TeamName = _refData.Teams
            .FirstOrDefault(t => t.TeamId == _scope.TeamId)?.TeamName;
        await RefreshScopeDataAsync();
        _validationErrors = RunValidation();
    }

    private async Task OnSeasonChangedAsync(ChangeEventArgs e)
    {
        _scope.Season = MatchFilterCatalog.NormalizeSelection(e.Value?.ToString());
        _availableDays = MatchFilterCatalog.GetDays(_scope.AvailableMatches, _scope.Season);
        await Task.CompletedTask;
        _validationErrors = RunValidation();
    }

    private async Task OnSeasonInputAsync(ChangeEventArgs e)
    {
        _scope.Season = MatchFilterCatalog.NormalizeSelection(e.Value?.ToString());
        _availableDays = MatchFilterCatalog.GetDays(_scope.AvailableMatches, _scope.Season);
        await Task.CompletedTask;
        _validationErrors = RunValidation();
    }

    private void OnDayChanged(ChangeEventArgs e)
    {
        _scope.Day = MatchFilterCatalog.NormalizeSelection(e.Value?.ToString());
        _validationErrors = RunValidation();
    }

    // ── Target handlers ────────────────────────────────────────────────────────

    private async Task SetTargetAsync(ExportTargetType target)
    {
        _target = target;
        _outOfScopePlayersRemoved = 0;
        _outOfScopeMatchesRemoved = 0;
        _playerSearch = "";
        _matchSearch = "";
        _errorMessage = null;

        // Lazy load players only when target requires them
        if (target is ExportTargetType.Players or ExportTargetType.Goalkeepers)
        {
            if (_scope.AvailablePlayers.Count == 0)
            {
                await LoadPlayersAsync();
            }
        }
        // Lazy load matches only when target requires them
        else if (target == ExportTargetType.Matches)
        {
            if (_scope.AvailableMatches.Count == 0)
            {
                await LoadMatchesAsync();
            }
        }

        _validationErrors = RunValidation();
    }

    // ── Preset & section handlers ──────────────────────────────────────────────

    private void SetPreset(ExportPreset preset)
    {
        _preset = preset;
        if (preset != ExportPreset.Custom)
        {
            _selectedSections = new HashSet<string>(
                ExportSectionCatalog.ForPreset(preset),
                StringComparer.OrdinalIgnoreCase);
        }
        _validationErrors = RunValidation();
    }

    private void ToggleSection(string key)
    {
        if (!_selectedSections.Remove(key))
            _selectedSections.Add(key);

        // Drift from preset → Custom
        if (_preset != ExportPreset.Custom)
        {
            var presetKeys = ExportSectionCatalog.ForPreset(_preset);
            if (!_selectedSections.SetEquals(presetKeys))
                _preset = ExportPreset.Custom;
        }

        _validationErrors = RunValidation();
    }

    // ── Player picker ──────────────────────────────────────────────────────────

    private void TogglePlayer(int playerId)
    {
        if (!_selectedPlayerIds.Remove(playerId))
            _selectedPlayerIds.Add(playerId);
        _validationErrors = RunValidation();
    }

    private void SelectAllPlayersInView()
    {
        foreach (var p in FilteredPlayers)
            if (!_selectedPlayerIds.Contains(p.PlayerId))
                _selectedPlayerIds.Add(p.PlayerId);
        _validationErrors = RunValidation();
    }

    private void ClearPlayerSelection()
    {
        _selectedPlayerIds.Clear();
        _validationErrors = RunValidation();
    }

    private void OnPlayerSearchInput(ChangeEventArgs e)
    {
        _playerSearch = e.Value?.ToString() ?? "";
    }

    // ── Match picker ───────────────────────────────────────────────────────────

    private void ToggleMatch(int matchId)
    {
        if (!_selectedMatchIds.Remove(matchId))
            _selectedMatchIds.Add(matchId);
        _validationErrors = RunValidation();
    }

    private void SelectAllMatchesInView()
    {
        foreach (var m in FilteredMatches)
            if (!_selectedMatchIds.Contains(m.MatchId))
                _selectedMatchIds.Add(m.MatchId);
        _validationErrors = RunValidation();
    }

    private void ClearMatchSelection()
    {
        _selectedMatchIds.Clear();
        _validationErrors = RunValidation();
    }

    private void OnMatchSearchInput(ChangeEventArgs e)
    {
        _matchSearch = e.Value?.ToString() ?? "";
    }

    // ── Keyboard navigation for pickers ───────────────────────────────────────

    private static void OnPickerKeyDown(KeyboardEventArgs e, Action action)
    {
        if (e.Key is " " or "Enter") action();
    }

    // ── Lazy loading ───────────────────────────────────────────────────────────

    private async Task LoadPlayersAsync()
    {
        _scope.PlayersLoading = true;
        StateHasChanged();
        try
        {
            var players = await PlayersClient.GetPlayersAsync(
                competitionId: _scope.CompetitionId,
                teamId: _scope.TeamId,
                season: _scope.Season,
                pageSize: 300,
                cancellationToken: CancellationToken.None);
            _scope.AvailablePlayers = players.OrderBy(p => p.FullName).ToList();
        }
        catch { _scope.AvailablePlayers = []; }
        finally { _scope.PlayersLoading = false; }
    }

    private async Task LoadMatchesAsync()
    {
        _scope.MatchesLoading = true;
        StateHasChanged();
        try
        {
            var matches = await MatchesClient.GetMatchesAsync(
                competitionId: _scope.CompetitionId,
                teamId: _scope.TeamId,
                season: _scope.Season,
                pageSize: 300,
                cancellationToken: CancellationToken.None);
            _scope.AvailableMatches = matches.OrderByDescending(m => m.Date).ToList();
        }
        catch { _scope.AvailableMatches = []; }
        finally { _scope.MatchesLoading = false; }
    }

    // ── Validation ─────────────────────────────────────────────────────────────

    private List<string> RunValidation()
    {
        var result = ExportRequestValidator.Validate(
            _target,
            _scope.TeamId,
            _selectedPlayerIds,
            _selectedMatchIds,
            _scope.DateFrom,
            _scope.DateTo,
            GetEffectiveSections());
        return result.Errors.ToList();
    }

    // ── Generate & download ────────────────────────────────────────────────────

    private async Task GenerateAndDownloadAsync()
    {
        _validationErrors = RunValidation();
        if (_validationErrors.Count > 0) return;

        var request = ExportRequestBuilder.Build(
            _scope, _target,
            _scope.TeamId,
            _selectedPlayerIds,
            _selectedMatchIds,
            new HashSet<string>(GetEffectiveSections(), StringComparer.OrdinalIgnoreCase),
            _includeRawEvents, _includeShotCoordinates, _includeDataQuality);

        await DownloadAndSaveAsync(request);
    }

    private async Task ExportSeasonAsync()
    {
        if (string.IsNullOrWhiteSpace(_scope.Season))
        {
            _errorMessage = "Sélectionnez une saison avant de lancer le bilan final.";
            return;
        }

        _validationErrors = [];
        await DownloadAndSaveAsync(ExportRequestBuilder.BuildSeasonResults(_scope));
    }

    private async Task DownloadAndSaveAsync(AnalyticsExportRequestDto request)
    {
        _errorMessage = null;
        _serverWarnings = [];
        _generatedFileName = null;
        _generatedFileSizeRaw = null;
        _generatedSha256 = null;

        var token = ++_generationToken;
        _cts = new CancellationTokenSource(TimeSpan.FromMinutes(3));
        _status = ExportGenerationStatus.Validating;

        try
        {
            _status = ExportGenerationStatus.Generating;
            StateHasChanged();

            _status = ExportGenerationStatus.Downloading;
            StateHasChanged();

            var (content, fileName, contentType) =
                await ExportClient.DownloadExportAsync(request, _cts.Token);

            // Stale-response guard
            if (token != _generationToken) return;

            if (content is null || content.Length == 0)
            {
                _errorMessage = "Le serveur n'a retourné aucun contenu.";
                _status = ExportGenerationStatus.Error;
                return;
            }

            _status = ExportGenerationStatus.Saving;
            StateHasChanged();

            fileName ??= $"HandWStat_Export_{DateTime.Now:yyyyMMdd}.xlsx";
            contentType ??= "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet";

            _generatedFileName = fileName;
            _generatedFileSizeRaw = content.Length;
            _generatedSha256 = Convert.ToHexString(
                System.Security.Cryptography.SHA256.HashData(content)).ToLowerInvariant();

            await SaveFileAsync(content, fileName, contentType);

            if (token != _generationToken) return;

            _status = ExportGenerationStatus.Completed;
            await ShowExportToast("Export généré avec succès.");
        }
        catch (OperationCanceledException)
        {
            if (token == _generationToken)
            {
                _status = ExportGenerationStatus.Ready;
                _errorMessage = "Export annulé.";
            }
        }
        catch (HandWStat.Services.Api.ApiRequestException ex)
        {
            if (token == _generationToken)
            {
                _errorMessage = ex.UserMessage;
                _status = ExportGenerationStatus.Error;
            }
        }
        catch (Exception ex)
        {
            if (token == _generationToken)
            {
                _errorMessage = $"Erreur inattendue : {ex.Message}";
                _status = ExportGenerationStatus.Error;
            }
        }
        finally
        {
            if (token == _generationToken && _status == ExportGenerationStatus.Error)
            {
                _status = ExportGenerationStatus.Ready;
            }
            _cts?.Dispose();
            _cts = null;
        }
    }

    private void Cancel()
    {
        _cts?.Cancel();
        _cts = null;
        _status = ExportGenerationStatus.Ready;
        _errorMessage = "Export annulé.";
    }

    private void ClearError()
    {
        _errorMessage = null;
        if (_status == ExportGenerationStatus.Error)
            _status = ExportGenerationStatus.Ready;
    }

    private async Task ShowExportToast(string message)
    {
        _exportSuccessMessage = message;
        _showExportSuccessToast = true;
        StateHasChanged();
        await Task.Delay(4000);
        _showExportSuccessToast = false;
        StateHasChanged();
    }

    private async Task SaveFileAsync(byte[] content, string fileName, string contentType)
    {
        var path = Path.Combine(FileSystem.AppDataDirectory, fileName);
        await File.WriteAllBytesAsync(path, content);
        await Share.RequestAsync(new ShareFileRequest
        {
            Title = "Partager le classeur analytique",
            File = new ShareFile(path, contentType),
        });
    }

    // ── Formatting helpers ─────────────────────────────────────────────────────

    private static string FormatMatchLabel(MatchListItemDto m)
    {
        var date = m.Date.HasValue
            ? m.Date.Value.ToString("d MMM", System.Globalization.CultureInfo.GetCultureInfo("fr-FR"))
            : "—";
        var t1 = m.Team1Name ?? "Éq.1";
        var t2 = m.Team2Name ?? "Éq.2";
        var score = (m.Team1Score.HasValue && m.Team2Score.HasValue)
            ? $" {m.Team1Score}–{m.Team2Score}"
            : "";
        return $"{date} · {t1}{score} vs {t2}";
    }

    private string GetStatusLabel() => _status switch
    {
        ExportGenerationStatus.Validating  => "Préparation…",
        ExportGenerationStatus.Generating  => "Génération…",
        ExportGenerationStatus.Downloading => "Téléchargement…",
        ExportGenerationStatus.Saving      => "Enregistrement…",
        _ => "En cours…",
    };

    private string WizardStepCss(int step)
    {
        if (_exportStep == step) return "wizard__step wizard__step--active";
        if (_exportStep > step)  return "wizard__step wizard__step--done";
        return "wizard__step";
    }
}
