                                                <th scope="col" aria-sort="@PtSortAria("pt-assists")">
                                                    <button type="button" class="sort-btn" @onclick='() => SetPlayerTableSort("pt-assists")'>
                                                        Passes @PtSortGlyph("pt-assists")
