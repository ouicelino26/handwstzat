@if (_filterOpen && Snapshot is not null)
{
    <div class="filter-drawer-overlay" @onclick="CloseFilterDrawer" role="dialog" aria-modal="true" aria-label="Filtres dashboard">
        <div class="filter-drawer" @onclick:stopPropagation="true">
            <header class="filter-drawer__head">
                <h3 class="filter-drawer__title">Filtres</h3>
                <button type="button" class="filter-drawer__close" @onclick="CloseFilterDrawer">×</button>
            </header>
            <div class="filter-drawer__body page-filters">
                <div class="filter-section">
                    <span class="filter-section__label">Compétition</span>
                    <select class="form-select" @bind="Filters.CompetitionId" @bind:after="OnScopeSelectionChangedAsync">
