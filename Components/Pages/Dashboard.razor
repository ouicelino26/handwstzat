@page "/dashboard"
@inherits HomeBase

<PageTitle>Today</PageTitle>

@if (IsBusy && Snapshot is null)
{
    <StateCard Kicker="Chargement"
               Title="Mise à jour du tableau de bord"
               Message="Préparation des classements, de la joueuse suivie et des cartes de tir."
               Tone="loading" />
}
else if (!string.IsNullOrWhiteSpace(ErrorMessage))
{
    <StateCard Kicker="Erreur"
               Title="Impossible de charger le tableau de bord"
               Message="@ErrorMessage"
               Tone="error"
               Actions="@RetryActions" />
}
else if (Snapshot is not null)
{
    <div class="dashboard-workspace" data-workspace="dashboard" aria-busy="@IsBusy">
        @if (IsBusy)
        {
            <PageLoader Kicker="Chargement"
                        Title="Actualisation du tableau de bord"
                        Message="Les filtres, classements et KPI se recalculent." />
        }

        @if (!string.IsNullOrWhiteSpace(Snapshot.WarningMessage))
        {
            <section class="warning-banner">
                <strong>Information</strong>
                <span>@Snapshot.WarningMessage</span>
            </section>
        }

        @if (!IsSpotlightLoading && Snapshot.Players.Count == 0)
        {
            <StateCard Kicker="Aucune joueuse"
                       Title="Aucune joueuse dans cette sélection"
                       Message="Essayez une autre compétition, une autre équipe ou réinitialisez les filtres."
                       Tone="empty" />
        }
        else
        {
            <div class="studio-subtoolbar">
                <nav class="tab-bar" role="tablist" aria-label="Sections du tableau de bord">
                    <button type="button" role="tab" aria-selected="@(ActiveDashboardSection == "league")" class="tab @(ActiveDashboardSection == "league" ? "active" : string.Empty)" data-testid="tab-league" @onclick='() => SetDashboardSection("league")' disabled="@IsBusy">Ligue</button>
                    <button type="button" role="tab" aria-selected="@(ActiveDashboardSection == "team-of-day")" class="tab @(ActiveDashboardSection == "team-of-day" ? "active" : string.Empty)" data-testid="tab-team-of-day" @onclick='() => SetDashboardSection("team-of-day")' disabled="@IsBusy">Equipe du jour</button>
                    <button type="button" role="tab" aria-selected="@(ActiveDashboardSection == "spotlight")" class="tab @(ActiveDashboardSection == "spotlight" ? "active" : string.Empty)" data-testid="tab-spotlight" @onclick='() => SetDashboardSection("spotlight")' disabled="@IsBusy">Joueuse</button>
                    <button type="button" role="tab" aria-selected="@(ActiveDashboardSection == "global-rankings")" class="tab @(ActiveDashboardSection == "global-rankings" ? "active" : string.Empty)" data-testid="tab-global-rankings" @onclick='() => SetDashboardSection("global-rankings")' disabled="@IsBusy">Classements</button>
                    <button type="button" role="tab" aria-selected="@(ActiveDashboardSection == "recent")" class="tab @(ActiveDashboardSection == "recent" ? "active" : string.Empty)" data-testid="tab-recent" @onclick='() => SetDashboardSection("recent")' disabled="@IsBusy">Matchs récents</button>
                </nav>
                <div class="studio-subtoolbar__spacer"></div>
                <button type="button" class="btn btn-ghost btn-sm" @onclick="() => _filterOpen = true" aria-label="Ouvrir les filtres">
                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 6h18M7 12h10M11 18h2"/></svg>
                    Filtrer
                </button>
            </div>

            @if (ActiveDashboardSection == "league")
            {
                <div class="tab-panel active">
                  <div class="dashboard-overview">

                    <section class="dashboard-scope-bar">
                      <div class="dashboard-scope-bar__main">
                        <span class="dashboard-scope-dot"></span>
                        <div class="dashboard-scope-bar__text">
                          <div class="dashboard-scope-bar__label">Scope actif</div>
                          <div class="dashboard-scope-bar__value">@DashboardScopeLabel</div>
                        </div>
                      </div>
                      <div class="dashboard-scope-bar__meta">
                        <span class="dashboard-scope-count">@Snapshot.Overview.MatchCount matchs</span>
                      </div>
                    </section>

                    <div class="signal-matrix signal-matrix--six">
                        <div class="signal-matrix__item">
                            <span class="signal-matrix__count">@(IsSpotlightLoading ? "..." : Snapshot.Players.Count.ToString("N0"))</span>
                            <span class="signal-matrix__label">Joueuses</span>
                        </div>
                        <div class="signal-matrix__item">
                            <span class="signal-matrix__count">@Snapshot.Overview.MatchCount.ToString("N0")</span>
                            <span class="signal-matrix__label">Matchs</span>
                        </div>
                        <div class="signal-matrix__item signal-matrix__item--highlight">
                            <span class="signal-matrix__count">@Snapshot.Overview.GoalCount.ToString("N0")</span>
                            <span class="signal-matrix__label">Buts</span>
                        </div>
                        <div class="signal-matrix__item">
                            <span class="signal-matrix__count">@Snapshot.Overview.AssistCount.ToString("N0")</span>
                            <span class="signal-matrix__label">Passes déc.</span>
                        </div>
                        <div class="signal-matrix__item">
                            <span class="signal-matrix__count">@Snapshot.Overview.InterceptionCount.ToString("N0")</span>
                            <span class="signal-matrix__label">Interceptions</span>
                        </div>
                        <div class="signal-matrix__item">
                            <span class="signal-matrix__count">@Snapshot.Overview.SaveCount.ToString("N0")</span>
                            <span class="signal-matrix__label">Arrêts</span>
                        </div>
                    </div>

                    @if (LeagueKpis?.Any() == true)
                    {
                        <div class="kpi-tile-grid">
                            @foreach (var kpi in LeagueKpis)
                            {
                                <div class="kpi-tile kpi-tile--@kpi.Tone">
                                    <span class="kpi-tile__label">@kpi.Label</span>
                                    <span class="kpi-tile__value">@kpi.Value</span>
                                    @if (!string.IsNullOrEmpty(kpi.Context))
                                    {
                                        <span class="kpi-tile__context">@kpi.Context</span>
                                    }
                                </div>
                            }
                        </div>
                    }

                    <section class="dashboard-main-grid">
                      <article class="dashboard-ranking-panel">
                        <div class="dashboard-ranking-head">
                          <div class="dashboard-ranking-head__top">
                            <div>
                              <p class="dashboard-section-kicker">Ranking joueuses</p>
                              <h3>@Snapshot.RequestedRankingLabel · Top @Filters.Top</h3>
                            </div>
                            <select class="form-select form-select--sm"
                                    value="@Filters.Top"
                                    @onchange="e => SelectRankingTopAsync(int.TryParse(e.Value?.ToString(), out var t) ? t : Filters.Top)"
                                    aria-label="Nombre de résultats"
                                    style="width:auto;min-width:6.5rem;flex-shrink:0">
                              @foreach (var top in RankingTopOptions)
                              {
                                <option value="@top">Top @top</option>
                              }
                            </select>
                          </div>
                          <div class="dashboard-chip-row">
                            @foreach (var metric in RankingMetrics)
                            {
                              <button type="button"
                                      class="section-chip @(IsRankingMetricActive(metric.Value) ? "is-active" : "")"
                                      disabled="@IsBusy"
                                      @onclick="() => SelectRankingMetricAsync(metric.Value)">
                                @metric.Label
                              </button>
                            }
                          </div>
                        </div>
                        @if (Snapshot.RequestedRanking.Count > 0)
                        {
                          <div class="chart-container chart-container--ranking">
                            <ApexChart @key="RankingChartKey" TItem="PlayerRankingItem" Height="300" Options="@GetRankingChartOptions()">
                              <ApexPointSeries TItem="PlayerRankingItem"
                                               Items="@Snapshot.RequestedRanking"
                                               Name="@Snapshot.RequestedRankingLabel"
                                               SeriesType="SeriesType.Bar"
                                               XValue="item => item.PlayerName"
                                               YValue="item => (decimal?)item.Value" />
                            </ApexChart>
                          </div>
                        }
                        else
                        {
                          <StateCard Kicker="Volume insuffisant"
                                     Title="Aucune joueuse ne valide le seuil de fiabilité"
                                     Message="@GetRankingEmptyMessage()"
                                     Tone="empty"
                                     CssClass="empty-card-inline" />
                        }
                      </article>

                      <aside class="dashboard-signal-panel">
                        <div class="dashboard-section-head">
                          <div>
                            <p class="dashboard-section-kicker">Signals</p>
                            <h3>Ce qui mérite attention</h3>
                          </div>
                        </div>
                        <div class="dashboard-signal-list">
                          @if (Snapshot.TopScorers.FirstOrDefault() is { } sig1)
                          {
                            <article class="dashboard-signal-item dashboard-signal-item--up">
                              <span class="dashboard-signal-icon">↑</span>
                              <div>
                                <small>Top buteuse</small>
                                <strong>@sig1.PlayerName</strong>
                                <p>@sig1.ValueLabel@(!string.IsNullOrWhiteSpace(sig1.SampleLabel) ? $" · {sig1.SampleLabel}" : "")</p>
                              </div>
                            </article>
                          }
                          @if (Snapshot.EfficiencyRanking.FirstOrDefault() is { } sig2)
                          {
                            <article class="dashboard-signal-item dashboard-signal-item--info">
                              <span class="dashboard-signal-icon">→</span>
                              <div>
                                <small>Meilleure efficacité</small>
                                <strong>@sig2.PlayerName</strong>
                                <p>@sig2.ValueLabel taux de réussite</p>
                              </div>
                            </article>
                          }
                          @if (Snapshot.InterceptionRanking.FirstOrDefault() is { } sig3)
                          {
                            <article class="dashboard-signal-item dashboard-signal-item--info">
                              <span class="dashboard-signal-icon">→</span>
                              <div>
                                <small>Impact défensif</small>
                                <strong>@sig3.PlayerName</strong>
                                <p>@sig3.ValueLabel interceptions</p>
                              </div>
                            </article>
                          }
                          @{
                            var pertesTxt = HandballKpiHelper.FormatNumber(HandballKpiHelper.PerMatch(Snapshot.Overview.TurnoverCount, Snapshot.Overview.MatchCount));
                          }
                          <article class="dashboard-signal-item dashboard-signal-item--warn">
                            <span class="dashboard-signal-icon">!</span>
                            <div>
                              <small>Pertes de balle</small>
                              <strong>@pertesTxt pertes / match</strong>
                              <p>@Snapshot.Overview.TurnoverCount pertes sur @Snapshot.Overview.MatchCount matchs.</p>
                            </div>
                          </article>
                        </div>
                      </aside>
                    </section>


                  </div>
                </div>
            }
            @if (ActiveDashboardSection == "team-of-day")
            {
                var teamOfTheDay = Snapshot.TeamOfTheDay;
                var lineup = TeamOfTheDayLineup.ToArray();
                <div class="tab-panel active">
                    <section class="dashboard-panel">
                      <div class="dashboard-panel-head">
                        <div>
                          <p class="dashboard-section-kicker">Equipe type de la journée</p>
                          <h3>@teamOfTheDay.ScopeLabel</h3>
                        </div>
                        @if (lineup.Length > 0)
                        {
                          <span class="dashboard-pill">Score @FormatTeamOfTheDayScore(lineup.Average(p => p.ScoreFor(TeamOfTheDayMetric)))</span>
                        }
                      </div>
                      @if (IsTeamOfTheDayLoading)
                      {
                        <PageLoader Kicker="Chargement à la demande"
                                    Title="Construction de l'équipe de la journée"
                                    Message="Cette section est chargée à la demande." />
                      }
                      @if (lineup.Length == 0 && !IsTeamOfTheDayLoading)
                      {
                        <StateCard Kicker="Equipe type"
                                   Title="Aucune équipe type calculable"
                                   Message="Sélectionnez une saison et une journée contenant des statistiques joueuses valides."
                                   Tone="empty"
                                   CssClass="empty-card-inline" />
                      }
                      else if (lineup.Length > 0)
                      {
                        <div class="team-day-stage">
                          <div class="team-day-field" aria-label="Formation équipe type">
                            @foreach (var player in lineup)
                            {
                              var playerPhotoUrl = PlayerPhotoAssetResolver.Resolve(player.PlayerPhoto, player.PlayerId, player.FullName, player.TeamName);
                              <article @key="player.PlayerId" class="team-day-player-card @player.FormationArea">
                                <div class="team-day-player-card__halo @(playerPhotoUrl is null ? "is-placeholder" : "has-photo")">
                                  @if (!string.IsNullOrWhiteSpace(playerPhotoUrl))
                                  {
                                    <img src="@playerPhotoUrl" alt="@($"Portrait de {player.FullName}")" loading="lazy" />
                                  }
                                  else
                                  {
                                    <span>@player.Initials</span>
                                  }
                                </div>
                                <div>
                                  <span class="team-day-position">@player.PositionLabel</span>
                                  <h4>@player.FullName</h4>
                                  <p>@player.TeamName</p>
                                </div>
                                <div class="team-day-score">
                                  <span>Score</span>
                                  <strong>@FormatTeamOfTheDayScore(player.ScoreFor(TeamOfTheDayMetric))</strong>
                                </div>
                              </article>
                            }
                          </div>
                          <aside class="dashboard-side-score">
                            <span class="dashboard-section-kicker">Sélection</span>
                            <strong>@FormatTeamOfTheDayScore(lineup.Average(p => p.ScoreFor(TeamOfTheDayMetric)))</strong>
                            <p>Impact combiné sur volume, efficacité, création et protection.</p>
                          </aside>
                        </div>
                      }
                    </section>
                </div>
            }
            @if (ActiveDashboardSection == "spotlight")
            {
                <div class="tab-panel active">
                    @if (IsSpotlightLoading && Snapshot.Spotlight.PlayerId <= 0)
                    {
                        <StateCard Kicker="Chargement"
                                   Title="Profil joueuse en cours de chargement"
                                   Message="Les statistiques de la joueuse suivie arrivent dans quelques instants."
                                   Tone="loading" />
                    }
                    else if (Snapshot.Spotlight.PlayerId <= 0)
                    {
                        <StateCard Kicker="Aucune joueuse"
                                   Title="Aucune joueuse suivie"
                                   Message="Sélectionnez une joueuse dans les filtres pour afficher son profil."
                                   Tone="empty" />
                    }
                    else
                    {
                        var spPhotoUrl = PlayerPhotoAssetResolver.Resolve(null, Snapshot.Spotlight.PlayerId, Snapshot.Spotlight.FullName, Snapshot.Spotlight.TeamName);
                        <div class="dashboard-spotlight-layout">
                            <section class="dashboard-spotlight-card">
                                <div class="dashboard-spotlight-id">
                                    <div class="dashboard-spotlight-photo">
                                        @if (spPhotoUrl != null)
                                        {
                                            <img src="@spPhotoUrl" alt="@Snapshot.Spotlight.FullName" />
                                        }
                                    </div>
                                    <div>
                                        <p class="dashboard-section-kicker">Joueuse du jour</p>
                                        <h3>@Snapshot.Spotlight.FullName</h3>
                                        <span class="text-muted">@Snapshot.Spotlight.PositionName · @Snapshot.Spotlight.TeamName · @Snapshot.Spotlight.MatchesPlayed matchs</span>
                                    </div>
                                </div>
                                <div class="dashboard-spotlight-kpis">
                                    <article><span>Buts</span><strong>@Snapshot.Spotlight.TotalGoals</strong></article>
                                    <article>
                                        <span>@(Snapshot.Spotlight.IsGoalkeeper ? "Taux d'arrêt" : "Efficacité")</span>
                                        <strong>@HandballKpiHelper.FormatPercent(Snapshot.Spotlight.IsGoalkeeper ? (double)Snapshot.Spotlight.Goalkeeper.TauxArret : Snapshot.Spotlight.ShootingRate)</strong>
                                    </article>
                                    <article><span>Passes</span><strong>@Snapshot.Spotlight.Assists</strong></article>
                                    <article>
                                        <span>@(Snapshot.Spotlight.IsGoalkeeper ? "Arrêts" : "Impact déf.")</span>
                                        <strong>@(Snapshot.Spotlight.IsGoalkeeper ? Snapshot.Spotlight.Saves : Snapshot.Spotlight.DefensiveStops)</strong>
                                    </article>
                                </div>
                                <article class="dashboard-signal-item dashboard-signal-item--up">
                                    <span class="dashboard-signal-icon">↑</span>
                                    <div>
                                        <small>Tendance saison</small>
                                        <strong>@Snapshot.Spotlight.TotalGoals buts · @Snapshot.Spotlight.Assists passes</strong>
                                        <p>@Snapshot.Spotlight.MatchesPlayed matchs joués dans le scope actif.</p>
                                    </div>
                                </article>
                                <a href="/players" class="btn btn-primary btn-sm">Voir la fiche complète</a>
                            </section>
                            @if (Snapshot.Spotlight.Distribution.Count > 0)
                            {
                                <section class="dashboard-ranking-panel">
                                    <div class="dashboard-section-head">
                                        <div><p class="dashboard-section-kicker">Distribution</p><h3>Répartition des actions</h3></div>
                                    </div>
                                    <ApexChart TItem="SliceValue" Height="280" Options="@GetDistributionChartOptions()">
                                        <ApexPointSeries TItem="SliceValue"
                                                         Items="@Snapshot.Spotlight.Distribution"
                                                         Name="Actions"
                                                         SeriesType="SeriesType.Donut"
                                                         XValue="slice => slice.Label"
                                                         YValue="slice => (decimal?)slice.Value" />
                                    </ApexChart>
                                </section>
                            }
                        </div>
                    }
                </div>
            }
            @if (ActiveDashboardSection == "global-rankings")
            {
                @if (IsPlayerTableLoading)
                {
                    <PageLoader Kicker="Chargement à la demande"
                                Title="Chargement du tableau analytique"
                                Message="Cette section est chargée uniquement lorsque vous l'ouvrez." />
                }

                <div class="dashboard-panel pt-panel">
                    <div class="dashboard-panel-head">
                        <div>
                            <p class="dashboard-section-kicker">Classements globaux</p>
                            <h3>Tableau analytique joueuses</h3>
                        </div>
                    </div>

                    <!-- Groupe joueuses de champ / gardiennes -->
                    <div class="player-table-group-tabs">
                        <button type="button"
                                class="ptg-tab @(PlayerTableGroup == "field" ? "active" : string.Empty)"
                                @onclick='() => SetPlayerTableGroup("field")'>
                            Joueuses de champ
                            <span class="ptg-count">@PlayerTable.FieldPlayers.Count</span>
                        </button>
                        <button type="button"
                                class="ptg-tab @(PlayerTableGroup == "goalkeeper" ? "active" : string.Empty)"
                                @onclick='() => SetPlayerTableGroup("goalkeeper")'>
                            Gardiennes
                            <span class="ptg-count">@PlayerTable.Goalkeepers.Count</span>
                        </button>
                    </div>

                    <!-- Barre de filtres locaux -->
                    <div class="player-table-local-filters">
                        <input type="search"
                               placeholder="Rechercher une joueuse&hellip;"
                               value="@PlayerTableSearch"
                               @oninput="e => PlayerTableSearch = e.Value?.ToString() ?? string.Empty"
                               class="pt-search"
                               aria-label="Rechercher une joueuse" />

                        @if (PlayerTableGroup == "field")
                        {
                            <div class="pt-pos-chips" role="group" aria-label="Filtrer par poste">
                                <button type="button"
                                        class="pt-pos-chip @(PlayerTablePositionId is null ? "active" : string.Empty)"
                                        @onclick="() => SetPlayerTablePosition(null)">
                                    Tout
                                </button>
                                @foreach (var pos in PlayerTableFieldPositions)
                                {
                                    <button type="button"
                                            class="pt-pos-chip @(PlayerTablePositionId == pos.Id ? "active" : string.Empty)"
                                            @onclick="() => SetPlayerTablePosition(pos.Id)">
                                        @pos.Code
                                    </button>
                                }
                            </div>
                        }
                    </div>

                    @if (PlayerTableGroup == "field")
                    {
                        <!-- Sous-onglets vue joueuses de champ -->
                        <div class="player-table-view-tabs">
                            <button type="button"
                                    class="ptv-tab @(FieldView == "summary" ? "active" : string.Empty)"
                                    @onclick='() => FieldView = "summary"'>
                                Synthèse
                            </button>
                            <button type="button"
                                    class="ptv-tab @(FieldView == "attack" ? "active" : string.Empty)"
                                    @onclick='() => FieldView = "attack"'>
                                Attaque
                            </button>
                            <button type="button"
                                    class="ptv-tab @(FieldView == "defense" ? "active" : string.Empty)"
                                    @onclick='() => FieldView = "defense"'>
                                Défense
                            </button>
                        </div>

                        <!-- Tableau joueuses de champ -->

                        @if (FilteredFieldRows.Count == 0)
                        {
                            <StateCard Kicker="Aucune joueuse"
                                       Title="Aucune joueuse dans ce filtre"
                                       Message="Changez le poste ou elargissez la recherche."
                                       Tone="empty"
                                       CssClass="empty-card-inline" />
                        }
                        else
                        {
                            <div class="pt-table-wrap" role="region" aria-label="Tableau joueuses de champ" style="height: 60vh; overflow-y: auto;">
                                <table class="analytics-table analytics-table--@FieldView" role="grid">
                                    <caption class="sr-only">Tableau analytique des joueuses de champ — vue @FieldView</caption>
                                    <thead>
                                        <tr>
                                            <th scope="col" class="col-identity" aria-sort="@PtSortAria("pt-name")">
                                                <button type="button" class="sort-btn" @onclick='() => SetPlayerTableSort("pt-name")'>
                                                    Joueuse @PtSortGlyph("pt-name")
                                                </button>
                                            </th>
                                            @if (FieldView != "defense")
                                            {
                                                <th scope="col" class="hide-mobile" aria-sort="@PtSortAria("pt-team")">
                                                    <button type="button" class="sort-btn" @onclick='() => SetPlayerTableSort("pt-team")'>
                                                        Equipe @PtSortGlyph("pt-team")
                                                    </button>
                                                </th>
                                            }
                                            <th scope="col" aria-sort="@PtSortAria("pt-matches")">
                                                <button type="button" class="sort-btn" @onclick='() => SetPlayerTableSort("pt-matches")'>
                                                    MJ @PtSortGlyph("pt-matches")
                                                </button>
                                            </th>
                                            @if (FieldView == "summary" || FieldView == "attack")
                                            {
                                                <th scope="col" aria-sort="@PtSortAria("pt-goals")">
                                                    <button type="button" class="sort-btn" @onclick='() => SetPlayerTableSort("pt-goals")'>
                                                        Buts @PtSortGlyph("pt-goals")
                                                    </button>
                                                </th>
                                                <th scope="col" aria-sort="@PtSortAria("pt-open-goals")">
                                                    <button type="button" class="sort-btn" @onclick='() => SetPlayerTableSort("pt-open-goals")'>
                                                        Buts jeu @PtSortGlyph("pt-open-goals")
                                                    </button>
                                                </th>
                                                <th scope="col" aria-sort="@PtSortAria("pt-penalty-goals")">
                                                    <button type="button" class="sort-btn" @onclick='() => SetPlayerTableSort("pt-penalty-goals")'>
                                                        Buts 7m @PtSortGlyph("pt-penalty-goals")
                                                    </button>
                                                </th>
                                                <th scope="col" aria-sort="@PtSortAria("pt-assists")">
                                                    <button type="button" class="sort-btn" @onclick='() => SetPlayerTableSort("pt-assists")'>
                                                        Passes @PtSortGlyph("pt-assists")
                                                    </button>
                                                </th>
                                            }
                                            @if (FieldView == "attack")
                                            {
                                                <th scope="col" aria-sort="none" title="Non disponible en V1">
                                                    7m obtenus
                                                </th>
                                                <th scope="col" aria-sort="@PtSortAria("pt-turnovers")">
                                                    <button type="button" class="sort-btn" @onclick='() => SetPlayerTableSort("pt-turnovers")'>
                                                        Pertes @PtSortGlyph("pt-turnovers")
                                                    </button>
                                                </th>
                                                <th scope="col" aria-sort="@PtSortAria("pt-bad-passes")">
                                                    <button type="button" class="sort-btn" @onclick='() => SetPlayerTableSort("pt-bad-passes")'>
                                                        Mauvaises passes @PtSortGlyph("pt-bad-passes")
                                                    </button>
                                                </th>
                                                <th scope="col" aria-sort="none" title="Donnee non disponible en V1">
                                                    PivotPF
                                                </th>
                                                <th scope="col" aria-sort="@PtSortAria("pt-open-shot-rate")">
                                                    <button type="button" class="sort-btn" @onclick='() => SetPlayerTableSort("pt-open-shot-rate")'>
                                                        Taux jeu @PtSortGlyph("pt-open-shot-rate")
                                                    </button>
                                                </th>
                                                <th scope="col" aria-sort="@PtSortAria("pt-penalty-shot-rate")">
                                                    <button type="button" class="sort-btn" @onclick='() => SetPlayerTableSort("pt-penalty-shot-rate")'>
                                                        Taux 7m @PtSortGlyph("pt-penalty-shot-rate")
                                                    </button>
                                                </th>
                                                <th scope="col" aria-sort="@PtSortAria("pt-total-shot-rate")">
