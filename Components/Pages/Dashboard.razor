                    </select>
                </div>
            </div>
            <footer class="filter-drawer__foot">
                <div class="filter-drawer__foot-actions">
                    <button type="button" class="ghost-button" @onclick="async () => { await ResetFiltersAsync(); CloseFilterDrawer(); }">Réinitialiser</button>
                    <button type="button" class="primary-button" @onclick="CloseFilterDrawer">Appliquer</button>
                </div>
            </footer>
        </div>
    </div>
}

@code {
    private RenderFragment RetryActions => builder =>
    {
        builder.OpenElement(0, "button");
        builder.AddAttribute(1, "type", "button");
        builder.AddAttribute(2, "class", "primary-button");
        builder.AddAttribute(3, "onclick", EventCallback.Factory.Create(this, RefreshAsync));
        builder.AddContent(4, "Réessayer");
        builder.CloseElement();
    };

    private bool _filterOpen;
    private string ActiveLens { get; set; } = AudienceLens.Analyst;
    private string ActiveDashboardSection { get; set; } = "league";

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            CommandBarService.Register(() => { _filterOpen = !_filterOpen; return InvokeAsync(StateHasChanged); });
        return Task.CompletedTask;
    }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        await LoadPlayerTableAsync();
    }

    private void CloseFilterDrawer() { _filterOpen = false; StateHasChanged(); }
    private static readonly int[] RankingTopOptions = [5, 8, 10, 12];
    private static readonly TeamOfTheDayRankingMetric[] TeamOfTheDayMetrics =
    [
        TeamOfTheDayRankingMetric.PieGlobal,
        TeamOfTheDayRankingMetric.PieOffense,
        TeamOfTheDayRankingMetric.PieDefense,
        TeamOfTheDayRankingMetric.TotalActions,
        TeamOfTheDayRankingMetric.Goals,
        TeamOfTheDayRankingMetric.Assists,
        TeamOfTheDayRankingMetric.DefensiveImpact,
        TeamOfTheDayRankingMetric.GoalkeeperStops
    ];
    private static readonly double?[] TeamOfTheDayPieThresholds = [null, 1d, 10d, 20d, 30d];
    private static readonly int?[] TeamOfTheDayActionThresholds = [null, 1, 5, 10, 20, 30];

    private TeamOfTheDayRankingMetric TeamOfTheDayMetric { get; set; } = TeamOfTheDayRankingMetric.PieGlobal;
    private double? TeamOfTheDayMinimumPie { get; set; }
    private int? TeamOfTheDayMinimumActions { get; set; }
    private int? GlobalRankingPositionId { get; set; }
    private string GlobalRankingStatCategory { get; set; } = "global";
    private string GlobalRankingPlayerGroup { get; set; } = "field";
    private TableSortState FieldBoardSort { get; set; } = new("field-goals", SortDirection.Desc);
    private TableSortState GoalkeeperBoardSort { get; set; } = new("keeper-saves", SortDirection.Desc);

    private bool ShowLeagueKpis => ActiveLens is AudienceLens.Club or AudienceLens.Analyst;

    private bool ShowRankingPanel => ActiveLens is AudienceLens.Club or AudienceLens.Analyst;

    private string? ActiveRankingSampleRule => GetRankingSampleRule(Filters.RankingMetric);

    private bool HasRankingSampleDetails => Snapshot?.RequestedRanking.Any(item => !string.IsNullOrWhiteSpace(item.SampleLabel)) == true;

    private bool ShowSpotlightDeepDive => ActiveLens is AudienceLens.Analyst or AudienceLens.Player;

    private bool ShowSpatialSection => ActiveLens is AudienceLens.Analyst or AudienceLens.Player;

    private IReadOnlyList<LookupItemDto> GlobalRankingPositionOptions => SmartFilterCatalog.GetPositions(
        ReferenceData.Positions,
        Snapshot?.GlobalBoards.FieldPlayers
            .Select(player => new PlayerListItemDto
            {
                PlayerId = player.PlayerId,
                FullName = player.FullName,
                TeamName = player.TeamName,
                PositionId = player.PositionId,
                PositionName = player.PositionLabel
            })
            .ToList() ?? [],
        GlobalRankingPositionId.HasValue || Snapshot?.GlobalBoards.FieldPlayers.Count > 0);

    private IReadOnlyList<GlobalFieldRankingRow> FilteredGlobalFieldRows => GetFilteredGlobalFieldRows();

    private IReadOnlyList<GlobalGoalkeeperRankingRow> SortedGlobalGoalkeeperRows => GetSortedGlobalGoalkeeperRows();

    private IReadOnlyList<TeamOfTheDayCandidateDto> TeamOfTheDayLineup =>
        Snapshot?.TeamOfTheDay.GetLineup(TeamOfTheDayMetric, TeamOfTheDayMinimumPie, TeamOfTheDayMinimumActions) ?? [];

    private IReadOnlyList<TeamOfTheDayCandidateDto> TeamOfTheDayCandidateRows =>
        Snapshot?.TeamOfTheDay.Groups
            .SelectMany(group => group.Candidates)
            .Where(candidate => candidate.MatchesFilters(TeamOfTheDayMetric, TeamOfTheDayMinimumPie, TeamOfTheDayMinimumActions))
            .OrderBy(candidate => candidate.PositionLabel)
            .ThenByDescending(candidate => candidate.ScoreFor(TeamOfTheDayMetric))
            .ThenByDescending(candidate => candidate.PieForFilter(TeamOfTheDayMetric))
            .ThenByDescending(candidate => candidate.StatLine.TotalActions)
            .ToList() ?? [];

    private string TeamOfTheDayMetricDescription => TeamOfTheDayMetric switch
    {
        TeamOfTheDayRankingMetric.PieOffense => "Score local exploratoire axe sur la production directe : buts, passes, efficacite au tir et maitrise du dechet.",
        TeamOfTheDayRankingMetric.PieDefense => "Score local exploratoire axe sur l'impact sans ballon : interceptions, contres, neutralisations, arrets et discipline.",
        TeamOfTheDayRankingMetric.TotalActions => "Classement au volume d'actions positives : buts, passes, impact defensif et arrets.",
        TeamOfTheDayRankingMetric.Goals => "Classement sur la production but, utile pour sortir la meilleure menace offensive pure.",
        TeamOfTheDayRankingMetric.Assists => "Classement sur la creation directe et la qualite de connexion avec le collectif.",
        TeamOfTheDayRankingMetric.DefensiveImpact => "Classement sur interceptions, contres, neutralisations et passages forces.",
        TeamOfTheDayRankingMetric.GoalkeeperStops => "Classement sur arrets et arrets 7m, surtout utile pour isoler les gardiennes.",
        _ => "Score technique local exploratoire combinant attaque, defense, actions positives et pertes."
    };

    protected override void OnDashboardRefreshing()
    {
        // Invalide le cache du tableau analytique quand le scope principal change.
        var previous = Interlocked.Exchange(ref _playerTableCts, null);
        previous?.Cancel();
        previous?.Dispose();
        IsPlayerTableLoaded = false;
        IsPlayerTableLoading = false;
        _playerTableScopeKey = null;
    }

