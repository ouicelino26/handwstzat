        IEnumerable<DashboardGoalkeeperRow> rows,
        Func<DashboardGoalkeeperRow, TableRateValue> rateSelector,
        bool ascending)
    {
        return ascending
            ? rows.OrderBy(r => rateSelector(r).Value.HasValue)
                .ThenBy(r => rateSelector(r).Value)
                .ThenBy(r => rateSelector(r).Denominator)
                .ThenBy(r => r.Identity.FullName)
            : rows.OrderByDescending(r => rateSelector(r).Value.HasValue)
                .ThenByDescending(r => rateSelector(r).Value)
                .ThenByDescending(r => rateSelector(r).Denominator)
                .ThenBy(r => r.Identity.FullName);
