                                       Tone="empty"
                                       CssClass="empty-card-inline" />
                        }
                        else
                        {
                            <div class="pt-table-wrap" role="region" aria-label="Tableau gardiennes">
                                <table class="analytics-table analytics-table--gk-@GoalkeeperView" role="grid">
                                    <caption class="sr-only">Tableau analytique des gardiennes — vue @GoalkeeperView</caption>
                                    <thead>
                                        <tr>
                                            <th scope="col" class="col-identity" aria-sort="@GkSortAria("gk-name")">
                                                <button type="button" class="sort-btn" @onclick='() => SetGoalkeeperTableSort("gk-name")'>
                                                    Gardienne @GkSortGlyph("gk-name")
                                                </button>
                                            </th>
                                            <th scope="col" class="hide-mobile" aria-sort="@GkSortAria("gk-team")">
                                                <button type="button" class="sort-btn" @onclick='() => SetGoalkeeperTableSort("gk-team")'>
                                                    Equipe @GkSortGlyph("gk-team")
                                                </button>
                                            </th>
                                            <th scope="col" aria-sort="@GkSortAria("gk-matches")">
                                                <button type="button" class="sort-btn" @onclick='() => SetGoalkeeperTableSort("gk-matches")'>
                                                    MJ @GkSortGlyph("gk-matches")
                                                </button>
                                            </th>
                                            @if (GoalkeeperView == "summary" || GoalkeeperView == "saves")
                                            {
                                                <th scope="col" aria-sort="@GkSortAria("gk-total-saves")">
                                                    <button type="button" class="sort-btn" @onclick='() => SetGoalkeeperTableSort("gk-total-saves")'>
                                                        Arrets @GkSortGlyph("gk-total-saves")
                                                    </button>
                                                </th>
                                                <th scope="col" aria-sort="@GkSortAria("gk-penalty-saves")">
                                                    <button type="button" class="sort-btn" @onclick='() => SetGoalkeeperTableSort("gk-penalty-saves")'>
                                                        Arrets 7m @GkSortGlyph("gk-penalty-saves")
                                                    </button>
                                                </th>
                                                <th scope="col" aria-sort="@GkSortAria("gk-total-save-rate")">
                                                    <button type="button" class="sort-btn" @onclick='() => SetGoalkeeperTableSort("gk-total-save-rate")'>
                                                        Taux arret @GkSortGlyph("gk-total-save-rate")
                                                    </button>
                                                </th>
                                            }
                                            @if (GoalkeeperView == "saves")
                                            {
                                                <th scope="col" aria-sort="@GkSortAria("gk-open-saves")">
                                                    <button type="button" class="sort-btn" @onclick='() => SetGoalkeeperTableSort("gk-open-saves")'>
                                                        Arr. jeu @GkSortGlyph("gk-open-saves")
                                                    </button>
                                                </th>
                                                <th scope="col" aria-sort="@GkSortAria("gk-open-save-rate")">
                                                    <button type="button" class="sort-btn" @onclick='() => SetGoalkeeperTableSort("gk-open-save-rate")'>
                                                        Tx arr. jeu @GkSortGlyph("gk-open-save-rate")
                                                    </button>
                                                </th>
                                                <th scope="col" aria-sort="@GkSortAria("gk-penalty-save-rate")">
                                                    <button type="button" class="sort-btn" @onclick='() => SetGoalkeeperTableSort("gk-penalty-save-rate")'>
                                                        Tx arr. 7m @GkSortGlyph("gk-penalty-save-rate")
                                                    </button>
                                                </th>
                                                <th scope="col" aria-sort="@GkSortAria("gk-shots-faced")">
                                                    <button type="button" class="sort-btn" @onclick='() => SetGoalkeeperTableSort("gk-shots-faced")'>
                                                        Tirs subis @GkSortGlyph("gk-shots-faced")
                                                    </button>
                                                </th>
                                            }
                                            @if (GoalkeeperView == "summary")
                                            {
                                                <th scope="col" aria-sort="@GkSortAria("gk-shots-faced")">
                                                    <button type="button" class="sort-btn" @onclick='() => SetGoalkeeperTableSort("gk-shots-faced")'>
                                                        Tirs subis @GkSortGlyph("gk-shots-faced")
                                                    </button>
                                                </th>
                                            }
                                            @if (GoalkeeperView == "ball")
                                            {
                                                <th scope="col" aria-sort="@GkSortAria("gk-assists")">
                                                    <button type="button" class="sort-btn" @onclick='() => SetGoalkeeperTableSort("gk-assists")'>
                                                        Passes @GkSortGlyph("gk-assists")
                                                    </button>
                                                </th>
                                                <th scope="col" aria-sort="@GkSortAria("gk-goals")">
                                                    <button type="button" class="sort-btn" @onclick='() => SetGoalkeeperTableSort("gk-goals")'>
                                                        Buts @GkSortGlyph("gk-goals")
                                                    </button>
                                                </th>
                                                <th scope="col" aria-sort="@GkSortAria("gk-turnovers")">
                                                    <button type="button" class="sort-btn" @onclick='() => SetGoalkeeperTableSort("gk-turnovers")'>
                                                        Pertes @GkSortGlyph("gk-turnovers")
