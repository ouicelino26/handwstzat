    private IReadOnlyList<DashboardFieldPlayerRow> GetFilteredFieldRows()
    {
        IEnumerable<DashboardFieldPlayerRow> rows = PlayerTable.FieldPlayers;

        if (!string.IsNullOrWhiteSpace(PlayerTableSearch))
        {
            rows = rows.Where(row =>
                row.Identity.FullName.Contains(PlayerTableSearch, StringComparison.OrdinalIgnoreCase));
        }

        if (PlayerTablePositionId.HasValue)
        {
            rows = rows.Where(row => row.Identity.PositionId == PlayerTablePositionId.Value);
        }

        rows = PlayerTableSortKey switch
        {
            "pt-name" => PlayerTableSortAsc
                ? rows.OrderBy(r => r.Identity.FullName)
                : rows.OrderByDescending(r => r.Identity.FullName),
            "pt-team" => PlayerTableSortAsc
                ? rows.OrderBy(r => r.Identity.TeamName)
                : rows.OrderByDescending(r => r.Identity.TeamName),
            "pt-matches" => PlayerTableSortAsc
                ? rows.OrderBy(r => r.Identity.MatchesPlayed).ThenBy(r => r.Identity.FullName)
                : rows.OrderByDescending(r => r.Identity.MatchesPlayed).ThenBy(r => r.Identity.FullName),
            "pt-open-goals" => PlayerTableSortAsc
                ? rows.OrderBy(r => r.Offense.OpenPlayGoals).ThenBy(r => r.Identity.MatchesPlayed).ThenBy(r => r.Identity.FullName)
                : rows.OrderByDescending(r => r.Offense.OpenPlayGoals).ThenBy(r => r.Identity.MatchesPlayed).ThenBy(r => r.Identity.FullName),
            "pt-penalty-goals" => PlayerTableSortAsc
                ? rows.OrderBy(r => r.Offense.PenaltyGoals).ThenBy(r => r.Identity.MatchesPlayed).ThenBy(r => r.Identity.FullName)
                : rows.OrderByDescending(r => r.Offense.PenaltyGoals).ThenBy(r => r.Identity.MatchesPlayed).ThenBy(r => r.Identity.FullName),
            "pt-assists" => PlayerTableSortAsc
                ? rows.OrderBy(r => r.Offense.Assists).ThenBy(r => r.Identity.MatchesPlayed).ThenBy(r => r.Identity.FullName)
                : rows.OrderByDescending(r => r.Offense.Assists).ThenBy(r => r.Identity.MatchesPlayed).ThenBy(r => r.Identity.FullName),
            "pt-turnovers" => PlayerTableSortAsc
                ? rows.OrderBy(r => r.Offense.TotalTurnovers).ThenBy(r => r.Identity.FullName)
                : rows.OrderByDescending(r => r.Offense.TotalTurnovers).ThenBy(r => r.Identity.FullName),
            "pt-bad-passes" => PlayerTableSortAsc
                ? rows.OrderBy(r => r.Offense.BadPasses).ThenBy(r => r.Identity.FullName)
                : rows.OrderByDescending(r => r.Offense.BadPasses).ThenBy(r => r.Identity.FullName),
            "pt-open-shot-rate" => SortFieldByRate(rows, r => r.Offense.OpenPlayShotRate, PlayerTableSortAsc),
            "pt-penalty-shot-rate" => SortFieldByRate(rows, r => r.Offense.PenaltyShotRate, PlayerTableSortAsc),
            "pt-total-shot-rate" => SortFieldByRate(rows, r => r.Offense.TotalShotRate, PlayerTableSortAsc),
            "pt-interceptions" => PlayerTableSortAsc
                ? rows.OrderBy(r => r.Defense.Interceptions).ThenBy(r => r.Identity.MatchesPlayed).ThenBy(r => r.Identity.FullName)
                : rows.OrderByDescending(r => r.Defense.Interceptions).ThenBy(r => r.Identity.MatchesPlayed).ThenBy(r => r.Identity.FullName),
            "pt-blocks" => PlayerTableSortAsc
                ? rows.OrderBy(r => r.Defense.Blocks).ThenBy(r => r.Identity.MatchesPlayed).ThenBy(r => r.Identity.FullName)
                : rows.OrderByDescending(r => r.Defense.Blocks).ThenBy(r => r.Identity.MatchesPlayed).ThenBy(r => r.Identity.FullName),
            "pt-neutralizations" => PlayerTableSortAsc
                ? rows.OrderBy(r => r.Defense.Neutralizations).ThenBy(r => r.Identity.MatchesPlayed).ThenBy(r => r.Identity.FullName)
                : rows.OrderByDescending(r => r.Defense.Neutralizations).ThenBy(r => r.Identity.MatchesPlayed).ThenBy(r => r.Identity.FullName),
            "pt-fouls-drawn" => PlayerTableSortAsc
                ? rows.OrderBy(r => r.Defense.OffensiveFoulsDrawn).ThenBy(r => r.Identity.MatchesPlayed).ThenBy(r => r.Identity.FullName)
                : rows.OrderByDescending(r => r.Defense.OffensiveFoulsDrawn).ThenBy(r => r.Identity.MatchesPlayed).ThenBy(r => r.Identity.FullName),
            "pt-penalties-conceded" => PlayerTableSortAsc
                ? rows.OrderBy(r => r.Defense.PenaltiesConceded).ThenBy(r => r.Identity.FullName)
                : rows.OrderByDescending(r => r.Defense.PenaltiesConceded).ThenBy(r => r.Identity.FullName),
            "pt-sanctions" => PlayerTableSortAsc
                ? rows.OrderBy(r => r.Defense.SanctionsConceded.Total).ThenBy(r => r.Identity.FullName)
                : rows.OrderByDescending(r => r.Defense.SanctionsConceded.Total).ThenBy(r => r.Identity.FullName),
            _ => PlayerTableSortAsc
                ? rows.OrderBy(r => r.Offense.TotalGoals).ThenBy(r => r.Identity.MatchesPlayed).ThenBy(r => r.Identity.FullName)
                : rows.OrderByDescending(r => r.Offense.TotalGoals).ThenBy(r => r.Identity.MatchesPlayed).ThenBy(r => r.Identity.FullName)
