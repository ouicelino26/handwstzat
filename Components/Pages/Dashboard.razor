                                    <thead>
                                        <tr>
                                            <th scope="col" class="col-identity" aria-sort="@PtSortAria("pt-name")">
                                                <button type="button" class="sort-btn" @onclick='() => SetPlayerTableSort("pt-name")'>
                                                    Joueuse @PtSortGlyph("pt-name")
                                                </button>
                                            </th>
                                            @if (FieldView != "defense")
                                            {
                                                <th scope="col" class="hide-mobile" aria-sort="@PtSortAria("pt-team")">
                                                    <button type="button" class="sort-btn" @onclick='() => SetPlayerTableSort("pt-team")'>
                                                        Equipe @PtSortGlyph("pt-team")
                                                    </button>
                                                </th>
                                            }
                                            <th scope="col" aria-sort="@PtSortAria("pt-matches")">
                                                <button type="button" class="sort-btn" @onclick='() => SetPlayerTableSort("pt-matches")'>
                                                    MJ @PtSortGlyph("pt-matches")
                                                </button>
                                            </th>
                                            @if (FieldView == "summary" || FieldView == "attack")
