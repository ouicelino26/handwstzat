    private static RenderFragment RenderRateCell(TableRateValue rate, string tone = "neutral") => builder =>
    {
        if (rate.IsUnavailable)
        {
            builder.OpenElement(0, "span");
            builder.AddAttribute(1, "class", "rate-unavailable");
            builder.AddAttribute(2, "title", rate.UnavailableReason ?? "Denominateur nul");
            builder.AddContent(3, "—");
            builder.CloseElement();
            builder.OpenElement(4, "span");
            builder.AddAttribute(5, "class", "rate-evidence");
            builder.AddContent(6, $"{(int)rate.Numerator}/{(int)rate.Denominator}");
            builder.CloseElement();
        }
        else
        {
            var toneClass = tone switch
            {
                "positive" => "rate-value--positive",
                "good"     => "rate-value--good",
                "warning"  => "rate-value--warning",
                "danger"   => "rate-value--danger",
                _          => string.Empty
            };
            builder.OpenElement(0, "span");
            builder.AddAttribute(1, "class", $"rate-value {toneClass}".TrimEnd());
            builder.AddContent(2, $"{rate.Value:0.##}%");
            builder.CloseElement();
            builder.OpenElement(3, "span");
            builder.AddAttribute(4, "class", "rate-evidence");
            builder.AddContent(5, $"{(int)rate.Numerator}/{(int)rate.Denominator}");
            builder.CloseElement();
        }
    };

    private static string CountTone(int value, int goodThreshold, int warningThreshold, bool lowerIsBetter = false)
    {
        if (!lowerIsBetter)
            return value >= goodThreshold ? "positive" : value >= warningThreshold ? "warning" : "danger";
        return value <= goodThreshold ? "positive" : value <= warningThreshold ? "warning" : "danger";
    }

    private static string CountToneClass(int value, int goodThreshold, int warningThreshold, bool lowerIsBetter = false)
        => CountTone(value, goodThreshold, warningThreshold, lowerIsBetter) switch
        {
            "positive" => "count-value--positive",
            "warning"  => "count-value--warning",
            "danger"   => "count-value--danger",
            _          => string.Empty
        };

    private async Task LoadPlayerTableAsync()
    {
        if (Snapshot is null)
        {
            return;
        }

        var scopeKey = $"{Filters.CompetitionId}|{Filters.TeamId}|{Filters.Season}|{Filters.Day}|{Filters.From}|{Filters.To}";

        if (_playerTableScopeKey == scopeKey && IsPlayerTableLoaded)
        {
            return;
        }

        var next = new CancellationTokenSource();
        var previous = Interlocked.Exchange(ref _playerTableCts, next);
        previous?.Cancel();
        previous?.Dispose();

        try
        {
            IsPlayerTableLoading = true;
            await InvokeAsync(StateHasChanged);

            var result = await DashboardService.LoadPlayerTableAsync(Filters, next.Token);
            next.Token.ThrowIfCancellationRequested();

            PlayerTable = result;
            IsPlayerTableLoaded = true;
            _playerTableScopeKey = scopeKey;
        }
        catch (OperationCanceledException) when (next.IsCancellationRequested)
        {
            // Une selection plus recente a supersede ce chargement.
        }
        catch (ApiRequestException ex)
        {
            Logger.LogWarning(ex, "Player table API error for scope {ScopeKey}.", scopeKey);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unexpected player table loading failure.");
        }
        finally
        {
            if (ReferenceEquals(Interlocked.CompareExchange(ref _playerTableCts, null, next), next))
            {
                IsPlayerTableLoading = false;
                await InvokeAsync(StateHasChanged);
            }

            next.Dispose();
        }
    }

