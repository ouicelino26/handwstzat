                                                <th scope="col" aria-sort="@PtSortAria("pt-goals")">
                                                    <button type="button" class="sort-btn" @onclick='() => SetPlayerTableSort("pt-goals")'>
                                                        Buts @PtSortGlyph("pt-goals")
                                                    </button>
                                                </th>
                                                <th scope="col" aria-sort="@PtSortAria("pt-open-goals")">
                                                    <button type="button" class="sort-btn" @onclick='() => SetPlayerTableSort("pt-open-goals")'>
                                                        Buts jeu @PtSortGlyph("pt-open-goals")
                                                    </button>
                                                </th>
                                                <th scope="col" aria-sort="@PtSortAria("pt-penalty-goals")">
                                                    <button type="button" class="sort-btn" @onclick='() => SetPlayerTableSort("pt-penalty-goals")'>
                                                        Buts 7m @PtSortGlyph("pt-penalty-goals")
                                                    </button>
