                                                        Pertes @PtSortGlyph("pt-turnovers")
                                                    </button>
                                                </th>
                                                <th scope="col" aria-sort="@PtSortAria("pt-bad-passes")">
                                                    <button type="button" class="sort-btn" @onclick='() => SetPlayerTableSort("pt-bad-passes")'>
                                                        Mauvaises passes @PtSortGlyph("pt-bad-passes")
                                                    </button>
                                                </th>
                                                <th scope="col" aria-sort="none" title="Donnee non disponible en V1">
                                                    PivotPF
                                                </th>
                                                <th scope="col" aria-sort="@PtSortAria("pt-open-shot-rate")">
                                                    <button type="button" class="sort-btn" @onclick='() => SetPlayerTableSort("pt-open-shot-rate")'>
                                                        Taux jeu @PtSortGlyph("pt-open-shot-rate")
                                                    </button>
                                                </th>
                                                <th scope="col" aria-sort="@PtSortAria("pt-penalty-shot-rate")">
                                                    <button type="button" class="sort-btn" @onclick='() => SetPlayerTableSort("pt-penalty-shot-rate")'>
                                                        Taux 7m @PtSortGlyph("pt-penalty-shot-rate")
                                                    </button>
                                                </th>
                                                <th scope="col" aria-sort="@PtSortAria("pt-total-shot-rate")">
                                                    <button type="button" class="sort-btn" @onclick='() => SetPlayerTableSort("pt-total-shot-rate")'>
                                                        Taux global @PtSortGlyph("pt-total-shot-rate")
                                                    </button>
                                                </th>
                                            }
                                            @if (FieldView == "summary")
                                            {
                                                <th scope="col" aria-sort="@PtSortAria("pt-total-shot-rate")">
                                                    <button type="button" class="sort-btn" @onclick='() => SetPlayerTableSort("pt-total-shot-rate")'>
                                                        Taux tir @PtSortGlyph("pt-total-shot-rate")
                                                    </button>
                                                </th>
                                                <th scope="col" aria-sort="@PtSortAria("pt-interceptions")">
                                                    <button type="button" class="sort-btn" @onclick='() => SetPlayerTableSort("pt-interceptions")'>
                                                        Int. @PtSortGlyph("pt-interceptions")
                                                    </button>
                                                </th>
                                                <th scope="col" aria-sort="@PtSortAria("pt-turnovers")">
                                                    <button type="button" class="sort-btn" @onclick='() => SetPlayerTableSort("pt-turnovers")'>
                                                        Pertes @PtSortGlyph("pt-turnovers")
                                                    </button>
                                                </th>
                                            }
                                            @if (FieldView == "defense")
                                            {
                                                <th scope="col" aria-sort="@PtSortAria("pt-interceptions")">
                                                    <button type="button" class="sort-btn" @onclick='() => SetPlayerTableSort("pt-interceptions")'>
                                                        Interceptions @PtSortGlyph("pt-interceptions")
                                                    </button>
                                                </th>
                                                <th scope="col" aria-sort="@PtSortAria("pt-blocks")">
                                                    <button type="button" class="sort-btn" @onclick='() => SetPlayerTableSort("pt-blocks")'>
                                                        Contres @PtSortGlyph("pt-blocks")
                                                    </button>
                                                </th>
                                                <th scope="col" aria-sort="@PtSortAria("pt-neutralizations")">
                                                    <button type="button" class="sort-btn" @onclick='() => SetPlayerTableSort("pt-neutralizations")'>
                                                        Neutral. @PtSortGlyph("pt-neutralizations")
                                                    </button>
                                                </th>
                                                <th scope="col" aria-sort="@PtSortAria("pt-fouls-drawn")">
                                                    <button type="button" class="sort-btn" @onclick='() => SetPlayerTableSort("pt-fouls-drawn")'>
                                                        PF prov. @PtSortGlyph("pt-fouls-drawn")
                                                    </button>
                                                </th>
                                                <th scope="col" aria-sort="@PtSortAria("pt-penalties-conceded")">
                                                    <button type="button" class="sort-btn" @onclick='() => SetPlayerTableSort("pt-penalties-conceded")'>
                                                        Pen. c. @PtSortGlyph("pt-penalties-conceded")
                                                    </button>
                                                </th>
                                                <th scope="col" aria-sort="@PtSortAria("pt-sanctions")">
                                                    <button type="button" class="sort-btn" @onclick='() => SetPlayerTableSort("pt-sanctions")'>
                                                        Sanctions @PtSortGlyph("pt-sanctions")
                                                    </button>
                                                </th>
                                                <th scope="col" aria-sort="none" title="Non disponible en V1">
                                                    Sanct. obtenues
                                                </th>
                                            }
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var (row, idx) in FilteredFieldRows.Select((r, i) => (r, i)))
                                        {
                                            <tr class="@(idx % 2 != 0 ? "row-alt" : string.Empty)">
                                                <td class="col-identity">
                                                    <span class="pt-name">@row.Identity.FullName</span>
                                                    <span class="pt-position-badge">@row.Identity.PositionLabel</span>
                                                </td>
                                                @if (FieldView != "defense")
                                                {
                                                    <td class="hide-mobile">@row.Identity.TeamName</td>
                                                }
                                                <td>@row.Identity.MatchesPlayed</td>
                                                @if (FieldView == "summary" || FieldView == "attack")
                                                {
                                                    <td><strong>@row.Offense.TotalGoals</strong></td>
                                                    <td>@row.Offense.OpenPlayGoals</td>
                                                    <td>@row.Offense.PenaltyGoals</td>
                                                    <td>@row.Offense.Assists</td>
                                                }
                                                @if (FieldView == "attack")
                                                {
                                                    <td><span class="data-unavailable" title="Non disponible en source V1">—</span></td>
                                                    <td>@row.Offense.TotalTurnovers</td>
                                                    <td>@row.Offense.BadPasses</td>
                                                    <td><span class="data-missing" title="Donnee non disponible en V1">—</span></td>
                                                    <td>@RenderRateCell(row.Offense.OpenPlayShotRate)</td>
                                                    <td>@RenderRateCell(row.Offense.PenaltyShotRate)</td>
                                                    <td>@RenderRateCell(row.Offense.TotalShotRate)</td>
                                                }
                                                @if (FieldView == "summary")
                                                {
                                                    <td>@RenderRateCell(row.Offense.TotalShotRate)</td>
                                                    <td>@row.Defense.Interceptions</td>
                                                    <td>@row.Offense.TotalTurnovers</td>
                                                }
                                                @if (FieldView == "defense")
                                                {
                                                    <td>@row.Defense.Interceptions</td>
                                                    <td>@row.Defense.Blocks</td>
                                                    <td>@row.Defense.Neutralizations</td>
                                                    <td>@row.Defense.OffensiveFoulsDrawn</td>
                                                    <td>@row.Defense.PenaltiesConceded</td>
                                                    <td>
                                                        @row.Defense.SanctionsConceded.Total
                                                        <span class="sanction-detail"
                                                              title="Avert. @row.Defense.SanctionsConceded.Warnings · 2min @row.Defense.SanctionsConceded.TwoMinutes · DQ @row.Defense.SanctionsConceded.Disqualifications">
                                                            &#9432;
                                                        </span>
                                                    </td>
                                                    <td><span class="data-unavailable" title="Non disponible en source V1">—</span></td>
                                                }
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    }
                    else
                    {
                        <!-- Sous-onglets vue gardiennes -->
                        <div class="player-table-view-tabs">
                            <button type="button"
                                    class="ptv-tab @(GoalkeeperView == "summary" ? "active" : string.Empty)"
                                    @onclick='() => GoalkeeperView = "summary"'>
                                Synthèse
                            </button>
                            <button type="button"
                                    class="ptv-tab @(GoalkeeperView == "saves" ? "active" : string.Empty)"
                                    @onclick='() => GoalkeeperView = "saves"'>
                                Arrêts
                            </button>
                            <button type="button"
                                    class="ptv-tab @(GoalkeeperView == "ball" ? "active" : string.Empty)"
                                    @onclick='() => GoalkeeperView = "ball"'>
                                Avec ballon
                            </button>
                        </div>

