                        {
                            <option value="@competition.CompetitionId">@competition.CompetitionName</option>
                        }
                    </select>
                </div>
                <div class="filter-section">
                    <span class="filter-section__label">Équipe</span>
                    <select class="form-select" @bind="Filters.TeamId" @bind:after="OnScopeSelectionChangedAsync">
