    private static IOrderedEnumerable<GlobalFieldRankingRow> SortFieldShotRate(
        IEnumerable<GlobalFieldRankingRow> rows,
        bool isDescending)
    {
        return isDescending
            ? rows.OrderByDescending(IsReliableFieldShotRate)
                .ThenByDescending(item => item.ShotSuccessRate)
                .ThenByDescending(item => item.OpenShotAttempts)
                .ThenBy(item => item.FullName)
            : rows.OrderByDescending(IsReliableFieldShotRate)
                .ThenBy(item => item.ShotSuccessRate)
                .ThenByDescending(item => item.OpenShotAttempts)
                .ThenBy(item => item.FullName);
    }

    private static IOrderedEnumerable<GlobalGoalkeeperRankingRow> SortGoalkeeperSaveRate(
        IEnumerable<GlobalGoalkeeperRankingRow> rows,
        bool isDescending)
    {
        return isDescending
            ? rows.OrderByDescending(IsReliableGoalkeeperSaveRate)
                .ThenByDescending(item => item.SaveRate)
                .ThenByDescending(item => item.ShotsFaced)
                .ThenBy(item => item.FullName)
            : rows.OrderByDescending(IsReliableGoalkeeperSaveRate)
                .ThenBy(item => item.SaveRate)
                .ThenByDescending(item => item.ShotsFaced)
                .ThenBy(item => item.FullName);
    }

    private static IOrderedEnumerable<GlobalGoalkeeperRankingRow> SortGoalkeeperShotRate(
        IEnumerable<GlobalGoalkeeperRankingRow> rows,
        bool isDescending)
    {
        return isDescending
            ? rows.OrderByDescending(IsReliableGoalkeeperShotRate)
                .ThenByDescending(item => item.ShotSuccessRate)
                .ThenByDescending(item => item.OpenShotAttempts)
                .ThenBy(item => item.FullName)
            : rows.OrderByDescending(IsReliableGoalkeeperShotRate)
                .ThenBy(item => item.ShotSuccessRate)
                .ThenByDescending(item => item.OpenShotAttempts)
                .ThenBy(item => item.FullName);
    }

    private static bool IsReliableFieldShotRate(GlobalFieldRankingRow player)
    {
        return player.OpenShotAttempts >= 4;
    }

    private static bool IsReliableGoalkeeperSaveRate(GlobalGoalkeeperRankingRow player)
    {
        return player.ShotsFaced >= 10;
    }

    private static bool IsReliableGoalkeeperShotRate(GlobalGoalkeeperRankingRow player)
    {
        return player.OpenShotAttempts >= 4;
    }

