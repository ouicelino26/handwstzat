    private bool IsTeamOfTheDayPieThresholdActive(double? threshold)
    {
        if (!threshold.HasValue)
        {
            return !TeamOfTheDayMinimumPie.HasValue;
        }

        return TeamOfTheDayMinimumPie.HasValue && Math.Abs(TeamOfTheDayMinimumPie.Value - threshold.Value) < 0.01d;
    }

    private bool IsTeamOfTheDayActionThresholdActive(int? threshold)
    {
        return threshold == TeamOfTheDayMinimumActions;
    }

