    private static string TeamOfTheDayActionThresholdLabel(int? threshold)
    {
        if (!threshold.HasValue)
        {
            return "Toutes";
        }

        return threshold.Value <= 1 ? "1 action" : $"{threshold.Value} actions";
    }

