@page "/players"
@using System.Globalization
@using System.Text
@using HandWStat.Services.Navigation
@inject ReferenceDataService ReferenceDataService
@inject PlayersApiClient PlayersApiClient
@inject MatchesApiClient MatchesApiClient
@inject StatsApiClient StatsApiClient
@inject LeaguePlayerAnalyticsService LeagueAnalyticsService
@inject IApiAuthService AuthService
@inject IJSRuntime JS
@inject AnalysisScopeService ScopeService
@inject CommandBarService CommandBarService
@inject NavigationManager NavigationManager
@inject ILogger<Players> Logger
@inject IAppAssetReader AppAssetReader
@implements IDisposable

<PageTitle>Athletes</PageTitle>

<div class="page-players-shell">
@if (!AuthService.Session.IsAuthenticated)
{
    <AccessRequiredCard Message="Connectez-vous pour ouvrir les fiches joueuses, les zones et les feuilles de match." />
}
else
{
    @if (IsFilterDrawerOpen)
    {
        <div class="filter-drawer-overlay" @onclick="CloseFilterDrawer" role="dialog" aria-modal="true" aria-label="Filtres joueuses">
            <div class="filter-drawer" @onclick:stopPropagation="true">
                <header class="filter-drawer__head">
                    <h3 class="filter-drawer__title">Filtres joueuses</h3>
                    <button type="button" class="filter-drawer__close" @onclick="CloseFilterDrawer">×</button>
                </header>
                <div class="filter-drawer__body page-filters">
                    <div class="filter-section">
                        <span class="filter-section__label">Recherche</span>
                        <input class="form-input" value="@Search" @oninput="OnSearchChangedAsync" placeholder="Nom ou prénom" data-testid="player-search" />
                    </div>
                    <div class="filter-section">
                        <span class="filter-section__label">Compétition</span>
                        <select class="form-select" @bind="CompetitionId" @bind:after="OnDirectoryScopeChangedAsync">
                            <option value="">Toutes</option>
                            @foreach (var comp in AvailableCompetitions) { <option value="@comp.CompetitionId">@comp.CompetitionName</option> }
                        </select>
                    </div>
                    <div class="filter-section">
                        <span class="filter-section__label">Équipe</span>
                        <select class="form-select" @bind="TeamId" @bind:after="OnDirectoryScopeChangedAsync">
                            <option value="">Toutes</option>
                            @foreach (var team in AvailableTeams) { <option value="@team.TeamId">@team.TeamName</option> }
                        </select>
                    </div>
                    <div class="filter-section">
                        <span class="filter-section__label">Poste</span>
                        <div class="filter-chips">
                            <button type="button" class="position-chip @(PositionId == null ? "is-active" : "")" @onclick="async () => { PositionId = null; await OnDirectoryScopeChangedAsync(); }">Tous</button>
                            @foreach (var pos in AvailablePositions)
                            {
                                var _chipPosId   = pos.Id;
                                var _chipPosName = pos.Name;
                                <button type="button" class="position-chip @(PositionId == _chipPosId ? "is-active" : "")" @onclick="async () => { PositionId = _chipPosId; await OnDirectoryScopeChangedAsync(); }">@_chipPosName</button>
                            }
                        </div>
                    </div>
                    <div class="filter-section">
                        <span class="filter-section__label">Saison</span>
                        <select class="form-select" @bind="Season" @bind:after="OnDirectoryScopeChangedAsync">
                            <option value="">Toutes</option>
                            @foreach (var season in SeasonOptions) { <option value="@season">@season</option> }
                        </select>
                    </div>
                </div>
                <footer class="filter-drawer__foot">
                    <div class="filter-drawer__foot-actions">
                        <button type="button" class="ghost-button" @onclick="CloseFilterDrawer">Annuler</button>
                        <button type="button" class="primary-button" @onclick="CloseFilterDrawer">Appliquer</button>
                    </div>
                </footer>
            </div>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <StateCard Kicker="Erreur" Title="Impossible de charger le répertoire" Message="@ErrorMessage" Tone="error" />
    }
    else if (IsBusy && PlayerDirectory.Count == 0)
    {
        <StateCard Kicker="Chargement" Title="Chargement du répertoire joueuses" Message="Préparation des filtres, de la liste et de la fiche détaillée." Tone="loading" />
    }
    else if (!HasDirectoryCriteria)
    {
        <StateCard Kicker="Filtre requis" Title="Sélectionnez un filtre pour charger les joueuses" Message="Choisissez au moins une compétition, une équipe, un poste ou saisissez une recherche." Tone="empty" />
    }
    else
    {
        <div class="players-subtoolbar">
            <span class="badge badge-outline" style="font-variant-numeric: tabular-nums;">
                @PlayerDirectory.Count.ToString("00") joueuses
            </span>
        </div>
        <div class="page-players__layout @(IsDirectoryDrawerOpen ? string.Empty : "is-list-collapsed")">

            @* ── LEFT: player list pane ── *@
            <aside class="player-list-pane @(IsDirectoryDrawerOpen ? string.Empty : "is-list-collapsed")">
                <div class="player-list-pane__toolbar">
                    <span class="player-list-count"><strong>@PlayerDirectory.Count.ToString("00")</strong><small>joueuses</small></span>
                </div>
                <div class="player-list-pane__body">
                    @if (IsBusy && PlayerDirectory.Count > 0) { <p class="player-list-pane__loader">Actualisation…</p> }
                    <PlayerList Players="@FilteredPlayerDirectory"
                                SelectedPlayerId="@SelectedPlayerId"
                                SlimMode="true"
                                ShowGoalKpi="true"
                                EmptyKicker="Aucune joueuse"
                                EmptyTitle="Le filtre courant ne retourne aucune fiche"
                                EmptyMessage="Essayez un contexte plus large ou retirez un filtre trop restrictif."
                                OnSelectedPlayerChanged="SelectPlayerAsync" />
                </div>
            </aside>

            <button type="button"
                    class="player-list-expander"
                    @onclick="ToggleDirectoryDrawer"
                    aria-label="@(IsDirectoryDrawerOpen ? "Réduire la liste" : "Ouvrir la liste")">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 18l-6-6 6-6"></path></svg>
            </button>

            @* ── RIGHT: player detail pane ── *@
            <div class="player-detail-pane">
                @if (Profile is null || Global is null || Offense is null || Defense is null || Passing is null || Sanctions is null || Goalkeeper is null)
                {
                    <div class="player-detail-pane__body player-detail-pane__body--empty">
                        @if (IsBusy)
                        {
                            <PageLoader Kicker="Chargement" Title="Actualisation du répertoire" Message="La liste et la fiche de la joueuse se recalculent." />
                        }
                        else
                        {
                            <StateCard Kicker="Aucune fiche"
                                       Title="Choisissez une joueuse pour afficher la synthèse"
                                       Message="La vue détaillée, les zones et les matchs s'ouvrent après sélection."
                                       Tone="empty"
                                       CssClass="empty-card-inline" />
                        }
                    </div>
                }
                else
                {
                    var profile  = Profile!;
                    var global   = Global!;
                    var offense  = Offense!;
                    var defense  = Defense!;
                    var passing  = Passing!;
                    var sanctions = Sanctions!;
                    var goalkeeper = Goalkeeper!;
                    PlayerTechnicalStatsDto? technical = Technical;
                    var playerPhotoUrl = ResolvePlayerPhotoUrl(profile.PlayerPhoto, profile.PlayerId, profile.FullName, profile.TeamName);
                    var playerFlagUrl  = ResolveFlagAssetUrl(profile.Nationality);

                    var _posVariant = GetPositionChipVariant(profile.PositionCode ?? profile.PositionName);
                    @* ── Profile header ── *@
                    <div class="player-profile">
                        <div class="player-profile__avatar-lg">
                            @if (!string.IsNullOrWhiteSpace(playerPhotoUrl))
                            { <img src="@playerPhotoUrl" alt="@($"Portrait de {profile.FullName}")" loading="lazy" /> }
                            else { <span>@GetInitials(profile.FullName)</span> }
                        </div>
                        <div class="player-profile__identity">
                            <p class="player-profile__number">#@(profile.Number?.ToString("00") ?? "—")</p>
                            <h2 class="player-profile__name">@profile.FullName</h2>
                            <div class="player-profile__meta">
                                <span class="position-chip position-chip--@_posVariant">@(profile.PositionCode ?? profile.PositionName ?? "—")</span>
                                <span>@(profile.TeamName ?? "Équipe non renseignée")</span>
                                @if (!string.IsNullOrWhiteSpace(profile.Nationality))
                                {
                                    <span class="text-muted">
                                        @if (!string.IsNullOrWhiteSpace(playerFlagUrl)) { <img src="@playerFlagUrl" alt="" loading="lazy" style="width:1rem;height:auto;vertical-align:middle;" /> }
                                        @profile.Nationality
                                    </span>
                                }
                            </div>
                        </div>
                        <div class="player-profile__actions">
                            <a href="/position-profiles?playerId=@SelectedPlayerId"
                               class="btn btn-ghost btn-sm"
                               title="Voir le benchmark de poste pour cette joueuse">
                                Role benchmark →
                            </a>
                            @if (SelectedPlayerId.HasValue)
                            {
                                <a href="@AnalyticsNavigationService.BuildCompareUri([SelectedPlayerId.Value], CompetitionId, Season)"
                                   class="btn btn-ghost btn-sm"
                                   aria-label="Comparer cette joueuse">
                                    Comparer
                                </a>
                            }
                            <button type="button" class="primary-button" @onclick="ExportPlayerSheetAsync"
                                    disabled="@(!CanExportPlayerSheet || IsBusy || IsPlayerSheetExportBusy)">Exporter</button>
                        </div>
                    </div>
                    <div class="player-profile__facts">
                        <div class="player-badge">
                            <span class="player-badge__value">@profile.MatchesPlayed</span>
                            <span class="player-badge__label">Matchs</span>
                        </div>
                        @if (!profile.IsGoalkeeper)
                        {
                            <div class="player-badge player-badge--highlight">
                                <span class="player-badge__value">@offense.TotalButs</span>
                                <span class="player-badge__label">Buts</span>
                            </div>
                            <div class="player-badge">
                                <span class="player-badge__value">@passing.PasseDecisive</span>
                                <span class="player-badge__label">Passes déc.</span>
                            </div>
                            <div class="player-badge">
                                @{ var _defImpact = defense.Interceptions + defense.Contres + defense.Neutralisations; }
                                <span class="player-badge__value">@(_defImpact > 0 ? _defImpact.ToString() : "—")</span>
                                <span class="player-badge__label">Impact déf.</span>
                            </div>
                        }
                        else
                        {
                            <div class="player-badge player-badge--highlight">
                                <span class="player-badge__value">@(goalkeeper.Arrets + goalkeeper.ArretsPenalty)</span>
                                <span class="player-badge__label">Arrêts</span>
                            </div>
                            <div class="player-badge">
                                <span class="player-badge__value">@goalkeeper.TirsSubis</span>
                                <span class="player-badge__label">Tirs subis</span>
                            </div>
                            <div class="player-badge">
                                <span class="player-badge__value">@(goalkeeper.TauxArret > 0 ? $"{FormatRate(goalkeeper.TauxArret)}%" : "—")</span>
                                <span class="player-badge__label">% Arrêt</span>
                            </div>
                        }
                        @if (profile.Age.HasValue)
                        {
                            <div class="player-badge">
                                <span class="player-badge__value">@profile.Age</span>
                                <span class="player-badge__label">Ans</span>
                            </div>
                        }
                    </div>

                    @* ── Tab navigation ── *@
                    <div class="tab-group">
                        <nav class="tab-bar" role="tablist" aria-label="Sections de la joueuse">
                            <button type="button" role="tab" class="tab @(ActiveSection == "overview" ? "active" : string.Empty)" aria-selected="@(ActiveSection == "overview")" data-testid="tab-overview" @onclick='() => SetActiveSection("overview")'>Brief</button>
                            <button type="button" role="tab" class="tab @(ActiveSection == "analysis" ? "active" : string.Empty)" aria-selected="@(ActiveSection == "analysis")" data-testid="tab-analysis" @onclick='() => SetActiveSection("analysis")'>Performance</button>
                            <button type="button" role="tab" class="tab @(ActiveSection == "graphs"   ? "active" : string.Empty)" aria-selected="@(ActiveSection == "graphs")"   data-testid="tab-graphs" @onclick='() => SetActiveSection("graphs")'>Évolution</button>
                            <button type="button" role="tab" class="tab @(ActiveSection == "zones"    ? "active" : string.Empty)" aria-selected="@(ActiveSection == "zones")"    data-testid="tab-zones" @onclick='() => SetActiveSection("zones")'>Court</button>
                            <button type="button" role="tab" class="tab @(ActiveSection == "matches"  ? "active" : string.Empty)" aria-selected="@(ActiveSection == "matches")"  data-testid="tab-matches" @onclick='() => SetActiveSection("matches")'>Matchs</button>
                            <button type="button" role="tab" class="tab @(ActiveSection == "analyse"  ? "active" : string.Empty)" aria-selected="@(ActiveSection == "analyse")"  data-testid="tab-analyse" @onclick='() => SetActiveSection("analyse")'>Analyse</button>
                        </nav>
                    </div>

                    @* ── Tab body ── *@
                    <div class="player-detail-pane__body">

                    @* BRIEF *@
                    @if (ActiveSection == "overview")
                    {
                        <div class="brief-layout">
                            @if (!profile.IsGoalkeeper)
                            {
                                <section class="brief-section brief-section--offense">
                                    <div class="brief-section__header">
                                        <span class="brief-section__eyebrow">STAT OFFENSIVE</span>
                                        <h3 class="brief-section__title">Production et création</h3>
                                    </div>
                                    <div class="brief-section__panel">
                                        <dl class="brief-stat-list">
                                            @foreach (var kpi in BriefOffenseKpis)
                                            {
                                                <div class="brief-stat-row">
                                                    <dt>@kpi.Label</dt>
                                                    <dd>
                                                        <strong>@kpi.Value</strong>
                                                        @if (!string.IsNullOrEmpty(kpi.Caption))
                                                        {
                                                            <details class="stat-details">
                                                                <summary>Voir détails</summary>
                                                                <div class="stat-details__content">
                                                                    <div><span>@kpi.Caption</span></div>
                                                                </div>
                                                            </details>
                                                        }
                                                    </dd>
                                                </div>
                                            }
                                        </dl>
                                    </div>
                                </section>
                                <section class="brief-section brief-section--defense">
                                    <div class="brief-section__header">
                                        <span class="brief-section__eyebrow">STAT DÉFENSIVE</span>
                                        <h3 class="brief-section__title">Récupération et protection</h3>
                                    </div>
                                    <div class="brief-section__panel">
                                        <dl class="brief-stat-list">
                                            @foreach (var kpi in BriefDefenseKpis)
                                            {
                                                <div class="brief-stat-row">
                                                    <dt>@kpi.Label</dt>
                                                    <dd>
                                                        <strong>@kpi.Value</strong>
                                                        @if (!string.IsNullOrEmpty(kpi.Caption))
                                                        {
                                                            <details class="stat-details">
                                                                <summary>Voir détails</summary>
                                                                <div class="stat-details__content">
                                                                    <div><span>@kpi.Caption</span></div>
                                                                </div>
                                                            </details>
                                                        }
                                                    </dd>
                                                </div>
                                            }
                                        </dl>
                                    </div>
                                </section>
                                <section class="brief-section brief-section--technical">
                                    <div class="brief-section__header">
                                        <span class="brief-section__eyebrow">MAÎTRISE TECHNIQUE</span>
                                        <h3 class="brief-section__title">Pertes, déchets et discipline</h3>
                                    </div>
                                    <div class="brief-section__panel">
                                        <dl class="brief-stat-list">
                                            @foreach (var kpi in BriefGlobalKpis)
                                            {
                                                <div class="brief-stat-row">
                                                    <dt>@kpi.Label</dt>
                                                    <dd>
                                                        <strong>@kpi.Value</strong>
                                                        @if (!string.IsNullOrEmpty(kpi.Caption))
                                                        {
                                                            <details class="stat-details">
                                                                <summary>Voir détails</summary>
                                                                <div class="stat-details__content">
                                                                    <div><span>@kpi.Caption</span></div>
                                                                </div>
                                                            </details>
                                                        }
                                                    </dd>
                                                </div>
                                            }
                                        </dl>
                                    </div>
                                </section>
                            }
                            else
                            {
                                <section class="brief-section brief-section--defense">
                                    <div class="brief-section__header">
                                        <span class="brief-section__eyebrow">GARDIENNE</span>
                                        <h3 class="brief-section__title">Arrêts et efficacité</h3>
                                    </div>
                                    <div class="brief-section__panel">
                                        <dl class="brief-stat-list">
                                            @foreach (var kpi in BriefGoalkeeperKpis)
                                            {
                                                <div class="brief-stat-row">
                                                    <dt>@kpi.Label</dt>
                                                    <dd>
                                                        <strong>@kpi.Value</strong>
                                                        @if (!string.IsNullOrEmpty(kpi.Caption))
                                                        {
                                                            <details class="stat-details">
                                                                <summary>Voir détails</summary>
                                                                <div class="stat-details__content">
                                                                    <div><span>@kpi.Caption</span></div>
                                                                </div>
                                                            </details>
                                                        }
                                                    </dd>
                                                </div>
                                            }
                                        </dl>
                                    </div>
                                </section>
                                <section class="brief-section brief-section--technical">
                                    <div class="brief-section__header">
                                        <span class="brief-section__eyebrow">AVEC BALLON</span>
                                        <h3 class="brief-section__title">Relance et distribution</h3>
                                    </div>
                                    <div class="brief-section__panel">
                                        <dl class="brief-stat-list">
                                            @foreach (var kpi in BriefBallKpis)
                                            {
                                                <div class="brief-stat-row">
                                                    <dt>@kpi.Label</dt>
                                                    <dd>
                                                        <strong>@kpi.Value</strong>
                                                        @if (!string.IsNullOrEmpty(kpi.Caption))
                                                        {
                                                            <details class="stat-details">
                                                                <summary>Voir détails</summary>
                                                                <div class="stat-details__content">
                                                                    <div><span>@kpi.Caption</span></div>
                                                                </div>
                                                            </details>
                                                        }
                                                    </dd>
                                                </div>
                                            }
                                        </dl>
                                    </div>
                                </section>
                            }
                        </div>
                    }

                    @* PERFORMANCE *@
                    else if (ActiveSection == "analysis")
                    {
                        var v2Offense = LeagueAnalytics?.Analytics?.Offense;
                        var v2Defense = LeagueAnalytics?.Analytics?.Defense;
                        var v2Keeper  = LeagueAnalytics?.Analytics?.Goalkeeper;

                        <div class="tab-group tab-group--inner">
                            <nav class="tab-bar tab-bar--pills" role="tablist" aria-label="Sections Performance">
                                @if (!profile.IsGoalkeeper)
                                {
                                    <button type="button" role="tab" class="tab @(PerformanceSection == "attack"     ? "active" : "")" @onclick='() => PerformanceSection = "attack"'>Attaque</button>
                                    <button type="button" role="tab" class="tab @(PerformanceSection == "defense"    ? "active" : "")" @onclick='() => PerformanceSection = "defense"'>Défense</button>
                                    <button type="button" role="tab" class="tab @(PerformanceSection == "mastery"    ? "active" : "")" @onclick='() => PerformanceSection = "mastery"'>Maîtrise</button>
                                    <button type="button" role="tab" class="tab @(PerformanceSection == "discipline" ? "active" : "")" @onclick='() => PerformanceSection = "discipline"'>Discipline</button>
                                }
                                else
                                {
                                    <button type="button" role="tab" class="tab @(PerformanceSection == "saves"      ? "active" : "")" @onclick='() => PerformanceSection = "saves"'>Arrêts</button>
                                    <button type="button" role="tab" class="tab @(PerformanceSection == "ball"       ? "active" : "")" @onclick='() => PerformanceSection = "ball"'>Avec ballon</button>
                                    <button type="button" role="tab" class="tab @(PerformanceSection == "discipline" ? "active" : "")" @onclick='() => PerformanceSection = "discipline"'>Discipline</button>
                                }
                            </nav>

                            @if (!profile.IsGoalkeeper && PerformanceSection == "attack")
                            {
                                <div class="table-container">@{
                                    var _tG   = PerfCountOf(v2Offense, "TOTAL_GOALS",       Offense?.TotalButs ?? 0);
                                    var _oG   = PerfCountOf(v2Offense, "OPEN_PLAY_GOALS",    Offense?.Buts ?? 0);
                                    var _pG   = PerfCountOf(v2Offense, "PENALTY_GOALS",      Offense?.Buts7m ?? 0);
                                    var _ast  = PerfCountOf(v2Offense, "ASSISTS",             Passing?.PasseDecisive ?? 0);
                                    var _pwU  = PerfIsUnavailable(v2Offense, "PENALTIES_WON");
                                    var _sdU  = PerfIsUnavailable(v2Offense, "SANCTIONS_DRAWN");
                                    var _pwV  = PerfCountOf(v2Offense, "PENALTIES_WON", -1);
                                    var _sdV  = PerfCountOf(v2Offense, "SANCTIONS_DRAWN", -1);
                                    var _am   = profile.MatchesPlayed;
                                    var _tSh  = technical?.ShotAttempts ?? (Offense != null ? Offense.TotalButs + Offense.TirsRates + Offense.PenaltyRate : 0);
                                    var _oSh  = Offense != null ? Offense.Buts + Offense.TirsRates : 0;
                                    var _pSh  = Offense != null ? Offense.Buts7m + Offense.PenaltyRate : 0;
                                    var _bl   = Offense?.TirContre ?? 0;
                                    var _tRM  = PerfRateOf(v2Offense, "TOTAL_SHOT_RATE");
                                    var _oRM  = PerfRateOf(v2Offense, "OPEN_PLAY_SHOT_RATE");
                                    var _pRM  = PerfRateOf(v2Offense, "PENALTY_SHOT_RATE");
                                    var _tR   = _tRM?.Value ?? technical?.OverallShotSuccessRate ?? 0;
                                    var _oR   = _oRM?.Value ?? technical?.OpenShotSuccessRate ?? 0;
                                    var _pR   = _pRM?.Value ?? technical?.PenaltySuccessRate ?? 0;
                                    var _pt      = global.PlayingTimeMinutes;
                                    var _gc60    = AnalyticsCalculationService.ComputeGoalsCreatedPer60(global.TotalGoals, global.AssistCount, _pt);
                                    var _gc60Qt  = EvaluatePer60Quality(_pt, AnalyticsV3Catalog.Get("CAT-01")?.MinimumPlayingTimeMinutes ?? 150.0);
                                    var _oRQt    = EvaluateRateQuality(_oRM, AnalyticsV3Catalog.Get("CAT-04")?.MinimumSampleCount ?? 10);
                                    var _pwMPM   = !_pwU && _pwV > 0 && _am > 0 ? (double?)HandballKpiHelper.PerMatch(_pwV, _am) : null;
                                }<table class="data-table"><thead><tr><th>Catégorie</th><th class="data-table__num">Total</th><th class="data-table__num">/Match</th><th class="data-table__num">/60min</th></tr></thead><tbody>
                                    <tr class="table-group-header"><td colspan="4">Production</td></tr>
                                    <tr class="table-sub-row"><td>Buts total</td><td class="data-table__num">@_tG</td><td class="data-table__num">@(_am>0?HandballKpiHelper.FormatNumber(HandballKpiHelper.PerMatch(_tG,_am)):"—")</td><td class="data-table__num">—</td></tr>
                                    <tr class="table-sub-row"><td>Dans le jeu</td><td class="data-table__num">@_oG</td><td class="data-table__num">@(_am>0?HandballKpiHelper.FormatNumber(HandballKpiHelper.PerMatch(_oG,_am)):"—")</td><td class="data-table__num">—</td></tr>
                                    <tr class="table-sub-row"><td>7 mètres</td><td class="data-table__num">@_pG</td><td class="data-table__num">@(_am>0?HandballKpiHelper.FormatNumber(HandballKpiHelper.PerMatch(_pG,_am)):"—")</td><td class="data-table__num">—</td></tr>
                                    <tr class="table-sub-row"><td>Passes décisives</td><td class="data-table__num">@_ast</td><td class="data-table__num">@(_am>0?HandballKpiHelper.FormatNumber(HandballKpiHelper.PerMatch(_ast,_am)):"—")</td><td class="data-table__num">—</td></tr>
                                    @if (!_pwU && _pwV >= 0) { <tr class="table-sub-row"><td>7m obtenus</td><td class="data-table__num">@_pwV</td><td class="data-table__num">@(_pwMPM.HasValue ? HandballKpiHelper.FormatNumber(_pwMPM.Value) : "—")</td><td class="data-table__num">—</td></tr> }
                                    @if (!_sdU && _sdV >= 0) { <tr class="table-sub-row"><td>Sanctions obtenues</td><td class="data-table__num">@_sdV</td><td class="data-table__num">—</td><td class="data-table__num">—</td></tr> }
                                    <tr class="table-group-header"><td colspan="4">Volume de tir</td></tr>
                                    <tr class="table-sub-row"><td>Tirs total</td><td class="data-table__num">@_tSh</td><td class="data-table__num">@(_am>0?HandballKpiHelper.FormatNumber(HandballKpiHelper.PerMatch(_tSh,_am)):"—")</td><td class="data-table__num">—</td></tr>
                                    <tr class="table-sub-row"><td>Tirs dans le jeu</td><td class="data-table__num">@_oSh</td><td class="data-table__num">—</td><td class="data-table__num">—</td></tr>
                                    <tr class="table-sub-row"><td>Tirs 7 mètres</td><td class="data-table__num">@_pSh</td><td class="data-table__num">—</td><td class="data-table__num">—</td></tr>
                                    @if (_bl > 0) { <tr class="table-sub-row"><td>Tirs contrés</td><td class="data-table__num">@_bl</td><td class="data-table__num">—</td><td class="data-table__num">—</td></tr> }
                                    <tr class="table-group-header"><td colspan="4">Efficacité</td></tr>
                                    <tr class="table-sub-row @(_tRM!=null&&!_tRM.SampleReliable?"table-sub-row--warn":"")"><td>Taux total @if (_tRM!=null&&!_tRM.SampleReliable){<span class="data-insufficient">⚠</span>}</td><td class="data-table__num">@(FormatRate(_tR))%</td><td class="data-table__num" colspan="2">@(_tRM!=null?$"{_tRM.Numerator?.ToString("0")??"?"} / {_tRM.Denominator?.ToString("0")??"?"}":$"{_tG} / {_tSh}")</td></tr>
                                    <tr class="table-sub-row @(_oRQt.Tier == QualityTier.Low ? "table-sub-row--warn" : "")"><td>Jeu ouvert <MetricQualityIndicator Result="@_oRQt" /></td><td class="data-table__num">@(FormatRate(_oR))%</td><td class="data-table__num" colspan="2">@(_oRM!=null?$"{_oRM.Numerator?.ToString("0")??"?"} / {_oRM.Denominator?.ToString("0")??"?"}":$"{_oG} / {_oSh}")</td></tr>
                                    <tr class="table-sub-row @(_pRM!=null&&!_pRM.SampleReliable?"table-sub-row--warn":"")"><td>7 mètres @if (_pRM!=null&&!_pRM.SampleReliable){<span class="data-insufficient">⚠</span>}</td><td class="data-table__num">@(FormatRate(_pR))%</td><td class="data-table__num" colspan="2">@(_pRM!=null?$"{_pRM.Numerator?.ToString("0")??"?"} / {_pRM.Denominator?.ToString("0")??"?"}":$"{_pG} / {_pSh}")</td></tr>
                                    <tr class="table-sub-row @(V3RowClass(_gc60Qt))"><td>Buts créés /60 <MetricQualityIndicator Result="@_gc60Qt" /></td><td class="data-table__num">—</td><td class="data-table__num">—</td><td class="data-table__num">@FormatV3Per60(_gc60)</td></tr>
                                </tbody></table></div>
                            }

                            @if (!profile.IsGoalkeeper && PerformanceSection == "defense")
                            {
                                <div class="table-container">@{
                                    var _int  = PerfCountOf(v2Defense,"INTERCEPTIONS",Defense?.Interceptions??0);
                                    var _blk  = PerfCountOf(v2Defense,"BLOCKS",Defense?.Contres??0);
                                    var _off  = PerfCountOf(v2Defense,"OFFENSIVE_FOULS_DRAWN",Defense?.PassageForce??0);
                                    var _neu  = PerfCountOf(v2Defense,"NEUTRALIZATIONS",Defense?.Neutralisations??0);
                                    var _pc   = PerfCountOf(v2Defense,"PENALTIES_CONCEDED",Sanctions?.PenaltyConcede??0);
                                    var _sc2  = PerfCountOf(v2Defense,"SANCTIONS_CONCEDED",Sanctions!=null?Sanctions.Avertissements+Sanctions.DeuxMinutes+Sanctions.Exclusions:0);
                                    var _w2   = PerfCountOf(v2Defense,"WARNINGS_CONCEDED",Sanctions?.Avertissements??0);
                                    var _t2   = PerfCountOf(v2Defense,"TWO_MINUTE_SUSPENSIONS_CONCEDED",Sanctions?.DeuxMinutes??0);
                                    var _d2   = PerfCountOf(v2Defense,"DISQUALIFICATIONS_CONCEDED",Sanctions?.Exclusions??0);
                                    var _dm   = profile.MatchesPlayed;
                                    var _ptD      = global.PlayingTimeMinutes;
                                    var _intPer60   = AnalyticsCalculationService.NormalizeApiPer60(global.InterceptionsPer60, _ptD);
                                    var _intPer60Qt = EvaluatePer60Quality(_ptD, AnalyticsV3Catalog.Get("CAT-09")?.MinimumPlayingTimeMinutes ?? 150.0);
                                    var _defImp60   = AnalyticsCalculationService.ComputeDefensiveImpactPer60(_int, _blk, _neu, _off, _ptD);
                                    var _defImp60Qt = EvaluatePer60Quality(_ptD, AnalyticsV3Catalog.Get("CAT-10")?.MinimumPlayingTimeMinutes ?? 150.0);
                                }<table class="data-table"><thead><tr><th>Indicateur</th><th class="data-table__num">Total</th><th class="data-table__num">/Match</th></tr></thead><tbody>
                                    <tr class="table-group-header"><td colspan="3">Impact défensif</td></tr>
                                    <tr class="table-sub-row"><td>Interceptions</td><td class="data-table__num">@_int</td><td class="data-table__num">@(_dm>0?HandballKpiHelper.FormatNumber(HandballKpiHelper.PerMatch(_int,_dm)):"—")</td></tr>
                                    <tr class="table-sub-row"><td>Contres</td><td class="data-table__num">@_blk</td><td class="data-table__num">@(_dm>0?HandballKpiHelper.FormatNumber(HandballKpiHelper.PerMatch(_blk,_dm)):"—")</td></tr>
                                    <tr class="table-sub-row"><td>PF provoqués /match</td><td class="data-table__num">@_off</td><td class="data-table__num">@(_dm>0?HandballKpiHelper.FormatNumber(HandballKpiHelper.PerMatch(_off,_dm)):"—")</td></tr>
                                    <tr class="table-sub-row"><td>Neutralisations</td><td class="data-table__num">@_neu</td><td class="data-table__num">—</td></tr>
                                    <tr class="table-group-header"><td colspan="3">Métriques /60</td></tr>
                                    <tr class="table-sub-row @(V3RowClass(_intPer60Qt))"><td>Interceptions /60 <MetricQualityIndicator Result="@_intPer60Qt" /></td><td class="data-table__num">@FormatV3Per60(_intPer60)</td><td class="data-table__num">—</td></tr>
                                    <tr class="table-sub-row @(V3RowClass(_defImp60Qt))"><td>Impact défensif /60 <MetricQualityIndicator Result="@_defImp60Qt" /></td><td class="data-table__num">@FormatV3Per60(_defImp60)</td><td class="data-table__num">—</td></tr>
                                    <tr class="table-group-header"><td colspan="3">Coût défensif</td></tr>
                                    <tr class="table-sub-row @(_pc>3?"table-sub-row--warn":"")"><td>7m concédés</td><td class="data-table__num">@_pc</td><td class="data-table__num">—</td></tr>
                                    <tr class="table-sub-row @(_sc2>5?"table-sub-row--warn":"")"><td>Sanctions concédées <small>@_w2 avert. · @_t2 × 2min · @_d2 excl.</small></td><td class="data-table__num">@_sc2</td><td class="data-table__num">@(_dm>0?HandballKpiHelper.FormatNumber(HandballKpiHelper.PerMatch(_sc2,_dm)):"—")</td></tr>
                                </tbody></table></div>
                            }

                            @if (!profile.IsGoalkeeper && PerformanceSection == "mastery")
                            {
                                <div class="table-container">@{
                                    var _tTurn = PerfCountOf(v2Offense,"TOTAL_TURNOVERS",Passing?.TotalPertes??0);
                                    var _bPas  = PerfCountOf(v2Offense,"BAD_PASSES",Passing?.MauvaisePasse??0);
                                    var _pivM  = v2Offense?.FirstOrDefault(m=>m.MetricCode=="FAILED_PIVOT_PASSES");
                                    var _pivV  = _pivM?.CountValue;
                                    var _pivX  = _pivM==null||_pivM.IsUnavailable||_pivM.Availability is "DATA_MISSING" or "UNAVAILABLE_FROM_CURRENT_DATA" or "UNAVAILABLE";
                                    var _mm    = profile.MatchesPlayed;
                                    var _ptM       = global.PlayingTimeMinutes;
                                    var _atTurnCount = global.TurnoverCount > 0 ? global.TurnoverCount : _tTurn;
                                    var _atRatio   = AnalyticsCalculationService.ComputeAssistTurnoverRatio(global.AssistCount, _atTurnCount);
                                    var _atRatioQt = AnalyticsQualityPolicy.EvaluateAssistTurnoverQuality(global.AssistCount, _atTurnCount);
                                    var _tPer60    = AnalyticsCalculationService.NormalizeApiPer60(global.TurnoversPer60, _ptM);
                                    var _tPer60Qt  = EvaluatePer60Quality(_ptM, AnalyticsV3Catalog.Get("CAT-08")?.MinimumPlayingTimeMinutes ?? 150.0);
                                }<table class="data-table"><thead><tr><th>Indicateur</th><th class="data-table__num">Total</th><th class="data-table__num">/Match</th></tr></thead><tbody>
                                    <tr class="table-group-header"><td colspan="3">Conservation du ballon</td></tr>
                                    <tr class="table-sub-row @(HandballKpiHelper.PerMatch(_tTurn,_mm)>3?"table-sub-row--warn":"")"><td>Pertes de balle</td><td class="data-table__num">@_tTurn</td><td class="data-table__num">@(_mm>0?HandballKpiHelper.FormatNumber(HandballKpiHelper.PerMatch(_tTurn,_mm)):"—")</td></tr>
                                    <tr class="table-sub-row"><td>Mauvaises passes</td><td class="data-table__num">@_bPas</td><td class="data-table__num">@(_mm>0?HandballKpiHelper.FormatNumber(HandballKpiHelper.PerMatch(_bPas,_mm)):"—")</td></tr>
                                    @if (_pivX) { <tr class="table-sub-row table-sub-row--na"><td>Passes pivot ratées</td><td class="data-table__num" colspan="2">—</td></tr> }
                                    else if (_pivV.HasValue) { <tr class="table-sub-row"><td>Passes pivot ratées</td><td class="data-table__num">@_pivV.Value</td><td class="data-table__num">—</td></tr> }
                                    <tr class="table-group-header"><td colspan="3">Métriques avancées</td></tr>
                                    <tr class="table-sub-row @(V3RowClass(_atRatioQt))"><td>Ratio A:T <MetricQualityIndicator Result="@_atRatioQt" /></td><td class="data-table__num">@FormatV3Ratio(_atRatio)</td><td class="data-table__num">—</td></tr>
                                    <tr class="table-sub-row @(V3RowClass(_tPer60Qt))"><td>Pertes /60 <MetricQualityIndicator Result="@_tPer60Qt" /></td><td class="data-table__num">@FormatV3Per60(_tPer60)</td><td class="data-table__num">—</td></tr>
                                </tbody></table></div>
                            }

                            @if (PerformanceSection == "discipline")
                            {
                                <div class="table-container">@{
                                    var _dW = PerfCountOf(v2Defense,"WARNINGS_CONCEDED",Sanctions?.Avertissements??0);
                                    var _dT = PerfCountOf(v2Defense,"TWO_MINUTE_SUSPENSIONS_CONCEDED",Sanctions?.DeuxMinutes??0);
                                    var _dD = PerfCountOf(v2Defense,"DISQUALIFICATIONS_CONCEDED",Sanctions?.Exclusions??0);
                                    var _dS = _dW + _dT + _dD;
                                    var _dP = PerfCountOf(v2Defense,"PENALTIES_CONCEDED",Sanctions?.PenaltyConcede??0);
                                    var _dM = profile.MatchesPlayed;
                                    var _ptDisc     = global.PlayingTimeMinutes;
                                    var _sanctPer60   = AnalyticsCalculationService.NormalizeApiPer60(global.SanctionsPer60, _ptDisc);
                                    var _sanctPer60Qt = EvaluatePer60Quality(_ptDisc, AnalyticsV3Catalog.Get("CAT-11")?.MinimumPlayingTimeMinutes ?? 150.0);
                                }<table class="data-table"><thead><tr><th>Indicateur</th><th class="data-table__num">Total</th><th class="data-table__num">/Match</th></tr></thead><tbody>
                                    <tr class="table-group-header"><td colspan="3">Discipline</td></tr>
                                    <tr class="table-sub-row @(HandballKpiHelper.PerMatch(_dS,_dM)>0.5?"table-sub-row--warn":"")"><td>Total sanctions</td><td class="data-table__num">@_dS</td><td class="data-table__num">@(_dM>0?HandballKpiHelper.FormatNumber(HandballKpiHelper.PerMatch(_dS,_dM)):"—")</td></tr>
                                    <tr class="table-sub-row"><td>Avertissements</td><td class="data-table__num">@_dW</td><td class="data-table__num">—</td></tr>
                                    <tr class="table-sub-row"><td>2 minutes</td><td class="data-table__num">@_dT</td><td class="data-table__num">—</td></tr>
                                    <tr class="table-sub-row"><td>Exclusions</td><td class="data-table__num">@_dD</td><td class="data-table__num">—</td></tr>
                                    <tr class="table-sub-row @(_dP>3?"table-sub-row--warn":"")"><td>7m concédés</td><td class="data-table__num">@_dP</td><td class="data-table__num">—</td></tr>
                                    <tr class="table-sub-row @(V3RowClass(_sanctPer60Qt))"><td>Sanctions /60 <MetricQualityIndicator Result="@_sanctPer60Qt" /></td><td class="data-table__num">@FormatV3Per60(_sanctPer60)</td><td class="data-table__num">—</td></tr>
                                </tbody></table></div>
                            }

                            @if (profile.IsGoalkeeper && PerformanceSection == "saves")
                            {
                                <div class="table-container">@{
                                    var _tSv = PerfCountOf(v2Keeper,"TOTAL_SAVES",Goalkeeper!=null?Goalkeeper.Arrets+Goalkeeper.ArretsPenalty:0);
                                    var _oSv = PerfCountOf(v2Keeper,"OPEN_PLAY_SAVES",Goalkeeper?.Arrets??0);
                                    var _pSv = PerfCountOf(v2Keeper,"PENALTY_SAVES",Goalkeeper?.ArretsPenalty??0);
                                    var _tFa = PerfCountOf(v2Keeper,"TOTAL_SHOTS_FACED",Goalkeeper?.TirsSubis??0);
                                    var _oFa = PerfCountOf(v2Keeper,"OPEN_PLAY_SHOTS_FACED",Goalkeeper!=null?Goalkeeper.Arrets+Goalkeeper.ButsPris:0);
                                    var _pFa = PerfCountOf(v2Keeper,"PENALTY_SHOTS_FACED",Goalkeeper!=null?Goalkeeper.ArretsPenalty+Goalkeeper.ButsPenalty:0);
                                    var _gkM = profile.MatchesPlayed;
                                    var _tSRM = PerfRateOf(v2Keeper,"TOTAL_SAVE_RATE");
                                    var _oSRM = PerfRateOf(v2Keeper,"OPEN_PLAY_SAVE_RATE");
                                    var _pSRM = PerfRateOf(v2Keeper,"PENALTY_SAVE_RATE");
                                    var _tSR  = _tSRM?.Value ?? technical?.GoalkeeperSaveRate ?? 0;
                                    var _oSR  = _oSRM?.Value ?? AnalyticsCalculationService.ComputeOpenPlaySaveRate(_oSv, _oFa) ?? 0.0;
                                    var _pSR  = _pSRM?.Value ?? technical?.GoalkeeperPenaltyStopRate ?? 0;
                                    var _ptGK      = global.PlayingTimeMinutes;
                                    var _savePer60   = AnalyticsCalculationService.NormalizeApiPer60(global.SavesPer60, _ptGK);
                                    var _savePer60Qt = EvaluatePer60Quality(_ptGK, AnalyticsV3Catalog.Get("CAT-15")?.MinimumPlayingTimeMinutes ?? 150.0);
                                    var _tsFaced60   = AnalyticsCalculationService.ComputeShotsFacedPer60(goalkeeper.TirsSubis, _ptGK);
                                    var _tsFaced60Qt = EvaluatePer60Quality(_ptGK, AnalyticsV3Catalog.Get("CAT-16")?.MinimumPlayingTimeMinutes ?? 150.0);
                                    var _oSRQt = EvaluateRateQuality(_oSRM, AnalyticsV3Catalog.Get("CAT-13")?.MinimumSampleCount ?? 20);
                                    var _pSRQt = EvaluateRateQuality(_pSRM, AnalyticsV3Catalog.Get("CAT-14")?.MinimumSampleCount ?? 5);
                                    var _tSRQt       = EvaluateRateQuality(_tSRM, AnalyticsV3Catalog.Get("CAT-21")?.MinimumSampleCount ?? 20);
                                    var _goalsConceded = goalkeeper.ButsPris + goalkeeper.ButsPenalty;
                                    var _gcPer60     = AnalyticsCalculationService.ComputeGoalsConcededPer60(_goalsConceded, _ptGK);
                                    var _gcPer60Qt   = EvaluatePer60Quality(_ptGK, AnalyticsV3Catalog.Get("CAT-22")?.MinimumPlayingTimeMinutes ?? 150.0);
                                }<table class="data-table"><thead><tr><th>Indicateur</th><th class="data-table__num">Total</th><th class="data-table__num">/Match</th></tr></thead><tbody>
                                    <tr class="table-group-header"><td colspan="3">Arrêts</td></tr>
                                    <tr class="table-sub-row"><td>Arrêts total</td><td class="data-table__num">@_tSv</td><td class="data-table__num">@(_gkM>0?HandballKpiHelper.FormatNumber(HandballKpiHelper.PerMatch(_tSv,_gkM)):"—")</td></tr>
                                    <tr class="table-sub-row @(V3RowClass(_savePer60Qt))"><td>Arrêts /60 <MetricQualityIndicator Result="@_savePer60Qt" /></td><td class="data-table__num">@FormatV3Per60(_savePer60)</td><td class="data-table__num">—</td></tr>
                                    <tr class="table-sub-row"><td>Dans le jeu</td><td class="data-table__num">@_oSv</td><td class="data-table__num">—</td></tr>
                                    <tr class="table-sub-row"><td>7 mètres</td><td class="data-table__num">@_pSv</td><td class="data-table__num">—</td></tr>
                                    <tr class="table-group-header"><td colspan="3">Tirs subis</td></tr>
                                    <tr class="table-sub-row"><td>Total</td><td class="data-table__num">@_tFa</td><td class="data-table__num">—</td></tr>
                                    <tr class="table-sub-row @(V3RowClass(_tsFaced60Qt))"><td>Tirs subis /60 <MetricQualityIndicator Result="@_tsFaced60Qt" /></td><td class="data-table__num">@FormatV3Per60(_tsFaced60)</td><td class="data-table__num">—</td></tr>
                                    <tr class="table-sub-row"><td>Dans le jeu</td><td class="data-table__num">@_oFa</td><td class="data-table__num">—</td></tr>
                                    <tr class="table-sub-row"><td>7 mètres</td><td class="data-table__num">@_pFa</td><td class="data-table__num">—</td></tr>
                                    <tr class="table-sub-row"><td>Buts encaissés</td><td class="data-table__num">@((Goalkeeper?.ButsPris??0)+(Goalkeeper?.ButsPenalty??0))</td><td class="data-table__num">—</td></tr>
                                    <tr class="table-sub-row @(V3RowClass(_gcPer60Qt))"><td>Buts encaissés /60 <MetricQualityIndicator Result="@_gcPer60Qt" /></td><td class="data-table__num">@FormatV3Per60(_gcPer60)</td><td class="data-table__num">—</td></tr>
                                    <tr class="table-group-header"><td colspan="3">Taux d'arrêt</td></tr>
                                    <tr class="table-sub-row @(V3RowClass(_tSRQt))"><td>Taux d'arrêt global <MetricQualityIndicator Result="@_tSRQt" /></td><td class="data-table__num">@(FormatRate(_tSR))%</td><td class="data-table__num">@(_tSRM!=null?$"{_tSRM.Numerator?.ToString("0")??"?"} / {_tSRM.Denominator?.ToString("0")??"?"}":$"{_tSv} / {_tFa}")</td></tr>
                                    <tr class="table-sub-row @(_oSRQt.Tier == QualityTier.Low ? "table-sub-row--warn" : "")"><td>Jeu ouvert <MetricQualityIndicator Result="@_oSRQt" /></td><td class="data-table__num">@(FormatRate(_oSR))%</td><td class="data-table__num">@(_oSRM!=null?$"{_oSRM.Numerator?.ToString("0")??"?"} / {_oSRM.Denominator?.ToString("0")??"?"}":$"{_oSv} / {_oFa}")</td></tr>
                                    <tr class="table-sub-row @(_pSRQt.Tier == QualityTier.Low ? "table-sub-row--warn" : "")"><td>7 mètres <MetricQualityIndicator Result="@_pSRQt" /></td><td class="data-table__num">@(FormatRate(_pSR))%</td><td class="data-table__num">@(_pSRM!=null?$"{_pSRM.Numerator?.ToString("0")??"?"} / {_pSRM.Denominator?.ToString("0")??"?"}":$"{_pSv} / {_pFa}")</td></tr>
                                </tbody></table></div>
                            }

                            @if (profile.IsGoalkeeper && PerformanceSection == "ball")
                            {
                                <div class="table-container">@{
                                    var _gkA = PerfCountOf(v2Keeper,"GOALKEEPER_ASSISTS",Goalkeeper?.PasseDecisives??0);
                                    var _gkG = PerfCountOf(v2Keeper,"GOALKEEPER_GOALS",Goalkeeper?.Buts??0);
                                    var _gkT = PerfCountOf(v2Keeper,"GOALKEEPER_TURNOVERS",Goalkeeper?.PerteDeBalle??0);
                                    var _gkMs= PerfCountOf(v2Keeper,"GOALKEEPER_MISSED_SHOTS",Goalkeeper?.TirsLoupes??0);
                                }<table class="data-table"><thead><tr><th>Indicateur</th><th class="data-table__num">Total</th><th class="data-table__num">/Match</th></tr></thead><tbody>
                                    <tr class="table-group-header"><td colspan="3">Avec ballon</td></tr>
                                    <tr class="table-sub-row"><td>Passes décisives</td><td class="data-table__num">@_gkA</td><td class="data-table__num">—</td></tr>
                                    <tr class="table-sub-row"><td>Buts</td><td class="data-table__num">@_gkG</td><td class="data-table__num">—</td></tr>
                                    <tr class="table-sub-row @(_gkT>5?"table-sub-row--warn":"")"><td>Pertes de balle</td><td class="data-table__num">@_gkT</td><td class="data-table__num">—</td></tr>
                                    <tr class="table-sub-row"><td>Tirs manqués</td><td class="data-table__num">@_gkMs</td><td class="data-table__num">—</td></tr>
                                </tbody></table></div>
                            }
                        </div>
                    }

                    @* ÉVOLUTION *@
                    else if (ActiveSection == "graphs")
                    {
                        var _tMD = PlayerTrajectoryMetricCatalog.GetFor(profile.IsGoalkeeper);
                        var _tAD = ActiveMetricDef;
                        var _tSo = ActiveTrajectoryPoints.OrderBy(p=>p.Date).ThenBy(p=>p.MatchId).ToList();
                        var _tSR = SeasonSummary?.AggregatedValue;

                        <div class="evolution-controls">
                            <div class="form-group--inline">
                                <label class="evolution-ctrl-label">Métrique</label>
                                <select class="evolution-metric-select" value="@ActiveTrajectoryMetric" @onchange="OnTrajectoryMetricChangedAsync">
                                    @foreach (var m in _tMD) { <option value="@m.Code" selected="@(m.Code==ActiveTrajectoryMetric)">@m.Label</option> }
                                </select>
                            </div>
                            <div class="filter-chips filter-chips--sm" role="group" aria-label="Fenêtre temporelle">
                                <button type="button" class="filter-chip @(TrajectoryWindow==TrajectoryWindow.Last5?"is-active":"")"  @onclick='()=>TrajectoryWindow=TrajectoryWindow.Last5'>5 derniers</button>
                                <button type="button" class="filter-chip @(TrajectoryWindow==TrajectoryWindow.Last10?"is-active":"")" @onclick='()=>TrajectoryWindow=TrajectoryWindow.Last10'>10 derniers</button>
                                <button type="button" class="filter-chip @(TrajectoryWindow==TrajectoryWindow.Season?"is-active":"")" @onclick='()=>TrajectoryWindow=TrajectoryWindow.Season'>Saison</button>
                            </div>
                            @if (IsTrajectoryLoading) { <span class="evolution-loading">Chargement…</span> }
                        </div>

                        @if (!IsTrajectoryLoaded && !IsTrajectoryLoading) { <div class="traj-empty"><p>Aucune donnée de trajectoire disponible.</p></div> }
                        else if (_tSo.Count == 0) { <div class="traj-empty"><p>Aucun match dans cette fenêtre.</p></div> }
                        else if (_tSo.All(p => p.Availability == "DATA_MISSING")) { <div class="traj-empty"><p>Données non disponibles par match pour cette métrique.</p></div> }
                        else
                        {
                            <div class="chart-container chart-container--lg" role="region" aria-label="@($"Évolution {_tAD?.Label??""} — {_tSo.Count} matchs")">
                                <div class="chart-container__header">
                                    <span class="chart-container__title">@(_tAD?.Label??"Métrique")</span>
                                    <span class="chart-container__unit">@(_tAD?.Unit??"")</span>
                                    <span class="chart-container__scope">@_tSo.Count matchs</span>
                                </div>
                                <ApexChart TItem="PlayerTrajectoryPoint" @key="@($"{SelectedPlayerId}_{ActiveTrajectoryMetric}_{TrajectoryWindow}")" Options="@GetTrajectoryChartOptions(_tAD,_tSo,_tSR)">
                                    <ApexPointSeries TItem="PlayerTrajectoryPoint" Items="_tSo" Name="@(_tAD?.Label??"Valeur")" SeriesType="SeriesType.Line" XValue="@(p=>p.Date.ToString("dd/MM"))" YValue="@(p=>(decimal?)(p.Availability!="DATA_MISSING"?p.MetricValue:null))" />
                                    @if (_tSR.HasValue) { <ApexPointSeries TItem="PlayerTrajectoryPoint" Items="_tSo" Name="Moy. saison" SeriesType="SeriesType.Line" XValue="@(p=>p.Date.ToString("dd/MM"))" YValue="@(_=>(decimal?)_tSR.Value)" /> }
                                </ApexChart>
                            </div>

                            @if ((Last5Summary?.AggregatedValue).HasValue && (Last5Summary?.Trend??TrendState.InsufficientData)!=TrendState.InsufficientData)
                            {
                                var _tr  = Last5Summary!.Trend;
                                var _tc  = _tr==TrendState.Progressing?"trend-indicator--up":_tr==TrendState.Declining?"trend-indicator--down":"trend-indicator--stable";
                                var _ti  = _tr==TrendState.Progressing?"↗":_tr==TrendState.Declining?"↘":"→";
                                var _tl  = _tr switch{TrendState.Progressing=>"En progression",TrendState.Declining=>"En baisse",TrendState.Stable=>"Stable",_=>"Données insuffisantes"};
                                <div class="trend-indicator @_tc"><span class="trend-indicator__icon">@_ti</span><span class="trend-indicator__label">@_tl</span></div>
                            }
                            else { <div class="trend-indicator trend-indicator--stable"><span class="trend-indicator__label">Données insuffisantes pour conclure sur la tendance</span></div> }

                            <section class="traj-history" aria-label="Historique des matchs">
                                <p class="section-kicker">Historique</p>
                                <div class="table-container table-container--compact">
                                    <table class="data-table data-table--compact" role="grid">
                                        <thead><tr><th>Date</th><th>Adversaire</th><th>Résultat</th><th>Min.</th><th>@(_tAD?.Label??"Valeur")</th><th>vs saison</th></tr></thead>
                                        <tbody>
                                            @foreach (var pt in _tSo.OrderByDescending(p=>p.Date))
                                            {
                                                var _dl  = (pt.MetricValue.HasValue&&_tSR.HasValue)?pt.MetricValue.Value-_tSR.Value:(double?)null;
                                                var _pd  = _dl.HasValue&&(_tAD?.Direction==TrajectoryMetricDirection.LowerIsBetter?_dl<0:_dl>0);
                                                <tr class="@(string.IsNullOrEmpty(pt.MatchId)?"":"is-clickable")" @onclick="()=>NavigateToMatch(pt.MatchId)" role="@(string.IsNullOrEmpty(pt.MatchId)?"row":"button")" tabindex="@(string.IsNullOrEmpty(pt.MatchId)?"-1":"0")" @onkeydown="e=>HandleHistoryRowKeyDown(e,pt.MatchId)">
                                                    <td>@pt.Date.ToString("dd/MM")</td>
                                                    <td>@pt.OpponentName</td>
                                                    <td>@(pt.ResultLabel??"—")</td>
                                                    <td>@(pt.PlayingTimeStatus==PlayingTimeAvailability.DataMissing?"—":pt.MinutesPlayed?.ToString("0")??"—")</td>
                                                    <td>
                                                        @if(pt.Availability=="DATA_MISSING"||pt.MetricValue==null){<span class="data-na">—</span>}
                                                        else if(_tAD?.Type==TrajectoryMetricType.Rate&&pt.Denominator is 0){<span class="data-na">—</span>}
                                                        else{<span>@FormatTrajectoryValue(pt.MetricValue.Value,_tAD)</span>}
                                                    </td>
                                                    <td class="@(_dl.HasValue?(_pd?"delta--pos":"delta--neg"):"")">@(_dl.HasValue?FormatDelta(_dl.Value,_tAD):"—")</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </section>
                        }

                    @* ── Timeline intra-match (B6) ── *@
                    <details class="evolution-expert-details" data-testid="b6-timeline-details">
                    <summary class="evolution-expert-summary">Analyse avancée par période</summary>
                    <section class="page-panel timeline-section">
                        <div class="panel-head">
                            <div>
                                <p class="section-kicker">Timeline intra-match</p>
                                <h4>Répartition par tranches de minutes</h4>
                            </div>
                        </div>
                        <div class="evolution-controls">
                            <div class="filter-chips filter-chips--sm" role="group" aria-label="Granularité temporelle">
                                <button type="button" class="filter-chip @(TimelineBucketMinutes==5?"is-active":"")"  @onclick="@(async ()=>await OnTimelineBucketChangedAsync(5))">5 min</button>
                                <button type="button" class="filter-chip @(TimelineBucketMinutes==10?"is-active":"")" @onclick="@(async ()=>await OnTimelineBucketChangedAsync(10))">10 min</button>
                            </div>
                            <div class="form-group--inline">
                                <label class="evolution-ctrl-label">Métrique</label>
                                <select class="evolution-metric-select" @onchange="OnTimelineMetricChangedAsync">
                                    @foreach (var _tlm in GetTimelineMetrics(profile.IsGoalkeeper))
                                    {
                                        <option value="@_tlm.Code" selected="@(_tlm.Code==TimelineMetric)">@_tlm.Label</option>
                                    }
                                </select>
                            </div>
                            @if (IsTimelineLoading) { <span class="evolution-loading">Chargement…</span> }
                        </div>
                        @if (!string.IsNullOrWhiteSpace(TimelineErrorMessage))
                        {
                            <p class="data-na">Données temporelles indisponibles.</p>
                        }
                        else if (IsTimelineLoading && Timeline is null)
                        {
                            <div class="traj-empty"><p>Chargement de la timeline…</p></div>
                        }
                        else if (Timeline is null || Timeline.Buckets.Count == 0)
                        {
                            <div class="traj-empty"><p>Aucune donnée temporelle disponible.</p></div>
                        }
                        else
                        {
                            var _tlBuckets = Timeline.Buckets.OrderBy(b => b.BucketStartMinute).ToList();
                            var _tlIsRate  = TimelineMetric is "SHOT_SUCCESS_RATE" or "SAVE_RATE";
                            var _tlValues  = _tlBuckets.Select(b => GetTimelineBucketValue(b, TimelineMetric)).ToList();
                            var _tlMax     = _tlValues.Where(v => v.HasValue).Select(v => v!.Value).DefaultIfEmpty(0.0).Max();
                            if (Timeline.TemporalCoveragePct < 80.0)
                            {
                                <p class="court-sample-note">Couverture temporelle @Timeline.TemporalCoveragePct.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)% — événements horodatés limités.</p>
                            }
                            <div class="timeline-bars" role="img" aria-label="@($"Timeline {TimelineMetric} — {_tlBuckets.Count} tranches")">
                                @for (var _tli = 0; _tli < _tlBuckets.Count; _tli++)
                                {
                                    var _tlb  = _tlBuckets[_tli];
                                    var _tlv  = _tlValues[_tli];
                                    var _tlpct = (_tlMax > 0.0 && _tlv.HasValue) ? _tlv.Value / _tlMax * 100.0 : 0.0;
                                    <div class="timeline-bar-col">
                                        <div class="timeline-bar-value">
                                            @if (_tlv.HasValue)
                                            { <span>@FormatTimelineValue(_tlv.Value, _tlIsRate)</span> }
                                            else
                                            { <span class="data-na">N/A</span> }
                                        </div>
                                        <div class="timeline-bar-track">
                                            @if (_tlv.HasValue && _tlMax > 0.0)
                                            {
                                                <div class="timeline-bar-fill" style="height:@(_tlpct.ToString("F0", System.Globalization.CultureInfo.InvariantCulture))%"></div>
                                            }
                                        </div>
                                        <div class="timeline-bar-label">@_tlb.Bucket</div>
                                    </div>
                                }
                            </div>
                        }
                    </section>
                    </details>

                    }

                    @* COURT *@
                    else if (ActiveSection == "zones")
                    {
                        @if (IsSpatialLoading && Spatial is null)
                        { <StateCard Kicker="Chargement" Title="Rechargement spatial" Message="La carte but et declenchements se recalculent pour cette joueuse." Tone="loading" CssClass="empty-card-inline" /> }

                        <div class="court-tab-grid">
                            <section class="court-map-panel">
                                <div class="court-studio">
                                    <header class="court-studio__head">
                                        <h3>Zones et déclenchements</h3>
                                        @if (!(Profile?.IsGoalkeeper ?? false))
                                        {
                                            <div class="filter-chips filter-chips--sm" role="group" aria-label="Type d'attaque">
                                                <button type="button" class="filter-chip @(CourtAttackType==PlayerCourtAttackType.All?"is-active":"")"        @onclick="()=>SetCourtAttackTypeAsync(PlayerCourtAttackType.All)">Toutes</button>
                                                <button type="button" class="filter-chip @(CourtAttackType==PlayerCourtAttackType.OpenPlay?"is-active":"")"   @onclick="()=>SetCourtAttackTypeAsync(PlayerCourtAttackType.OpenPlay)">Jeu ouvert</button>
                                                <button type="button" class="filter-chip @(CourtAttackType==PlayerCourtAttackType.SevenMeter?"is-active":"")" @onclick="()=>SetCourtAttackTypeAsync(PlayerCourtAttackType.SevenMeter)">7 mètres</button>
                                            </div>
                                        }
                                        <div class="filter-chips filter-chips--sm" role="group" aria-label="Lecture">
                                            <button type="button" class="filter-chip @(CourtDisplayMode==PlayerCourtDisplayMode.Volume?"is-active":"")"     @onclick="()=>CourtDisplayMode=PlayerCourtDisplayMode.Volume">Volume</button>
                                            <button type="button" class="filter-chip @(CourtDisplayMode==PlayerCourtDisplayMode.Efficiency?"is-active":"")" @onclick="()=>CourtDisplayMode=PlayerCourtDisplayMode.Efficiency">Efficacité</button>
                                        </div>
                                    </header>

                                    <section class="court-stage">
                                        <header class="court-stage__head">
                                            <span>Goal frame</span>
                                            <h4>@((Profile?.IsGoalkeeper ?? false) ? "Zones d'arrêt" : "Précision par secteur")</h4>
                                        </header>
                                        <GoalKpi GoalZones="@CourtShotZones" TriggerZones="@CourtTriggerZones" IsGoalkeeper="@(Profile?.IsGoalkeeper??false)"
                                                 ActiveZoneKey="@ActiveZoneKey" OnZoneSelected="HandleZoneSelectionAsync" HideZeroZones="@HasSpatialFocus"
                                                 IsLoading="@IsSpatialLoading" DisplayMode="@CourtDisplayMode" DisplayModeChanged="@(mode=>CourtDisplayMode=mode)"
                                                 AttackType="@CourtAttackType" ViewMode="goal" HideModeBar="true" />
                                    </section>

                                    <section class="court-stage">
                                        <header class="court-stage__head">
                                            <span>Court map</span>
                                            <h4>@((Profile?.IsGoalkeeper ?? false) ? "Zones de déclenchement adverses" : "Déclenchements et angles")</h4>
                                        </header>
                                        <GoalKpi GoalZones="@CourtShotZones" TriggerZones="@CourtTriggerZones" IsGoalkeeper="false"
                                                 ActiveZoneKey="@ActiveZoneKey" OnZoneSelected="HandleZoneSelectionAsync" HideZeroZones="@HasSpatialFocus"
                                                 IsLoading="@IsSpatialLoading" DisplayMode="@CourtDisplayMode" DisplayModeChanged="@(mode=>CourtDisplayMode=mode)"
                                                 AttackType="@CourtAttackType" ViewMode="trigger" HideModeBar="true" />
                                    </section>
                                </div>

                                <details class="court-table-alt">
                                    <summary>Vue tabulaire des zones</summary>
                                    <table class="court-alt-table" role="grid">
                                        <thead><tr><th>Zone</th><th>Tirs</th><th>Buts</th><th>Taux</th><th>Fiabilité</th></tr></thead>
                                        <tbody>
                                            @foreach (var zone in ActiveCourtZones.Where(z=>z.Attempts>0).OrderByDescending(z=>z.Attempts))
                                            { <tr><td>@zone.Label</td><td>@zone.Attempts</td><td>@zone.Successes</td><td>@FormatRate(zone.Rate)%</td><td>@(zone.SampleReliable?"Fiable":"Faible")</td></tr> }
                                        </tbody>
                                    </table>
                                </details>
                            </section>

                            <section class="court-zone-panel">
                                @if (ActiveCourtZone is not null)
                                {
                                    var _zoneTotals = SpatialAnalyticsBuilder.AggregateZoneTotals(ActiveCourtZones);
                                    var _attemptShare = SpatialAnalyticsBuilder.ComputeAttemptShare(ActiveCourtZone.Attempts, _zoneTotals.TotalAttempts);
                                    var _goalShare = SpatialAnalyticsBuilder.ComputeGoalShare(ActiveCourtZone.Successes, _zoneTotals.TotalGoals);
                                    var _zoneQuality = AnalyticsQualityPolicy.EvaluateTier(null, ActiveCourtZone.Attempts, SpatialAnalyticsBuilder.MinShotZoneSample);
                                    <div class="panel-head">
                                        <div>
                                            <p class="section-kicker">Zone active</p>
                                            <h4>@ActiveCourtZone.Label</h4>
                                        </div>
                                        <span class="hero-badge">@FormatRate(ActiveCourtZone.Rate)%</span>
                                    </div>
                                    <div class="badge-row">
                                        <div class="mini-card"><span>Volume</span><strong>@ActiveCourtZone.Attempts</strong></div>
                                        <div class="mini-card"><span>Succès</span><strong>@ActiveCourtZone.Successes</strong></div>
                                        <div class="mini-card"><span>Échecs</span><strong>@ActiveCourtZone.Failures</strong></div>
                                    </div>
                                    @if (_attemptShare.HasValue || _goalShare.HasValue)
                                    {
                                        <p class="section-label-expert" style="font-size:0.6875rem;text-transform:uppercase;letter-spacing:.06em;color:var(--text-muted);margin-bottom:0.25rem;">Analyse avancée</p>
                                        <div class="badge-row">
                                            @if (_attemptShare.HasValue) { <div class="mini-card"><span>Part des tirs</span><strong>@FormatRate(_attemptShare.Value)%</strong></div> }
                                            @if (_goalShare.HasValue) { <div class="mini-card"><span>Part des buts</span><strong>@FormatRate(_goalShare.Value)%</strong></div> }
                                        </div>
                                    }
                                    @if (ActiveCourtZone.Outcomes.Any())
                                    {
                                        <div class="list-stack">
                                            @foreach (var outcome in ActiveCourtZone.Outcomes)
                                            {
                                                <div class="list-item">
                                                    <div class="key-metric">
                                                        <strong>@outcome.Label</strong>
                                                        <span>@outcome.Count</span>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    }
                                    @if (_zoneQuality.Tier == QualityTier.Low && ActiveCourtZone.Attempts > 0)
                                    { <p class="court-sample-note">Volume limite (@ActiveCourtZone.Attempts tirs) — taux indicatif.</p> }
                                }
                                else
                                {
                                    <div class="court-zone-empty">
                                        <p>Sélectionnez une zone pour voir le détail</p>
                                    </div>
                                }
                            </section>
                        </div>

                        <details class="court-table-alt">
                            <summary>Vue tabulaire des zones</summary>
                            <table class="court-alt-table" role="grid"><caption>@(CourtScene==PlayerCourtScene.ShotZones?"Zones de tir":"Zones de declenchement")</caption>
                                <thead><tr><th>Zone</th><th>Tirs</th><th>Buts</th><th>Taux</th><th>Fiabilite</th></tr></thead>
                                <tbody>
                                    @foreach (var zone in ActiveCourtZones.Where(z=>z.Attempts>0).OrderByDescending(z=>z.Attempts))
                                    { <tr><td>@zone.Label</td><td>@zone.Attempts</td><td>@zone.Successes</td><td>@FormatRate(zone.Rate)%</td><td>@(zone.SampleReliable?"Fiable":"Faible")</td></tr> }
                                </tbody>
                            </table>
                        </details>

                        @if (HasSpatialFocus)
                        {
                            <div class="match-scope-toolbar spatial-focus-toolbar">
                                <div class="match-scope-copy"><p class="section-kicker">Lecture ciblee</p><span>Zones liees a @SpatialFocusKey</span></div>
                                <button type="button" class="match-scope-button" @onclick="ResetSpatialFocusAsync" disabled="@IsSpatialLoading">Voir toutes les zones</button>
                            </div>
                        }
                    }

                    @* MATCHS *@
                    else if (ActiveSection == "matches")
                    {
                        var isGk     = profile.IsGoalkeeper;
                        var rows     = FilteredGameRows;
                        var baseline = GameBaseline;
                        var total    = rows.Count;
                        var eligT    = rows.Count(r=>r.PlayingTime.Availability!=PlayingTimeAvailability.DataMissing&&r.PlayingTime.Availability!=PlayingTimeAvailability.IdentityConflict&&r.PlayingTime.Minutes.HasValue);
                        var avgT     = eligT>0?rows.Where(r=>r.PlayingTime.Minutes.HasValue).Average(r=>r.PlayingTime.Minutes!.Value):(double?)null;

                        <div class="match-log-controls">
                            <div class="match-log-search">
                                <input type="search" placeholder="Adversaire, compétition…" value="@GamesSearch" @oninput="e=>GamesSearch=e.Value?.ToString()??string.Empty" aria-label="Rechercher un match" />
                            </div>
                            <div class="filter-chips filter-chips--sm" role="group" aria-label="Période">
                                <button type="button" class="filter-chip @(GamesWindow==PlayerGamesWindow.Last5?"is-active":"")"  @onclick='()=>GamesWindow=PlayerGamesWindow.Last5'>5 derniers</button>
                                <button type="button" class="filter-chip @(GamesWindow==PlayerGamesWindow.Last10?"is-active":"")" @onclick='()=>GamesWindow=PlayerGamesWindow.Last10'>10 derniers</button>
                                <button type="button" class="filter-chip @(GamesWindow==PlayerGamesWindow.Season?"is-active":"")" @onclick='()=>GamesWindow=PlayerGamesWindow.Season'>Saison</button>
                            </div>
                            <div class="filter-chips filter-chips--sm" role="group" aria-label="Résultat">
                                <button type="button" class="filter-chip @(GamesResultFilter==PlayerGamesResultFilter.All?"is-active":"")"  @onclick='()=>GamesResultFilter=PlayerGamesResultFilter.All'>Tous</button>
                                <button type="button" class="filter-chip @(GamesResultFilter==PlayerGamesResultFilter.Win?"is-active":"")"  @onclick='()=>GamesResultFilter=PlayerGamesResultFilter.Win'>V</button>
                                <button type="button" class="filter-chip @(GamesResultFilter==PlayerGamesResultFilter.Draw?"is-active":"")" @onclick='()=>GamesResultFilter=PlayerGamesResultFilter.Draw'>N</button>
                                <button type="button" class="filter-chip @(GamesResultFilter==PlayerGamesResultFilter.Loss?"is-active":"")" @onclick='()=>GamesResultFilter=PlayerGamesResultFilter.Loss'>D</button>
                            </div>
                            <div class="filter-chips filter-chips--sm" role="group" aria-label="Mode">
                                <button type="button" class="filter-chip @(GamesDisplayMode==PlayerGamesDisplayMode.Values?"is-active":"")"        @onclick='()=>GamesDisplayMode=PlayerGamesDisplayMode.Values'>Valeurs</button>
                                <button type="button" class="filter-chip @(GamesDisplayMode==PlayerGamesDisplayMode.DeltaVsSeason?"is-active":"")" @onclick='()=>GamesDisplayMode=PlayerGamesDisplayMode.DeltaVsSeason'>Écart saison</button>
                            </div>
                        </div>

                        @if (total>0)
                        {
                            <div class="games-summary-bar">
                                <span>@total match@(total>1?"s":"")</span>
                                @if (avgT.HasValue) { <span>@avgT.Value.ToString("0.0") min / match</span> }
                                @if (eligT<total) { <span class="games-summary-warn">Temps disponible @eligT / @total</span> }
                            </div>
                        }

                        @if (total==0)
                        {
                            <div class="games-empty">
                                @if (!string.IsNullOrWhiteSpace(GamesSearch)||GamesResultFilter!=PlayerGamesResultFilter.All) { <p>Aucun match ne correspond aux filtres.</p> }
                                else { <p>Aucun match disponible pour cette joueuse.</p> }
                            </div>
                        }
                        else
                        {
                            <div class="table-container">
                                <table class="data-table data-table--match-log" aria-label="Historique des matchs">
                                    <caption class="sr-only">Matchs de @profile.FullName — @total résultats</caption>
                                    <thead>
                                        <tr>
                                            <th scope="col"><button type="button" class="games-sort-btn" @onclick='()=>GamesSort=GamesSort=="date_desc"?"date_asc":"date_desc"' aria-sort="@(GamesSort.StartsWith("date")?(GamesSort=="date_desc"?"descending":"ascending"):"none")">Date</button></th>
                                            <th scope="col">Adversaire</th>
                                            <th scope="col">Résultat</th>
                                            <th scope="col"><button type="button" class="games-sort-btn" @onclick='()=>GamesSort="time_desc"' aria-sort="@(GamesSort=="time_desc"?"descending":"none")">Min.</button></th>
                                            @if (!isGk) { <th>Buts</th><th>Passes</th><th>Interc.</th><th>Taux tir</th> }
                                            else        { <th>Arrêts</th><th>Passes</th><th>Taux arrêt</th> }
                                            <th scope="col"><span class="sr-only">Détail</span></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var row in rows)
                                        {
                                            var isSel   = row.Identity.MatchId==GamesSelectedMatchId;
                                            var rbCl    = row.Identity.Result switch{PlayerMatchResult.Win=>"result-badge--v",PlayerMatchResult.Draw=>"result-badge--n",PlayerMatchResult.Loss=>"result-badge--d",_=>""};
                                            var colspan = isGk ? 8 : 9;
                                            <tr class="games-row @(isSel?"games-row--selected":"")" @onclick='()=>GamesSelectedMatchId=isSel?null:row.Identity.MatchId'
                                                role="button" tabindex="0" aria-expanded="@isSel.ToString().ToLowerInvariant()"
                                                @onkeydown='e=>{if(e.Key=="Enter"||e.Key==" ")GamesSelectedMatchId=isSel?null:row.Identity.MatchId;}'>
                                                <td>@row.Identity.Date.ToString("dd/MM")</td>
                                                <td>@(row.Identity.OpponentName.Length>0?row.Identity.OpponentName:"—")</td>
                                                <td>
                                                    <span class="result-badge @rbCl" title="@PlayerMatchResultResolver.GetResultAccessibleLabel(row.Identity.Result)">@PlayerMatchResultResolver.GetResultLabel(row.Identity.Result)</span>
                                                    @if (row.Identity.Team1Score.HasValue&&row.Identity.Team2Score.HasValue) { <span class="games-match-score">@PlayerMatchResultResolver.FormatScore(row.Identity.PlayerTeamId,null,row.Identity.Team1Score,row.Identity.Team2Score)</span> }
                                                </td>
                                                <td>
                                                    @if(row.PlayingTime.Availability==PlayingTimeAvailability.DataMissing||row.PlayingTime.Availability==PlayingTimeAvailability.IdentityConflict){<span class="games-na">—</span>}
                                                    else if(row.PlayingTime.Minutes.HasValue){@row.PlayingTime.Minutes.Value.ToString("0") @if(row.PlayingTime.Availability==PlayingTimeAvailability.PartialData){<span class="games-partial" title="Temps partiel">~</span>}}
                                                    else{<span class="games-na">—</span>}
                                                </td>
                                                @if (!isGk)
                                                {
                                                    <td class="@GetMatchCellClass(row.FieldMetrics?.Goals,        baseline?.GoalsPerMatch,        TrajectoryMetricDirection.HigherIsBetter)">@RenderCountCell(row.FieldMetrics?.Goals,        baseline?.GoalsPerMatch,        TrajectoryMetricDirection.HigherIsBetter)</td>
                                                    <td class="@GetMatchCellClass(row.FieldMetrics?.Assists,      baseline?.AssistsPerMatch,      TrajectoryMetricDirection.HigherIsBetter)">@RenderCountCell(row.FieldMetrics?.Assists,      baseline?.AssistsPerMatch,      TrajectoryMetricDirection.HigherIsBetter)</td>
                                                    <td class="@GetMatchCellClass(row.FieldMetrics?.Interceptions,baseline?.InterceptionsPerMatch,TrajectoryMetricDirection.HigherIsBetter)">@RenderCountCell(row.FieldMetrics?.Interceptions,baseline?.InterceptionsPerMatch,TrajectoryMetricDirection.HigherIsBetter)</td>
                                                    <td><span class="games-na">—</span></td>
                                                }
                                                else
                                                {
                                                    <td class="@GetMatchCellClass(row.GkMetrics?.Saves,   baseline?.SavesPerMatch,  TrajectoryMetricDirection.HigherIsBetter)">@RenderCountCell(row.GkMetrics?.Saves,   baseline?.SavesPerMatch,  TrajectoryMetricDirection.HigherIsBetter)</td>
                                                    <td class="@GetMatchCellClass(row.GkMetrics?.Assists, baseline?.AssistsPerMatch,TrajectoryMetricDirection.HigherIsBetter)">@RenderCountCell(row.GkMetrics?.Assists, baseline?.AssistsPerMatch,TrajectoryMetricDirection.HigherIsBetter)</td>
                                                    <td><span class="games-na">—</span></td>
                                                }
                                                <td><span class="games-expand-icon" aria-hidden="true">@(isSel?"▲":"▼")</span></td>
                                            </tr>
                                            @if (isSel)
                                            {
                                                <tr class="games-detail-row" role="region" aria-label="Détail du match">
                                                    <td colspan="@colspan" class="games-detail-cell">
                                                        <div class="games-detail">
                                                            <div class="games-detail-header">
                                                                <div>
                                                                    <p class="games-detail-title">@row.Identity.PlayerTeamName vs @(row.Identity.OpponentName.Length>0?row.Identity.OpponentName:"—")</p>
                                                                    <p class="games-detail-meta">@row.Identity.Date.ToString("dd MMM yyyy",System.Globalization.CultureInfo.GetCultureInfo("fr-FR")) · J@row.Identity.Day · @row.Identity.CompetitionName</p>
                                                                </div>
                                                                <a href="/matches?matchId=@row.Identity.MatchId" class="games-open-match-btn">Ouvrir le match</a>
                                                            </div>
