        => list?.FirstOrDefault(m => m.MetricCode == code)?.IsUnavailable ?? true;

    // ── Analytics V3 helpers ──────────────────────────────────────────────────

    private static LeagueMetricQualityDto? ToMetricQualityDto(RateDisplayModel? rate)
        => rate is { QualityKnown: true }
            ? new LeagueMetricQualityDto { SampleReliable = rate.SampleReliable, QualityScore = rate.QualityScore ?? 0.0, Reason = rate.QualityReason }
            : null;

    private static QualityTierResult EvaluateRateQuality(RateDisplayModel? rate, int minSample)
        => AnalyticsQualityPolicy.EvaluateTier(ToMetricQualityDto(rate), null, minSample);

    private static QualityTierResult EvaluatePer60Quality(double playingTimeMinutes, double minPlayingTimeMinutes)
        => AnalyticsQualityPolicy.EvaluatePlayingTimeTier(playingTimeMinutes, minPlayingTimeMinutes);

    private static string FormatV3Per60(double? value)
        => value.HasValue ? value.Value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) : "—";

    private static string FormatV3Ratio(double? value)
        => value.HasValue ? value.Value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) : "—";

    private static string V3RowClass(QualityTierResult qt)
        => qt.Tier == QualityTier.Low ? "table-sub-row--warn" : qt.Tier == QualityTier.NotApplicable ? "table-sub-row--na" : "";

    private bool IsMetricApplicable(string metricCode, string? positionCode)
    {
        var def = AnalyticsV3Catalog.Get(metricCode);
        return def is not null && AnalyticsV3Catalog.IsApplicable(def, positionCode);
    }
