    {
        System.Threading.Interlocked.Increment(ref SpatialLoadToken);
        IsSpatialLoading = false;

        if (!SelectedPlayerId.HasValue)
        {
            Profile = null;
            Global = null;
            Offense = null;
            Defense = null;
            Passing = null;
            Sanctions = null;
            Goalkeeper = null;
            Technical = null;
            LeagueAnalytics = null;
            Spatial = null;
            ActiveZoneKey = null;
            SpatialFocusKey = null;
            IsSpatialLoading = false;
            PlayerMatches = [];
            IsCourtLoaded = false;
            CourtAttackType = PlayerCourtAttackType.All;
            CourtDisplayMode = PlayerCourtDisplayMode.Volume;
            CourtScene = PlayerCourtScene.ShotZones;
            PerformanceSection = "attack";
            IsTrajectoryLoaded = false;
            TrajectoryPoints = Array.Empty<PlayerTrajectoryPoint>();
            ActiveTrajectoryMetric = "SHOT_SUCCESS_RATE";
            TrajectoryWindow = TrajectoryWindow.Last10;
            GamesWindow = PlayerGamesWindow.Season;
            GamesResultFilter = PlayerGamesResultFilter.All;
            GamesDisplayMode = PlayerGamesDisplayMode.Values;
            GamesSearch = "";
            GamesSelectedMatchId = null;
            GamesSort = "date_desc";
            AllGameRows = Array.Empty<PlayerGameAnalysisRow>();
            GameBaseline = null;
            return;
        }

        var loadStartedAt = DateTimeOffset.UtcNow;

        try
        {
            if (manageBusyState)
            {
                await BusyUiHelper.EnterAsync(() => IsBusy = true, () => InvokeAsync(StateHasChanged));
            }
            ErrorMessage = null;

            var options = BuildOptions();

            var profileTask = PlayersApiClient.GetPlayerProfileAsync(SelectedPlayerId.Value, options);
            var globalTask = StatsApiClient.GetPlayerGlobalAsync(SelectedPlayerId.Value, options);
            var offenseTask = StatsApiClient.GetPlayerOffenseAsync(SelectedPlayerId.Value, options);
            var defenseTask = StatsApiClient.GetPlayerDefenseAsync(SelectedPlayerId.Value, options);
            var passingTask = StatsApiClient.GetPlayerPassingAsync(SelectedPlayerId.Value, options);
            var sanctionsTask = StatsApiClient.GetPlayerSanctionsAsync(SelectedPlayerId.Value, options);
            var goalkeeperTask = StatsApiClient.GetPlayerGoalkeeperAsync(SelectedPlayerId.Value, options);
            var technicalTask = StatsApiClient.GetPlayerTechnicalAsync(SelectedPlayerId.Value, options);
            var leagueV2Task = LeagueAnalyticsService.LoadV2Async(SelectedPlayerId.Value, options);
            var matchesTask = PlayersApiClient.GetPlayerMatchesAsync(SelectedPlayerId.Value, options);

            await Task.WhenAll(profileTask, globalTask, offenseTask, defenseTask, passingTask, sanctionsTask, goalkeeperTask, technicalTask, matchesTask, leagueV2Task);

            Profile = profileTask.Result;
            Global = globalTask.Result;
            Offense = offenseTask.Result;
            Defense = defenseTask.Result;
            Passing = passingTask.Result;
            Sanctions = sanctionsTask.Result;
            Goalkeeper = goalkeeperTask.Result;
            Technical = technicalTask.Result;
            // Spatial is lazy-loaded — only fetched when the "zones" tab is activated
            Spatial = null;
            PlayerMatches = matchesTask.Result;
            LeagueAnalytics = LeagueAnalyticsService.Resolve(
                SelectedPlayerId.Value,
                leagueV2Task.Result,
                new LeagueV1Snapshot(
                    Global!,
                    Offense!,
                    Defense!,
                    Passing!,
                    Sanctions!,
                    Goalkeeper!,
                    Technical!,
                    Profile?.IsGoalkeeper == true),
                BuildLeagueScope());
            SpatialFocusKey = null;
            IsCourtLoaded = false;
            CourtAttackType = PlayerCourtAttackType.All;
            CourtDisplayMode = PlayerCourtDisplayMode.Volume;
            CourtScene = PlayerCourtScene.ShotZones;
            ActiveZoneKey = null;
            PerformanceSection = Profile?.IsGoalkeeper == true ? "saves" : "attack";
            IsTrajectoryLoaded = false;
            TrajectoryPoints = Array.Empty<PlayerTrajectoryPoint>();
            ActiveTrajectoryMetric = Profile?.IsGoalkeeper == true ? "SAVE_RATE" : "SHOT_SUCCESS_RATE";
            TrajectoryWindow = TrajectoryWindow.Last10;

            // Games V2 — build rows from already-loaded PlayerMatches
            var isGkForGames = Profile?.IsGoalkeeper ?? false;
            var playerTeamIdStr = Profile?.TeamId?.ToString();
            AllGameRows = PlayerMatches
                .Select(m => PlayerGameRowBuilder.Build(m, playerTeamIdStr, isGkForGames))
                .ToList();
            GameBaseline = AllGameRows.Count > 0
                ? GameSeasonBaselineCalculator.Build(AllGameRows, isGkForGames)
                : null;
            GamesWindow = PlayerGamesWindow.Season;
            GamesResultFilter = PlayerGamesResultFilter.All;
            GamesDisplayMode = PlayerGamesDisplayMode.Values;
            GamesSearch = "";
            GamesSelectedMatchId = null;
            GamesSort = "date_desc";
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
        finally
        {
            if (manageBusyState)
            {
                await BusyUiHelper.ExitAsync(() => IsBusy = false, () => InvokeAsync(StateHasChanged), loadStartedAt);
            }
        }
    }

