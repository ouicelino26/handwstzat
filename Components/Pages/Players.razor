    private static string GetMatchCellClass(int? value, double? baseline, TrajectoryMetricDirection direction)
    {
        if (value == null || !baseline.HasValue || baseline.Value <= 0) return string.Empty;
        var delta = value.Value - baseline.Value;
        var isGood = direction == TrajectoryMetricDirection.LowerIsBetter ? delta < -0.1 : delta > 0.1;
        var isBad  = direction == TrajectoryMetricDirection.LowerIsBetter ? delta >  0.1 : delta < -0.1;
        return isGood ? "heat-tone-bon" : isBad ? "heat-tone-faible" : string.Empty;
    }

