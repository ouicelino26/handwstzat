@page "/players"
@using System.Globalization
@using System.Text
@inject ReferenceDataService ReferenceDataService
@inject PlayersApiClient PlayersApiClient
@inject MatchesApiClient MatchesApiClient
@inject StatsApiClient StatsApiClient
@inject LeaguePlayerAnalyticsService LeagueAnalyticsService
@inject IApiAuthService AuthService
@inject IJSRuntime JS
@inject AnalysisScopeService ScopeService
@implements IDisposable

<PageTitle>Athletes</PageTitle>

<div class="athlete-workspace" data-workspace="athletes">
    @if (!AuthService.Session.IsAuthenticated)
    {
        <AccessRequiredCard Message="Connectez-vous pour ouvrir les fiches joueuses, les zones et les feuilles de match." />
    }
    else
    {
        <details class="directory-command @(IsBusy ? "is-loading" : string.Empty)" open="@IsDirectoryDrawerOpen">
            <summary @onclick="ToggleDirectoryDrawer">

                <div class="drawer-copy">
                    <strong>Athlete index</strong>
                    <span>Recherche instantanee et scope local</span>
                </div>

                <div class="toolbar drawer-actions">
                    <button type="button"
                            class="ghost-button filter-ghost"
                            @onclick="ResetFiltersAsync"
                            @onclick:preventDefault="true"
                            @onclick:stopPropagation="true"
                            disabled="@IsBusy">Réinitialiser</button>
                </div>
            </summary>

            <div class="filter-drawer-body">
                <div class="page-filters">
                        <label class="filter-field player-search">
                            <span>Recherche</span>
                            <input value="@Search" @oninput="OnSearchChangedAsync" placeholder="Nom ou prenom" />
                        </label>

                        <label class="filter-field">
                            <span>Competition</span>
                            <select @bind="CompetitionId" @bind:after="OnDirectoryScopeChangedAsync">
                                <option value="">Toutes</option>
                                @foreach (var competition in AvailableCompetitions)
                                {
                                    <option value="@competition.CompetitionId">@competition.CompetitionName</option>
                                }
                            </select>
                        </label>

                        <label class="filter-field">
                            <span>Equipe</span>
                            <select @bind="TeamId" @bind:after="OnDirectoryScopeChangedAsync">
                                <option value="">Toutes</option>
                                @foreach (var team in AvailableTeams)
                                {
                                    <option value="@team.TeamId">@team.TeamName</option>
                                }
                            </select>
                        </label>

                        <label class="filter-field">
                            <span>Poste</span>
                            <select @bind="PositionId" @bind:after="OnDirectoryScopeChangedAsync">
                                <option value="">Tous</option>
                                @foreach (var position in AvailablePositions)
                                {
                                    <option value="@position.Id">@position.Name</option>
                                }
                            </select>
                        </label>

                        <label class="filter-field">
                            <span>Saison</span>
                            <select @bind="Season" @bind:after="OnDirectoryScopeChangedAsync">
                                <option value="">Toutes</option>
                                @foreach (var season in SeasonOptions)
                                {
                                    <option value="@season">@season</option>
                                }
                            </select>
                        </label>

                        <label class="filter-field">
                            <span>Journee</span>
                            <select @bind="Day" @bind:after="OnDirectoryScopeChangedAsync">
                                <option value="">Toutes</option>
                                @foreach (var day in DayOptions)
                                {
                                    <option value="@day">@day</option>
                                }
                            </select>
                        </label>
                    </div>
                </div>
        </details>

        @if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <StateCard Kicker="Erreur"
                       Title="Impossible de charger le répertoire"
                       Message="@ErrorMessage"
                       Tone="error" />
        }
        else if (IsBusy && PlayerDirectory.Count == 0)
        {
            <StateCard Kicker="Chargement"
                       Title="Chargement du répertoire joueuses"
                       Message="Préparation des filtres, de la liste et de la fiche détaillée."
                       Tone="loading" />
        }
        else if (!HasDirectoryCriteria)
        {
            <StateCard Kicker="Filtre requis"
                       Title="Sélectionnez un filtre pour charger les joueuses"
                       Message="Choisissez au moins une compétition, une équipe, un poste ou saisissez une recherche."
                       Tone="empty" />
        }
        else
        {
            @if (IsBusy)
            {
                <PageLoader Kicker="Chargement"
                            Title="Actualisation du repertoire"
                            Message="La liste et la fiche de la joueuse se recalculent." />
            }

            <section class="entity-workspace">
                <PlayerList Kicker="Athlete index"
                            Subtitle="Ouvrez un workspace individuel"
                            Players="@PlayerDirectory"
                            SelectedPlayerId="@SelectedPlayerId"
                            Scrollable="@UseScrollableDirectory"
                            IsPlayerListOpen="@IsPlayerListOpen"
                            IsPlayerListOpenChanged="@(value => IsPlayerListOpen = value)"
                            EmptyKicker="Aucune joueuse"
                            EmptyTitle="Le filtre courant ne retourne aucune fiche"
                            EmptyMessage="Essayez un contexte plus large ou retirez un filtre trop restrictif."
                            OnSelectedPlayerChanged="SelectPlayerAsync" />

                <article class="entity-stage">
                    @if (Profile is null || Global is null || Offense is null || Defense is null || Passing is null || Sanctions is null || Goalkeeper is null)
                    {
                        <StateCard Kicker="Aucune fiche"
                                   Title="Choisissez une joueuse pour afficher la synthèse"
                                   Message="La vue détaillée, les zones et les matchs s’ouvrent après sélection."
                                   Tone="empty"
                                   CssClass="empty-card-inline" />
                    }
                    else
                    {
                        var profile = Profile!;
                        var global = Global!;
                        var offense = Offense!;
                        var defense = Defense!;
                        var passing = Passing!;
                        var sanctions = Sanctions!;
                        var goalkeeper = Goalkeeper!;
                        PlayerTechnicalStatsDto? technical = Technical!;
                        var playerPhotoUrl = ResolvePlayerPhotoUrl(profile.PlayerPhoto, profile.PlayerId, profile.FullName, profile.TeamName);
                        var playerFlagUrl = ResolveFlagAssetUrl(profile.Nationality);

                        <header class="entity-identity entity-identity--athlete">
                            <div class="player-identity-photo @(playerPhotoUrl is null ? "is-placeholder" : string.Empty)">
                                @if (!string.IsNullOrWhiteSpace(playerPhotoUrl))
                                {
                                    <img src="@playerPhotoUrl" alt="@($"Portrait de {profile.FullName}")" loading="lazy" />
                                }
                                else
                                {
                                    <span>@GetInitials(profile.FullName)</span>
                                }
                            </div>
                            <div class="entity-identity__number">@(profile.Number?.ToString("00") ?? "—")</div>
                            <div class="entity-identity__copy">
                                <h2 data-page-title>@profile.FullName</h2>
                                <p class="page-subtitle athlete-meta-line">
                                    <span>@(profile.TeamName ?? "Equipe non renseignee") · @(profile.PositionName ?? "Poste non renseigne")</span>
                                    @if (!string.IsNullOrWhiteSpace(profile.Nationality))
                                    {
                                        <span class="nationality-chip">
                                            @if (!string.IsNullOrWhiteSpace(playerFlagUrl))
                                            {
                                                <img src="@playerFlagUrl" alt="" loading="lazy" />
                                            }
                                            <span>@profile.Nationality</span>
                                        </span>
                                    }
                                </p>
                            </div>

                            <div class="entity-identity__actions">
                                <a class="ghost-button" href="@($"/position-profiles?playerId={profile.PlayerId}")">Role benchmark</a>
                                <button type="button"
                                        class="primary-button"
                                        @onclick="ExportPlayerSheetAsync"
                                        disabled="@(!CanExportPlayerSheet || IsBusy || IsPlayerSheetExportBusy)">Exporter</button>
                            </div>
                        </header>

                        <div class="scene-switcher" role="tablist" aria-label="Scenes de la joueuse">
                            <button type="button" class="tab-button @(ActiveSection == "overview" ? "is-active" : string.Empty)" @onclick='() => SetActiveSection("overview")'>Brief</button>
                            <button type="button" class="tab-button @(ActiveSection == "analysis" ? "is-active" : string.Empty)" @onclick='() => SetActiveSection("analysis")'>Performance</button>
                            <button type="button" class="tab-button @(ActiveSection == "graphs" ? "is-active" : string.Empty)" @onclick='() => SetActiveSection("graphs")'>Trajectory</button>
                            <button type="button" class="tab-button @(ActiveSection == "zones" ? "is-active" : string.Empty)" @onclick='() => SetActiveSection("zones")'>Court</button>
                            <button type="button" class="tab-button @(ActiveSection == "matches" ? "is-active" : string.Empty)" @onclick='() => SetActiveSection("matches")'>Games</button>
                        </div>

                        @if (ActiveSection == "overview")
                        {
                            <div class="player-stat-board">

                                @* ── Bloc global ── *@
                                <section class="player-stat-block player-stat-block--global">
                                    <header class="player-stat-block__head">
                                        <div>
                                            <p class="section-kicker">Stat global</p>
                                            <h4>Lecture synthese</h4>
                                        </div>
                                        <span class="stat-block-pill">@profile.MatchesPlayed matchs</span>
                                    </header>

                                    <div class="stats-grid player-stat-grid">
                                        <div class="mini-card"><span>Matchs</span><strong>@profile.MatchesPlayed</strong></div>
                                        <div class="mini-card"><span>Temps / match</span><strong>@(profile.MatchesWithPlayingTime > 0 ? $"{FormatRate(profile.AveragePlayingTimePerMatchMinutes)} min" : "Non disponible")</strong></div>
                                        <div class="mini-card"><span>Actions directes</span><strong>@DirectActionsCount()</strong></div>
                                        <div class="mini-card"><span>Indice global</span><strong>@FormatRate(PlayerTechnicalBalanceScore)%</strong></div>
                                    </div>

                                    <BarGaugeKpiGrid Items="@PlayerGaugeKpis" CssClass="player-gauge-strip" />
                                </section>

                                @* ── Bloc offensif ── *@
                                <section class="player-stat-block player-stat-block--offense">
                                    <header class="player-stat-block__head">
                                        <div>
                                            <p class="section-kicker">Stats offensif</p>
                                            <h4>Production et creation</h4>
                                        </div>
                                    </header>

                                    <div class="stats-grid player-stat-grid">
                                        <div class="mini-card"><span>Buts total</span><strong>@offense.TotalButs</strong></div>
                                        <div class="mini-card"><span>Buts jeu</span><strong>@offense.Buts</strong></div>
                                        <div class="mini-card"><span>7m marques</span><strong>@offense.Buts7m</strong></div>
                                        <div class="mini-card"><span>Passes decisives</span><strong>@passing.PasseDecisive</strong></div>
                                        <div class="mini-card"><span>Tirs rates</span><strong>@offense.TirsRates</strong></div>
                                        <div class="mini-card"><span>Tirs contres</span><strong>@offense.TirContre</strong></div>
                                        <div class="mini-card"><span>7m tentes</span><strong>@(offense.Buts7m + offense.PenaltyRate)</strong></div>
                                        <div class="mini-card"><span>7m rates</span><strong>@offense.PenaltyRate</strong></div>
                                    </div>

                                    <BarGaugeKpiGrid Items="@PlayerOffenseGaugeKpis" CssClass="player-gauge-strip" />
                                </section>

                                @* ── Bloc defensif ── *@
                                <section class="player-stat-block player-stat-block--defense">
                                    <header class="player-stat-block__head">
                                        <div>
                                            <p class="section-kicker">Stats defensif</p>
                                            <h4>Recuperation et protection</h4>
                                        </div>
                                    </header>

                                    <div class="stats-grid player-stat-grid">
                                        <div class="mini-card"><span>Interceptions</span><strong>@defense.Interceptions</strong></div>
                                        <div class="mini-card"><span>Contres</span><strong>@defense.Contres</strong></div>
                                        <div class="mini-card"><span>Neutralisations</span><strong>@defense.Neutralisations</strong></div>
                                        <div class="mini-card"><span>PF provoque</span><strong>@defense.PassageForce</strong></div>
                                        <div class="mini-card"><span>Pen. concede</span><strong>@sanctions.PenaltyConcede</strong></div>
                                    </div>

                                    <BarGaugeKpiGrid Items="@PlayerDefenseGaugeKpis" CssClass="player-gauge-strip" />
                                </section>

                                @* ── Bloc maitrise technique ── *@
                                <section class="player-stat-block player-stat-block--control">
                                    <header class="player-stat-block__head">
                                        <div>
                                            <p class="section-kicker">Maitrise technique</p>
                                            <h4>Pertes, dechets et discipline</h4>
                                        </div>
                                    </header>

                                    <div class="stats-grid player-stat-grid">
                                        <div class="mini-card"><span>Pertes balle</span><strong>@passing.TotalPertes</strong></div>
                                        <div class="mini-card"><span>Mauvaises passes</span><strong>@passing.MauvaisePasse</strong></div>
                                        <div class="mini-card"><span>Fautes techniques</span><strong>@passing.FauteTechnique</strong></div>
                                        <div class="mini-card"><span>Passages en force</span><strong>@passing.PassageEnForce</strong></div>
                                        <div class="mini-card"><span>2 min.</span><strong>@sanctions.DeuxMinutes</strong></div>
                                        <div class="mini-card"><span>Avert.</span><strong>@sanctions.Avertissements</strong></div>
                                        <div class="mini-card"><span>Exclusions</span><strong>@sanctions.Exclusions</strong></div>
                                    </div>

                                    <BarGaugeKpiGrid Items="@PlayerControlGaugeKpis" CssClass="player-gauge-strip" />
                                </section>

                                @* ── Bloc gardienne (conditionnel) ── *@
                                @if (profile.IsGoalkeeper)
                                {
                                    <section class="player-stat-block player-stat-block--goalkeeper">
                                        <header class="player-stat-block__head">
                                            <div>
                                                <p class="section-kicker">Stats gardienne</p>
                                                <h4>Arrets et tirs subis</h4>
                                            </div>
                                        </header>

                                        <div class="stats-grid player-stat-grid">
                                            <div class="mini-card"><span>Arrets jeu</span><strong>@goalkeeper.Arrets</strong></div>
                                            <div class="mini-card"><span>7m arretes</span><strong>@goalkeeper.ArretsPenalty</strong></div>
                                            <div class="mini-card"><span>Arrets totaux</span><strong>@(goalkeeper.Arrets + goalkeeper.ArretsPenalty)</strong></div>
                                            <div class="mini-card"><span>Buts encaisses</span><strong>@technical.GoalkeeperConcededGoals</strong></div>
                                            <div class="mini-card"><span>7m encaisses</span><strong>@goalkeeper.ButsPenalty</strong></div>
                                            <div class="mini-card"><span>Tirs subis</span><strong>@goalkeeper.TirsSubis</strong></div>
                                        </div>

                                        <BarGaugeKpiGrid Items="@PlayerGoalkeeperGaugeKpis" CssClass="player-gauge-strip" />
                                    </section>
                                }
                            </div>

                            @if (LeagueAnalytics is not null)
                            {
                                <LeaguePlayerStatsPanel Result="@LeagueAnalytics" />
                            }
                        }
                        else if (ActiveSection == "analysis")
                        {
                            <div class="triple-grid">
                                <section class="page-panel">
                                    <p class="section-kicker">Attaque</p>
                                    <h4>@Offense.TotalButs buts</h4>
                                    <p>@Offense.TirsRates tirs rates - @Offense.TirContre tirs contres - @Offense.PenaltyRate penalties rates</p>
                                    <p class="tiny-note">@FormatRate(HandballKpiHelper.OverallShotSuccessRate(Offense))% de conversion globale</p>
                                </section>

                                <section class="page-panel">
                                    <p class="section-kicker">Defense</p>
                                    <h4>@Defense.Interceptions interceptions</h4>
                                    <p>@Defense.Contres contres - @Defense.Neutralisations neutralisations</p>
                                    <p class="tiny-note">@Defense.PassageForce passages en force provoques</p>
                                </section>

                                <section class="page-panel">
                                    <p class="section-kicker">Passe / perte</p>
                                    <h4>@Passing.PasseDecisive passes decisives</h4>
                                    <p>@Passing.TotalPertes pertes - @Passing.MauvaisePasse mauvaises passes</p>
                                    <p class="tiny-note">@Passing.FauteTechnique fautes techniques - @Passing.PassageEnForce passages en force</p>
                                </section>
                            </div>

                            <div class="triple-grid">
                                <section class="page-panel">
                                    <p class="section-kicker">Sanctions</p>
                                    <h4>@(Sanctions.Exclusions + Sanctions.Avertissements + Sanctions.DeuxMinutes + Sanctions.PenaltyConcede) incidents</h4>
                                    <div class="badge-row">
                                        <div class="mini-card"><span>Exclusions</span><strong>@Sanctions.Exclusions</strong></div>
                                        <div class="mini-card"><span>Avertissements</span><strong>@Sanctions.Avertissements</strong></div>
                                        <div class="mini-card"><span>Deux minutes</span><strong>@Sanctions.DeuxMinutes</strong></div>
                                        <div class="mini-card"><span>Penaltys</span><strong>@Sanctions.PenaltyConcede</strong></div>
                                    </div>
                                </section>
                                @if (profile.IsGoalkeeper)
                                {
                                    <section class="page-panel">
                                        <p class="section-kicker">Bloc gardienne</p>
                                        <h4>@(Goalkeeper.Arrets + Goalkeeper.ArretsPenalty) arrets</h4>
                                        <div class="badge-row">
                                            <div class="mini-card"><span>Buts pris</span><strong>@Goalkeeper.ButsPris</strong></div>
                                            <div class="mini-card"><span>Tirs subis</span><strong>@Goalkeeper.TirsSubis</strong></div>
                                            <div class="mini-card"><span>Taux d'arret</span><strong>@FormatRate(Goalkeeper.TauxArret)%</strong></div>
                                            <div class="mini-card"><span>Passes</span><strong>@Goalkeeper.PasseDecisives</strong></div>
                                        </div>
                                    </section>
                                }
                                <section class="page-panel">
                                    <p class="section-kicker">Technique</p>
                                    <h4>@(profile.IsGoalkeeper ? $"{technical.TirsSubis} tirs subis" : $"{technical.ShotAttempts} tirs engages")</h4>
                                    <div class="badge-row">
                                        <div class="mini-card">
                                            <span>@(profile.IsGoalkeeper ? "Stop 7m" : "Conversion globale")</span>
                                            <strong>@FormatRate(profile.IsGoalkeeper ? technical.GoalkeeperPenaltyStopRate : technical.OverallShotSuccessRate)%</strong>
                                        </div>
                                        <div class="mini-card">
                                            <span>@(profile.IsGoalkeeper ? "Buts encaisses" : "Tirs contres")</span>
                                            <strong>@(profile.IsGoalkeeper ? technical.GoalkeeperConcededGoals : offense.TirContre)</strong>
                                        </div>
                                        <div class="mini-card">
                                            <span>@(profile.IsGoalkeeper ? "Pertes techniques" : "Dechet tir")</span>
                                            <strong>@(profile.IsGoalkeeper ? technical.TechnicalLosses : technical.ShotWaste)</strong>
                                        </div>
                                        <div class="mini-card">
                                            <span>Sanctions</span>
                                            <strong>@technical.Sanctions</strong>
                                        </div>
                                    </div>
                                </section>
                            </div>
                        }
                        else if (ActiveSection == "graphs")
                        {
                            <div class="dual-grid">
                                <section class="page-panel">
                                    <p class="section-kicker">Profil technique</p>
                                    <h4>Volumes qui structurent le role</h4>
                                    <ApexChart TItem="MetricPlotPoint" Height="310" Options="@GetPlayerProfileChartOptions()">
                                        <ApexPointSeries TItem="MetricPlotPoint"
                                                         Items="@PlayerActionProfile"
                                                         Name="@Profile.FullName"
                                                         SeriesType="SeriesType.Bar"
                                                         XValue="point => point.Label"
                                                         YValue="point => (decimal?)point.Value" />
                                    </ApexChart>
                                </section>

                                <section class="page-panel">
                                    <p class="section-kicker">Rendement</p>
                                    <h4>Pourcentages et ratios clefs</h4>
                                    <ApexChart TItem="MetricPlotPoint" Height="310" Options="@GetPlayerRateChartOptions()">
                                        <ApexPointSeries TItem="MetricPlotPoint"
                                                         Items="@PlayerRateProfile"
                                                         Name="Niveau"
                                                         SeriesType="SeriesType.Bar"
                                                         XValue="point => point.Label"
                                                         YValue="point => (decimal?)point.Value" />
                                    </ApexChart>
                                </section>
                            </div>

                            <div class="dual-grid">
                                <section class="page-panel">
                                    <p class="section-kicker">Tendance recente</p>
                                    <h4>Lecture match apres match</h4>

                                    @if (PlayerTrendSeries.Count == 0)
                                    {
                                        <p class="empty-hint">Aucun historique detaille disponible pour tracer la tendance recente.</p>
                                    }
                                    else
                                    {
                                        <ApexChart @key="SelectedPlayerId" TItem="MatchTrendPoint" Height="320" Options="@GetPlayerTrendChartOptions()">
                                            <ApexPointSeries TItem="MatchTrendPoint"
                                                             Items="@PlayerTrendSeries"
                                                             Name="Actions directes"
                                                             SeriesType="SeriesType.Line"
                                                             XValue="point => point.Label"
                                                             YValue="point => (decimal?)point.DirectContributions" />
                                            <ApexPointSeries TItem="MatchTrendPoint"
                                                             Items="@PlayerTrendSeries"
                                                             Name="Impact def."
                                                             SeriesType="SeriesType.Line"
                                                             XValue="point => point.Label"
                                                             YValue="point => (decimal?)point.DefensiveImpact" />
                                            <ApexPointSeries TItem="MatchTrendPoint"
                                                             Items="@PlayerTrendSeries"
                                                             Name="Pertes"
                                                             SeriesType="SeriesType.Line"
                                                             XValue="point => point.Label"
                                                             YValue="point => (decimal?)point.Turnovers" />
                                            @if (Profile.IsGoalkeeper)
                                            {
                                                <ApexPointSeries TItem="MatchTrendPoint"
                                                                 Items="@PlayerTrendSeries"
                                                                 Name="Arrets"
                                                                 SeriesType="SeriesType.Line"
                                                                 XValue="point => point.Label"
                                                                 YValue="point => (decimal?)point.Saves" />
                                            }
                                        </ApexChart>
                                    }
                                </section>

                                <section class="page-panel">
                                    <p class="section-kicker">Nuage de points</p>
                                    <h4>Pertes vs impact global</h4>
                                    <p class="page-subtitle">Chaque point represente un match. Plus il monte, plus l'impact global est fort. Plus il part a droite, plus les pertes augmentent.</p>

                                    @if (!ShowPlayerScatterChart)
                                    {
                                        <p class="empty-hint">Aucune serie assez complete pour tracer le nuage de points.</p>
                                    }
                                    else
                                    {
                                        <ApexChart @key="SelectedPlayerId" TItem="MatchTrendPoint" Height="320" Options="@GetPlayerScatterChartOptions()">
                                            <ApexPointTooltip>
                                                @{
                                                    var datapoint = context.DataPoint as IDataPoint<MatchTrendPoint>;
                                                    var point = datapoint?.Items?.FirstOrDefault();
                                                }

                                                @if (point is not null)
                                                {
                                                    var impact = point.DirectContributions + point.DefensiveImpact;
                                                    var insight = GetScatterInsightLabel(point);

                                                    <div class="chart-tooltip-card player-scatter-tooltip">
                                                        <div class="chart-tooltip-head">
                                                            <div>
                                                                <p class="chart-tooltip-kicker">Lecture analytique</p>
                                                                <h5>@(point.MatchLabel ?? point.Label)</h5>
                                                            </div>

                                                            <span class="chart-tooltip-badge">@insight</span>
                                                        </div>

                                                        <p class="chart-tooltip-meta">
                                                            @if (!string.IsNullOrWhiteSpace(point.SeasonDayLabel))
                                                            {
                                                                <span>@point.SeasonDayLabel</span>
                                                            }

                                                            @if (!string.IsNullOrWhiteSpace(point.TeamLabel))
                                                            {
                                                                <span>@point.TeamLabel</span>
                                                            }

                                                            @if (!string.IsNullOrWhiteSpace(point.OpponentLabel))
                                                            {
                                                                <span>vs @point.OpponentLabel</span>
                                                            }
                                                        </p>

                                                        @if (!string.IsNullOrWhiteSpace(point.CompetitionLabel))
                                                        {
                                                            <p class="chart-tooltip-competition">@point.CompetitionLabel</p>
                                                        }

                                                        <div class="chart-tooltip-grid">
                                                            <div>
                                                                <span>Pertes</span>
                                                                <strong>@FormatRate(point.Turnovers)</strong>
                                                            </div>
                                                            <div>
                                                                <span>Impact</span>
                                                                <strong>@FormatRate(impact)</strong>
                                                            </div>
                                                            <div>
                                                                <span>Directes</span>
                                                                <strong>@FormatRate(point.DirectContributions)</strong>
                                                            </div>
                                                            <div>
                                                                <span>Defense</span>
                                                                <strong>@FormatRate(point.DefensiveImpact)</strong>
                                                            </div>
                                                        </div>
                                                    </div>
                                                }
                                            </ApexPointTooltip>
                                            <ChildContent>
                                                <ApexPointSeries TItem="MatchTrendPoint"
                                                                 Items="@PlayerScatterSeries"
                                                                 Name="Matchs"
                                                                 SeriesType="SeriesType.Scatter"
                                                                 XValue="point => (decimal?)point.Turnovers"
                                                                 YValue="point => (decimal?)(point.DirectContributions + point.DefensiveImpact)" />
                                            </ChildContent>
                                        </ApexChart>
                                    }
                                </section>
                            </div>
                        }
                        else if (ActiveSection == "zones")
                        {
                            @if (IsSpatialLoading && Spatial is null)
                            {
                                <StateCard Kicker="Chargement"
                                           Title="Rechargement spatial"
                                           Message="La carte but et declenchements se recalculent pour cette joueuse."
                                           Tone="loading"
                                           CssClass="empty-card-inline" />
                            }
                            else if (Spatial is null)
                            {
                                <StateCard Kicker="Aucune carte"
                                           Title="La lecture spatiale n’est pas encore disponible pour cette joueuse"
                                           Message="Le spatial s’ouvre apres chargement du dossier de la joueuse."
                                           Tone="empty"
                                           CssClass="empty-card-inline" />
                            }
                            else
                            {
                                @if (HasSpatialFocus)
                                {
                                    <div class="match-scope-toolbar spatial-focus-toolbar">
                                        <div class="match-scope-copy">
                                            <p class="section-kicker">Lecture ciblee</p>
                                            <span>Zones liees a @SpatialFocusKey</span>
                                        </div>

                                        <button type="button"
                                                class="match-scope-button"
                                                @onclick="ResetSpatialFocusAsync"
                                                disabled="@IsSpatialLoading">
                                            Voir toutes les zones
                                        </button>
                                    </div>
                                }

                                <div class="dual-grid">
                                    <section class="page-panel @(IsSpatialLoading ? "is-loading" : string.Empty)">
                                        <p class="section-kicker">Spatial</p>
                                        <h4>But et declenchements</h4>
                                        <GoalKpi GoalZones="@GoalZones"
                                                 TriggerZones="@TriggerZones"
                                                 IsGoalkeeper="@Profile.IsGoalkeeper"
                                                 ActiveZoneKey="@ActiveZoneKey"
                                                 OnZoneSelected="HandleZoneSelectionAsync"
                                                 HideZeroZones="@HasSpatialFocus"
                                                 IsLoading="@IsSpatialLoading" />
                                    </section>

                                    <section class="page-panel">
                                        <div class="panel-head">
                                            <div>
                                                <p class="section-kicker">Zone active</p>
                                                <h4>@(CurrentZone?.Label ?? "Selectionnez une zone")</h4>
                                            </div>
                                            @if (IsSpatialLoading)
                                            {
                                                <span class="hero-badge">Chargement spatial</span>
                                            }
                                            else if (CurrentZone is not null)
                                            {
                                                <span class="hero-badge">@FormatRate(CurrentZone.Rate)%</span>
                                            }
                                        </div>

                                        @if (CurrentZone is not null)
                                        {
                                            <div class="badge-row">
                                                <div class="mini-card"><span>Volume</span><strong>@CurrentZone.Attempts</strong></div>
                                                <div class="mini-card"><span>Succes</span><strong>@CurrentZone.Successes</strong></div>
                                                <div class="mini-card"><span>Echecs</span><strong>@CurrentZone.Failures</strong></div>
                                            </div>

                                            <div class="list-stack">
                                                @foreach (var outcome in CurrentZone.Outcomes)
                                                {
                                                    <div class="list-item">
                                                        <div class="key-metric">
                                                            <strong>@outcome.Label</strong>
                                                            <span>@outcome.Count</span>
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </section>
                                </div>
                            }
                        }
                        else
                        {
                            <section class="page-panel">
                                <div class="panel-head">
                                    <div>
                                        <p class="section-kicker">Feuilles de match</p>
                                        <h4>@PlayerMatches.Count matchs pour la joueuse</h4>
                                    </div>
                                </div>

                                <div class="table-toolbar">
                                    <label class="filter-field table-search">
                                        <span>Filtrer le tableau</span>
                                        <input value="@PlayerMatchSearch" @oninput="OnPlayerMatchSearchChanged" placeholder="Equipe, competition ou saison" />
                                    </label>
                                </div>

                                <div class="table-toolbar">
                                    @TableHeader("match", "Match", SetPlayerMatchSort)
                                    @TableHeader("date", "Saison/J", SetPlayerMatchSort)
                                    @TableHeader("score", "Score", SetPlayerMatchSort)
                                    @TableHeader("goals", "Buts", SetPlayerMatchSort)
                                    @TableHeader("assists", "Passes", SetPlayerMatchSort)
                                    @TableHeader("interceptions", "Interceptions", SetPlayerMatchSort)
                                    @TableHeader("saves", "Arrets", SetPlayerMatchSort)
                                    @TableHeader("turnovers", "Pertes", SetPlayerMatchSort)
                                    @TableHeader("sanctions", "Sanctions", SetPlayerMatchSort)
                                </div>

                                @{
                                    var playerMatchRows = FilteredPlayerMatches.ToArray();
                                }

                                @if (playerMatchRows.Length == 0)
                                {
                                    <StateCard Kicker="Aucune feuille"
                                               Title="Le filtre courant ne retourne aucune rencontre pour cette joueuse"
                                               Message="Essayez un autre contexte ou retirez un filtre trop restrictif."
                                               Tone="empty"
                                               CssClass="empty-card-inline" />
                                }
                                else
                                {
                                    <div class="match-mosaic">
                                        @foreach (var match in playerMatchRows)
                                        {
                                        <MatchCard @key="match.MatchId"
                                                   Title="@($"{match.Team1Name ?? "Equipe A"} vs {match.Team2Name ?? "Equipe B"}")"
                                                   Score="@($"{match.Team1Score ?? 0} - {match.Team2Score ?? 0}")"
                                                   Teams="@ReferenceData.Teams"
                                                   Season="@Season"
                                                   HomeTeamLogoUrl="@TeamLogoAssetResolver.ResolveByName(ReferenceData.Teams, match.Team1Name, Season)"
                                                   AwayTeamLogoUrl="@TeamLogoAssetResolver.ResolveByName(ReferenceData.Teams, match.Team2Name, Season)"
                                                   Meta="@(match.CompetitionName ?? "Competition")"
                                                   SecondaryMeta="@MatchFilterCatalog.FormatSeasonDay(match)"
                                                   DetailsHref="@($"/matches?matchId={match.MatchId}")"
                                                   DetailsLabel="Voir plus">
                                                <span class="match-card-chip is-positive">Buts @match.Goals</span>
                                                <span class="match-card-chip is-good">Passes @match.Assists</span>
                                                <span class="match-card-chip">Interceptions @match.Interceptions</span>
                                                <span class="match-card-chip">Arrets @match.Saves</span>
                                                <span class="match-card-chip is-warning">Pertes @match.Turnovers</span>
                                                <span class="match-card-chip is-danger">Sanctions @match.Sanctions</span>
                                            </MatchCard>
                                        }
                                    </div>
                                }
                            </section>
                        }
                    }
                </article>
            </section>
        }
    }
</div>

