    private async Task EnsureTrajectoryLoadedAsync()
    {
        if (IsTrajectoryLoaded || IsTrajectoryLoading) return;
        IsTrajectoryLoading = true;
        var myToken = System.Threading.Interlocked.Increment(ref _trajectoryLoadToken);
        try
        {
            TrajectoryPoints = BuildTrajectoryPoints();
            if (_trajectoryLoadToken != myToken) return;
            IsTrajectoryLoaded = true;
        }
        finally
        {
            if (_trajectoryLoadToken == myToken)
                IsTrajectoryLoading = false;
            StateHasChanged();
        }
        await Task.CompletedTask;
    }

