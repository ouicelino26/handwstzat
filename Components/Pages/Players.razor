    // Calcule le rang depuis PlayerDirectory en castant vers PlayerGlobalStatsDto (covariance).
    // Retourne "#rang_poste/total_poste · #rang_global/total_global"
    private string RankContext(Func<PlayerGlobalStatsDto, double> selector, bool higherIsBetter = true)
    {
        if (Profile is null || PlayerDirectory.Count == 0)
        {
            return string.Empty;
        }

        var all = PlayerDirectory
            .OfType<PlayerGlobalStatsDto>()
            .Where(p => p.MatchesPlayed > 0)
            .ToList();

        if (all.Count == 0)
        {
            return string.Empty;
        }

        var byPosition = all
            .Where(p => p.PositionId == Profile.PositionId)
            .ToList();

        int globalRank = RankOf(Profile.PlayerId, all, selector, higherIsBetter);
        int globalTotal = all.Count;
        int posRank = RankOf(Profile.PlayerId, byPosition, selector, higherIsBetter);
        int posTotal = byPosition.Count;

        var posCode = Profile.PositionCode ?? Profile.PositionName ?? "Poste";

        if (posTotal <= 1)
        {
            return $"#{globalRank}/{globalTotal} global";
        }

        return $"#{posRank}/{posTotal} {posCode} · #{globalRank}/{globalTotal} global";
    }

    private static int RankOf(int playerId, List<PlayerGlobalStatsDto> pool, Func<PlayerGlobalStatsDto, double> selector, bool higherIsBetter)
    {
        if (pool.Count == 0)
        {
            return 1;
        }

        var sorted = higherIsBetter
            ? pool.OrderByDescending(selector).ToList()
            : pool.OrderBy(selector).ToList();

        var idx = sorted.FindIndex(p => p.PlayerId == playerId);
        return idx < 0 ? pool.Count : idx + 1;
    }

