    private RenderFragment RenderCountCell(int? value, double? seasonBaseline, TrajectoryMetricDirection direction)
    {
        return builder =>
        {
            if (value == null)
            {
                builder.OpenElement(0, "span");
                builder.AddAttribute(1, "class", "games-na");
                builder.AddContent(2, "—");
                builder.CloseElement();
                return;
            }
            builder.OpenElement(0, "span");
            builder.AddAttribute(1, "class", "games-val");
            builder.AddContent(2, value.ToString());
            builder.CloseElement();

            if (GamesDisplayMode == PlayerGamesDisplayMode.DeltaVsSeason && seasonBaseline.HasValue)
            {
                var delta = value.Value - seasonBaseline.Value;
                var isGood = direction == TrajectoryMetricDirection.LowerIsBetter ? delta < -0.1 : delta > 0.1;
                var isBad = direction == TrajectoryMetricDirection.LowerIsBetter ? delta > 0.1 : delta < -0.1;
                var cls = isGood ? "games-delta--pos" : isBad ? "games-delta--neg" : "";
                builder.OpenElement(3, "span");
                builder.AddAttribute(4, "class", $"games-delta {cls}");
                builder.AddContent(5, $"{(delta >= 0 ? "+" : "")}{delta:F1}");
                builder.CloseElement();
            }
        };
    }

    private RenderFragment RenderRateCell(double? rate, int? num, int? den, double? seasonBaseline, TrajectoryMetricDirection direction)
    {
        return builder =>
        {
            if (den == 0 || (rate == null && den == null))
            {
                builder.OpenElement(0, "span");
                builder.AddAttribute(1, "class", "games-na");
                builder.AddContent(2, den == 0 ? "Aucun tir" : "—");
                builder.CloseElement();
                return;
            }
            if (rate == null)
            {
                builder.OpenElement(0, "span");
                builder.AddAttribute(1, "class", "games-na");
                builder.AddContent(2, "—");
                builder.CloseElement();
                return;
            }
            builder.OpenElement(0, "span");
            builder.AddAttribute(1, "class", "games-val");
            builder.AddContent(2, $"{rate:F1}%");
            builder.CloseElement();
            if (num.HasValue && den.HasValue && den > 0)
            {
                builder.OpenElement(3, "span");
                builder.AddAttribute(4, "class", "games-rate-evidence");
                builder.AddContent(5, $"{num}/{den}");
                builder.CloseElement();
            }
            if (GamesDisplayMode == PlayerGamesDisplayMode.DeltaVsSeason && seasonBaseline.HasValue)
            {
                var delta = rate.Value - seasonBaseline.Value;
                var isGood = direction == TrajectoryMetricDirection.LowerIsBetter ? delta < -0.5 : delta > 0.5;
                var isBad = direction == TrajectoryMetricDirection.LowerIsBetter ? delta > 0.5 : delta < -0.5;
                var cls = isGood ? "games-delta--pos" : isBad ? "games-delta--neg" : "";
                builder.OpenElement(6, "span");
                builder.AddAttribute(7, "class", $"games-delta {cls}");
                builder.AddContent(8, $"{(delta >= 0 ? "+" : "")}{delta:F1} pts");
                builder.CloseElement();
            }
        };
    }

