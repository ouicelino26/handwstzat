    private async Task EnsureTimelineLoadedAsync()
    {
        if (IsTimelineLoaded || IsTimelineLoading) return;
        await LoadTimelineAsync();
    }

    private async Task LoadTimelineAsync()
    {
        if (!SelectedPlayerId.HasValue) return;

        var playerId  = SelectedPlayerId.Value;
        var loadToken = System.Threading.Interlocked.Increment(ref _timelineLoadToken);

        IsTimelineLoading = true;
        TimelineErrorMessage = null;
        await InvokeAsync(StateHasChanged);

        try
        {
            var result = await StatsApiClient.GetPlayerTimelineAsync(playerId, TimelineBucketMinutes, BuildOptions());

            if (loadToken != _timelineLoadToken || !SelectedPlayerId.HasValue || SelectedPlayerId.Value != playerId)
                return;

            Timeline = result;
            IsTimelineLoaded = true;
        }
        catch (Exception ex)
        {
            if (loadToken != _timelineLoadToken) return;
            TimelineErrorMessage = ex.Message;
            Timeline = null;
            Logger.LogWarning(ex, "Failed to load timeline for player {PlayerId}.", playerId);
        }
        finally
        {
            if (loadToken == _timelineLoadToken && SelectedPlayerId.HasValue && SelectedPlayerId.Value == playerId)
            {
                IsTimelineLoading = false;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

