    private string BuildPlayerSheetSvg(PositionProfileResponseDto? positionProfile, string? photoDataUri = null)
    {
        var profile = Profile!;
        var width = 1600;
        var height = 1140;

        // Header zone: 0–210 px (taller to fit KPI row above name)
        var headerMarkup = BuildPlayerSheetHeaderMarkup(profile, positionProfile, width, photoDataUri);

        // Separator line
        var separatorY = 210;

        // Two-column content area: y=220, h=880
        var contentY = 220;
        var contentH = 880;
        var tableX = 36d;
        var tableW = 720d;
        var radarX = 768d;
        var radarW = 796d;

        var offensiveRows = BuildPlayerSheetOffensiveRows();
        var defensiveRows = BuildPlayerSheetDefensiveRows();
        var tableMarkup = BuildPlayerSheetTableMarkup(offensiveRows, defensiveRows, tableX, contentY, tableW, contentH);
        var radarMarkup = BuildPlayerSheetRadarMarkup(profile, positionProfile, radarX, contentY, radarW, contentH);

        var footerY = contentY + contentH + 18;
        var footerNote = "Données HandWStat · Statistiques sur la cohorte du poste · " +
            (string.IsNullOrWhiteSpace(Season) ? "Toutes saisons" : Season!);

        return $"""
<svg xmlns="http://www.w3.org/2000/svg" width="{width}" height="{height}" viewBox="0 0 {width} {height}">
  <rect width="{width}" height="{height}" rx="30" fill="#eef4fb" />
  <rect x="14" y="14" width="{width - 28}" height="{height - 28}" rx="26" fill="#ffffff" stroke="#d8e2ef" />
  {headerMarkup}
  <line x1="36" y1="{separatorY}" x2="{width - 36}" y2="{separatorY}" stroke="#d8e2ef" stroke-width="1" />
  {tableMarkup}
  {radarMarkup}
  <text x="54" y="{footerY + 14}" font-family="Segoe UI, Arial, sans-serif" font-size="11" fill="#94a3b8">{SvgExportHelpers.EscapeXml(footerNote)}</text>
</svg>
""";
    }

    private string BuildPlayerSheetHeaderMarkup(
        PlayerProfileDto profile,
        PositionProfileResponseDto? positionProfile,
        int canvasWidth,
        string? photoDataUri = null)
    {
        // Use pre-fetched base64 data URI when available; otherwise resolve URL for initials fallback.
        string? effectivePhotoSrc = null;
        if (!string.IsNullOrWhiteSpace(photoDataUri))
        {
            effectivePhotoSrc = photoDataUri;
        }
        else
        {
            var resolvedUrl = ResolvePlayerPhotoUrl(profile.PlayerPhoto, profile.PlayerId, profile.FullName, profile.TeamName);
            // Only use the resolved URL in SVG if it's an absolute http(s) URL; relative paths don't work in exported files.
            if (!string.IsNullOrWhiteSpace(resolvedUrl)
                && (resolvedUrl.StartsWith("http://", StringComparison.OrdinalIgnoreCase)
                    || resolvedUrl.StartsWith("https://", StringComparison.OrdinalIgnoreCase)))
            {
                effectivePhotoSrc = resolvedUrl;
            }
        }

        // Photo area: top-right, 150×175
        var photoAreaX = canvasWidth - 190d;
        var photoAreaY = 24d;
        var photoW = 150d;
        var photoH = 175d;
        var photoBlock = BuildPlayerSheetPhotoMarkup(effectivePhotoSrc, profile.FullName, photoAreaX, photoAreaY, photoW, photoH);

        // Layout: kicker at y=34, then 4 compact KPI badges, then player name, position, team, nationality
        var textX = 48d;
        var kickerY = 34d;

        // ── 4 compact KPI badges (horizontal row above player name) ──────────────
        var kpiRowY = 50d;
        var kpiH = 38d;
        var kpiW = 135d;
        var kpiGap = 12d;
        var kpiRx = 8d;

        var matchesVal = profile.MatchesPlayed.ToString();
        var goalsVal = profile.TotalGoals.ToString();

        // Overall shot success rate — from Technical if available, or ShotSuccessRate from profile
        var overallRate = Technical?.OverallShotSuccessRate ?? profile.ShotSuccessRate;
        var shotAttempts = Technical?.ShotAttempts ?? 0;
        var shotRateVal = shotAttempts > 0
            ? PlayerSheetExportHelper.FormatRateOrDash(overallRate, shotAttempts)
            : (overallRate > 0 ? $"{overallRate.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)} %" : "—");

        var avgTime = profile.AveragePlayingTimePerMatchMinutes;
        var playTimeVal = avgTime > 0
            ? $"{avgTime.ToString("0", System.Globalization.CultureInfo.InvariantCulture)} min/m"
            : "—";

        var kpiCards = new[] {
            ("Matchs", matchesVal),
            ("Buts", goalsVal),
            ("% tir", shotRateVal),
            ("Tps de jeu", playTimeVal),
        };

        var kpiBadges = string.Join("\n", kpiCards.Select((card, i) =>
        {
            var cardX = textX + i * (kpiW + kpiGap);
            var labelY = kpiRowY + 14d;
            var valueY = kpiRowY + 30d;
            return $"""
  <rect x="{FormatSvgNumber(cardX)}" y="{FormatSvgNumber(kpiRowY)}" width="{FormatSvgNumber(kpiW)}" height="{FormatSvgNumber(kpiH)}" rx="{FormatSvgNumber(kpiRx)}" fill="#eef4fb" stroke="#d8e2ef" />
  <text x="{FormatSvgNumber(cardX + 10d)}" y="{FormatSvgNumber(labelY)}" font-family="Segoe UI, Arial, sans-serif" font-size="9" font-weight="700" letter-spacing="0.8" fill="#94a3b8">{EscapeXml(card.Item1.ToUpperInvariant())}</text>
  <text x="{FormatSvgNumber(cardX + 10d)}" y="{FormatSvgNumber(valueY)}" font-family="Segoe UI, Arial, sans-serif" font-size="14" font-weight="800" fill="#0f172a">{EscapeXml(card.Item2)}</text>
""";
        }));

        // Player name and identity below the KPI row
        var nameY = kpiRowY + kpiH + 24d;
        var positionY = nameY + 38d;
        var teamY = positionY + 22d;
        var nationalityY = teamY + 20d;
        var scopeY = nationalityY + 18d;

        var positionLabel = profile.PositionName ?? "Poste non renseigne";
        var teamLabel = profile.TeamName ?? "Equipe non renseignee";
        var nationalityLabel = !string.IsNullOrWhiteSpace(profile.Nationality) ? profile.Nationality : null;
        var seasonLabel = string.IsNullOrWhiteSpace(Season) ? string.Empty : Season!;

        var nationalityLine = nationalityLabel is not null
            ? $"""<text x="{FormatSvgNumber(textX)}" y="{FormatSvgNumber(nationalityY)}" font-family="Segoe UI, Arial, sans-serif" font-size="13" fill="#64748b">{EscapeXml(nationalityLabel)}</text>"""
            : string.Empty;

        var scopeText = !string.IsNullOrWhiteSpace(seasonLabel) ? seasonLabel : string.Empty;
        var scopeLine2 = !string.IsNullOrWhiteSpace(scopeText)
            ? $"""<text x="{FormatSvgNumber(textX)}" y="{FormatSvgNumber(scopeY)}" font-family="Segoe UI, Arial, sans-serif" font-size="11" fill="#94a3b8">{EscapeXml(scopeText)}</text>"""
            : string.Empty;

        return $"""
  <text x="48" y="{FormatSvgNumber(kickerY)}" font-family="Segoe UI, Arial, sans-serif" font-size="11" font-weight="700" letter-spacing="1.5" fill="{ChartPalette.Player}">FICHE JOUEUSE</text>
  {kpiBadges}
  <text x="{FormatSvgNumber(textX)}" y="{FormatSvgNumber(nameY)}" font-family="Segoe UI, Arial, sans-serif" font-size="32" font-weight="800" fill="#0f172a">{EscapeXml(profile.FullName)}</text>
  <text x="{FormatSvgNumber(textX)}" y="{FormatSvgNumber(positionY)}" font-family="Segoe UI, Arial, sans-serif" font-size="16" font-weight="600" fill="#334155">{EscapeXml(positionLabel)}</text>
  <text x="{FormatSvgNumber(textX)}" y="{FormatSvgNumber(teamY)}" font-family="Segoe UI, Arial, sans-serif" font-size="13" fill="#475569">{EscapeXml(teamLabel)}</text>
  {nationalityLine}
  {scopeLine2}
  {photoBlock}
""";
    }

    private static string BuildPlayerSheetPhotoMarkup(
        string? photoUrl,
        string? fullName,
        double x,
        double y,
        double w,
        double h)
    {
        var rx = 14d;
        var cx = x + (w / 2d);
        var cy = y + (h / 2d);

        if (!string.IsNullOrWhiteSpace(photoUrl))
        {
            // SVG does not support object-fit:cover natively; use clipPath + preserveAspectRatio="xMidYMid slice"
            var clipId = "photo-clip";
            return $"""
  <defs>
    <clipPath id="{clipId}">
      <rect x="{FormatSvgNumber(x)}" y="{FormatSvgNumber(y)}" width="{FormatSvgNumber(w)}" height="{FormatSvgNumber(h)}" rx="{FormatSvgNumber(rx)}" />
    </clipPath>
  </defs>
  <rect x="{FormatSvgNumber(x)}" y="{FormatSvgNumber(y)}" width="{FormatSvgNumber(w)}" height="{FormatSvgNumber(h)}" rx="{FormatSvgNumber(rx)}" fill="#eef4fb" stroke="#d8e2ef" />
  <image href="{SvgExportHelpers.EscapeXml(photoUrl)}" x="{FormatSvgNumber(x)}" y="{FormatSvgNumber(y)}" width="{FormatSvgNumber(w)}" height="{FormatSvgNumber(h)}" preserveAspectRatio="xMidYMid slice" clip-path="url(#{clipId})" />
""";
        }

        // Fallback: initials in a rounded rectangle
        var initials = GetInitials(fullName);
        return $"""
  <rect x="{FormatSvgNumber(x)}" y="{FormatSvgNumber(y)}" width="{FormatSvgNumber(w)}" height="{FormatSvgNumber(h)}" rx="{FormatSvgNumber(rx)}" fill="#eef4fb" stroke="#d8e2ef" />
  <text x="{FormatSvgNumber(cx)}" y="{FormatSvgNumber(cy + 16d)}" text-anchor="middle" font-family="Segoe UI, Arial, sans-serif" font-size="44" font-weight="800" fill="{ChartPalette.Player}">{EscapeXml(initials)}</text>
""";
    }

    private string BuildPlayerSheetTableMarkup(
        IReadOnlyList<PlayerSheetRowV2> offensiveRows,
        IReadOnlyList<PlayerSheetRowV2> defensiveRows,
        double x,
        double y,
        double width,
        double height)
    {
        var panelInnerX = x + 20d;
        var panelW = width - 40d;
        var labelW = 174d;
        var valueW = 110d;
        var evidenceX = panelInnerX + labelW + valueW + 12d;
        var evidenceW = panelW - labelW - valueW - 24d;
        var rowH = 50d;
        var sectionKickerH = 30d;

        double cursorY = y + 8d;

        // Panel background
        var panelBg = $"""
  <rect x="{FormatSvgNumber(x)}" y="{FormatSvgNumber(y)}" width="{FormatSvgNumber(width)}" height="{FormatSvgNumber(height)}" rx="22" fill="#ffffff" stroke="#d8e2ef" />
""";

        // Column header (once, at the top)
        var colHeaderY = cursorY + sectionKickerH;
        var colHeader = $"""
  <rect x="{FormatSvgNumber(panelInnerX)}" y="{FormatSvgNumber(colHeaderY)}" width="{FormatSvgNumber(panelW)}" height="28" rx="10" fill="#f8fafc" stroke="#d8e2ef" />
  <text x="{FormatSvgNumber(panelInnerX + 14d)}" y="{FormatSvgNumber(colHeaderY + 19d)}" font-family="Segoe UI, Arial, sans-serif" font-size="11" font-weight="700" fill="#94a3b8">INDICATEUR</text>
  <text x="{FormatSvgNumber(panelInnerX + labelW + 12d)}" y="{FormatSvgNumber(colHeaderY + 19d)}" font-family="Segoe UI, Arial, sans-serif" font-size="11" font-weight="700" fill="#94a3b8">VALEUR</text>
  <text x="{FormatSvgNumber(evidenceX)}" y="{FormatSvgNumber(colHeaderY + 19d)}" font-family="Segoe UI, Arial, sans-serif" font-size="11" font-weight="700" fill="#94a3b8">PREUVE</text>
""";
        cursorY = colHeaderY + 28d + 4d;

        // OFFENSIF section
        var offKickerY = cursorY;
        var offKicker = $"""
  <text x="{FormatSvgNumber(panelInnerX + 4d)}" y="{FormatSvgNumber(offKickerY + 20d)}" font-family="Segoe UI, Arial, sans-serif" font-size="11" font-weight="700" letter-spacing="1.2" fill="{ChartPalette.Player}">OFFENSIF</text>
""";
        cursorY += sectionKickerH;

        var offRows = BuildTableBodyRows(offensiveRows, panelInnerX, cursorY, panelW, labelW, valueW, evidenceX, evidenceW, rowH);
        cursorY += offensiveRows.Count * rowH + 10d;

        // DÉFENSIF section
        var defKickerY = cursorY;
        var defKicker = $"""
  <text x="{FormatSvgNumber(panelInnerX + 4d)}" y="{FormatSvgNumber(defKickerY + 20d)}" font-family="Segoe UI, Arial, sans-serif" font-size="11" font-weight="700" letter-spacing="1.2" fill="{ChartPalette.Primary}">DEFENSIF</text>
""";
        cursorY += sectionKickerH;

        var defRows = BuildTableBodyRows(defensiveRows, panelInnerX, cursorY, panelW, labelW, valueW, evidenceX, evidenceW, rowH);

        return panelBg + colHeader + offKicker + offRows + defKicker + defRows;
    }

    private static string BuildTableBodyRows(
        IReadOnlyList<PlayerSheetRowV2> rows,
        double tableX,
        double startY,
        double tableWidth,
        double labelW,
        double valueW,
        double evidenceX,
        double evidenceW,
        double rowH)
    {
        return string.Join("\n", rows.Select((row, index) =>
        {
            var rowY = startY + (index * rowH);
            var background = index % 2 == 0 ? "#f8fafc" : "#ffffff";
            var accent = GetSheetToneColor(row.Tone);

            return $"""
  <rect x="{FormatSvgNumber(tableX)}" y="{FormatSvgNumber(rowY)}" width="{FormatSvgNumber(tableWidth)}" height="{FormatSvgNumber(rowH - 3d)}" rx="12" fill="{background}" stroke="#d8e2ef" />
  <rect x="{FormatSvgNumber(tableX)}" y="{FormatSvgNumber(rowY)}" width="5" height="{FormatSvgNumber(rowH - 3d)}" rx="12" fill="{accent}" />
  {SvgExportHelpers.BuildWrappedText(tableX + 16d, rowY + 18d, labelW - 24d, row.Label, "#64748b", 12, 700, "start", 1.1, 1)}
  <text x="{FormatSvgNumber(tableX + labelW + 10d)}" y="{FormatSvgNumber(rowY + 31d)}" font-family="Segoe UI, Arial, sans-serif" font-size="17" font-weight="800" fill="#0f172a">{SvgExportHelpers.EscapeXml(row.Value)}</text>
  {SvgExportHelpers.BuildWrappedText(evidenceX, rowY + 18d, evidenceW, row.Evidence, "#64748b", 12, 400, "start", 1.15, 2)}
""";
        }));
    }

    private string BuildPlayerSheetRadarMarkup(
        PlayerListItemDto profile,
        PositionProfileResponseDto? positionProfile,
        double panelX,
        double panelY,
        double panelW,
        double panelH)
    {
        var isGk = profile.IsGoalkeeper;
        var offAxes = BuildOffensiveRadarAxes(positionProfile, isGk);
        var defAxes = BuildDefensiveRadarAxes(positionProfile, isGk);

        // Use the larger set for the main radar; fall back to the other
        var primaryAxes = offAxes.Count >= defAxes.Count ? offAxes : defAxes;
        var primaryTitle = offAxes.Count >= defAxes.Count
            ? (isGk ? "PROFIL GARDIENNE" : "PROFIL OFFENSIF")
            : "PROFIL DEFENSIF";
        var secondaryAxes = offAxes.Count >= defAxes.Count ? defAxes : offAxes;
        var secondaryTitle = offAxes.Count >= defAxes.Count
            ? "PROFIL DEFENSIF"
            : (isGk ? "PROFIL GARDIENNE" : "PROFIL OFFENSIF");

        var cohortCount = positionProfile?.CohortPlayerCount ?? 0;
        var positionName = positionProfile?.PositionName ?? profile.PositionName ?? "poste";
        var cohortLabel = cohortCount > 0
            ? $"Cohorte : {cohortCount} {SvgExportHelpers.EscapeXml(positionName.ToLowerInvariant())}s"
            : "Comparaison au poste";

        // Panel bg
        var panelBg = $"""
  <rect x="{FormatSvgNumber(panelX)}" y="{FormatSvgNumber(panelY)}" width="{FormatSvgNumber(panelW)}" height="{FormatSvgNumber(panelH)}" rx="22" fill="#ffffff" stroke="#d8e2ef" />
""";

        if (primaryAxes.Count == 0)
        {
            return panelBg + $"""
  <text x="{FormatSvgNumber(panelX + panelW / 2d)}" y="{FormatSvgNumber(panelY + panelH / 2d)}" text-anchor="middle" font-family="Segoe UI, Arial, sans-serif" font-size="16" font-weight="700" fill="#0f172a">Radar poste indisponible</text>
  <text x="{FormatSvgNumber(panelX + panelW / 2d)}" y="{FormatSvgNumber(panelY + panelH / 2d + 28d)}" text-anchor="middle" font-family="Segoe UI, Arial, sans-serif" font-size="12" fill="#64748b">La cohorte du poste n'a pas pu etre chargee.</text>
""";
        }

        // Layout: primary radar takes top 50%, secondary takes bottom 50%
        var halfH = (panelH - 24d) / 2d;

        var primaryBlock = BuildSingleRadarBlock(
            profile, primaryAxes, primaryTitle, cohortLabel,
            panelX, panelY + 8d, panelW, halfH);

        var defBlock = secondaryAxes.Count > 0
            ? BuildSingleRadarBlock(
                profile, secondaryAxes, secondaryTitle, cohortLabel,
                panelX, panelY + halfH + 16d, panelW, halfH)
            : $"""
  <text x="{FormatSvgNumber(panelX + panelW / 2d)}" y="{FormatSvgNumber(panelY + halfH + 16d + halfH / 2d)}" text-anchor="middle" font-family="Segoe UI, Arial, sans-serif" font-size="13" fill="#94a3b8">Profil secondaire non disponible pour ce poste.</text>
""";

        return panelBg + primaryBlock + defBlock;
    }

    private string BuildSingleRadarBlock(
        PlayerListItemDto profile,
        IReadOnlyList<PlayerSheetRadarAxis> axes,
        string title,
        string cohortLabel,
        double panelX,
        double panelY,
        double panelW,
        double panelH)
    {
        // Radar center: leave room for labels (80px padding) and title (30px) + legend (40px at bottom)
        var titleH = 30d;
        var legendH = 44d;
        var radarAreaH = panelH - titleH - legendH;
        var radarRadius = Math.Min(panelW / 2d - 90d, radarAreaH / 2d - 30d);
        radarRadius = Math.Max(radarRadius, 60d);
        var centerX = panelX + (panelW / 2d);
        var centerY = panelY + titleH + (radarAreaH / 2d) + 10d;

        var polygonLevels = new[] { 0.25d, 0.5d, 0.75d, 1d };
        var grid = string.Join("\n", polygonLevels.Select(level =>
            BuildRadarPolygon(axes, centerX, centerY, radarRadius * level, _ => 100d, "none", "#d7e0ea", 1)));

        var spokes = string.Join("\n", axes.Select((axis, index) =>
        {
            var point = GetRadarPoint(index, axes.Count, centerX, centerY, radarRadius, 100d);
            return $"""<line x1="{FormatSvgNumber(centerX)}" y1="{FormatSvgNumber(centerY)}" x2="{FormatSvgNumber(point.X)}" y2="{FormatSvgNumber(point.Y)}" stroke="#d7e0ea" stroke-width="1" />""";
        }));

        // Labels with 80px clearance from edge
        var labelRadius = radarRadius + 56d;
        var labels = string.Join("\n", axes.Select((axis, index) =>
        {
            var point = GetRadarPoint(index, axes.Count, centerX, centerY, labelRadius, 100d);
            var anchor = GetRadarTextAnchor(point.X, centerX);
            // Multi-line label if needed: split on "/"
            var parts = axis.Label.Split('/');
            if (parts.Length == 2)
            {
                var line1 = parts[0].Trim();
                var line2 = "/" + parts[1].Trim();
                return $"""
<text x="{FormatSvgNumber(point.X)}" y="{FormatSvgNumber(point.Y - 6d)}" text-anchor="{anchor}" font-family="Segoe UI, Arial, sans-serif" font-size="12" font-weight="700" fill="#334155">{EscapeXml(line1)}</text>
<text x="{FormatSvgNumber(point.X)}" y="{FormatSvgNumber(point.Y + 8d)}" text-anchor="{anchor}" font-family="Segoe UI, Arial, sans-serif" font-size="11" fill="#64748b">{EscapeXml(line2)}</text>
""";
            }

            return $"""<text x="{FormatSvgNumber(point.X)}" y="{FormatSvgNumber(point.Y)}" text-anchor="{anchor}" font-family="Segoe UI, Arial, sans-serif" font-size="12" font-weight="700" fill="#334155">{EscapeXml(axis.Label)}</text>""";
        }));

        var medianPolygon = BuildRadarPolygon(axes, centerX, centerY, radarRadius, axis => axis.MedianValue, ChartColorUtilities.WithAlpha(ChartPalette.Reference, 0.10), ChartPalette.Reference, 2d, "6 5");
        var playerPolygon = BuildRadarPolygon(axes, centerX, centerY, radarRadius, axis => axis.PlayerValue, ChartColorUtilities.WithAlpha(ChartPalette.Player, 0.16), ChartPalette.Player, 2.5d);

        // Legend below radar
        var legendY = panelY + panelH - legendH + 6d;
        var legendCenterX = panelX + panelW / 2d;
        var playerShortName = profile.FullName ?? "Joueuse";
        var legendMarkup = $"""
  <line x1="{FormatSvgNumber(legendCenterX - 120d)}" y1="{FormatSvgNumber(legendY + 10d)}" x2="{FormatSvgNumber(legendCenterX - 80d)}" y2="{FormatSvgNumber(legendY + 10d)}" stroke="{ChartPalette.Player}" stroke-width="3" />
  <text x="{FormatSvgNumber(legendCenterX - 74d)}" y="{FormatSvgNumber(legendY + 15d)}" font-family="Segoe UI, Arial, sans-serif" font-size="12" fill="#334155">{EscapeXml(playerShortName)}</text>
  <line x1="{FormatSvgNumber(legendCenterX + 20d)}" y1="{FormatSvgNumber(legendY + 10d)}" x2="{FormatSvgNumber(legendCenterX + 60d)}" y2="{FormatSvgNumber(legendY + 10d)}" stroke="{ChartPalette.Reference}" stroke-width="2" stroke-dasharray="6 5" />
  <text x="{FormatSvgNumber(legendCenterX + 66d)}" y="{FormatSvgNumber(legendY + 15d)}" font-family="Segoe UI, Arial, sans-serif" font-size="12" fill="#64748b">Mediane</text>
  <text x="{FormatSvgNumber(legendCenterX)}" y="{FormatSvgNumber(legendY + 32d)}" text-anchor="middle" font-family="Segoe UI, Arial, sans-serif" font-size="11" fill="#94a3b8">{SvgExportHelpers.EscapeXml(cohortLabel)} · Echelle 0-100</text>
""";

        return $"""
  <text x="{FormatSvgNumber(panelX + 20d)}" y="{FormatSvgNumber(panelY + 22d)}" font-family="Segoe UI, Arial, sans-serif" font-size="11" font-weight="700" letter-spacing="1" fill="#475569">{SvgExportHelpers.EscapeXml(title)}</text>
  {grid}
  {spokes}
  {medianPolygon}
  {playerPolygon}
  {labels}
  <circle cx="{FormatSvgNumber(centerX)}" cy="{FormatSvgNumber(centerY)}" r="3" fill="#0f172a" />
  {legendMarkup}
""";
    }

    // ── Offensive radar axes: max 6, offense/passing category, higher-is-better first ──
    // ── Radar axis selection: delegated to PlayerSheetExportHelper ──────────────

    private static IReadOnlyList<PlayerSheetRadarAxis> BuildOffensiveRadarAxes(
        PositionProfileResponseDto? positionProfile,
        bool isGoalkeeper)
        => PlayerSheetExportHelper.BuildOffensiveRadarAxes(positionProfile, isGoalkeeper);

    private static IReadOnlyList<PlayerSheetRadarAxis> BuildDefensiveRadarAxes(
        PositionProfileResponseDto? positionProfile,
        bool isGoalkeeper)
        => PlayerSheetExportHelper.BuildDefensiveRadarAxes(positionProfile, isGoalkeeper);

    private static double NormalizeRadarValue(PositionProfileAxisDto axis, double value)
        => PlayerSheetExportHelper.NormalizeRadarValue(axis, value);

    private static string BuildRadarPolygon(
        IReadOnlyList<PlayerSheetRadarAxis> axes,
        double centerX,
        double centerY,
        double radius,
        Func<PlayerSheetRadarAxis, double> valueSelector,
        string fill,
        string stroke,
        double strokeWidth,
        string? strokeDasharray = null)
    {
        var points = axes
            .Select((axis, index) => GetRadarPoint(index, axes.Count, centerX, centerY, radius, valueSelector(axis)))
            .Select(point => $"{FormatSvgNumber(point.X)},{FormatSvgNumber(point.Y)}");

        var dashAttribute = string.IsNullOrWhiteSpace(strokeDasharray) ? string.Empty : $" stroke-dasharray=\"{EscapeXml(strokeDasharray)}\"";
        return $"""<polygon points="{string.Join(" ", points)}" fill="{fill}" stroke="{stroke}" stroke-width="{strokeWidth.ToString("0.##", CultureInfo.InvariantCulture)}"{dashAttribute} />""";
    }

    private static (double X, double Y) GetRadarPoint(int index, int count, double centerX, double centerY, double radius, double value)
    {
        var angle = (-Math.PI / 2d) + (2d * Math.PI * index / count);
        var normalized = Math.Clamp(value / 100d, 0d, 1d);
        var currentRadius = radius * normalized;
        return (centerX + (Math.Cos(angle) * currentRadius), centerY + (Math.Sin(angle) * currentRadius));
    }

    private static string GetRadarTextAnchor(double pointX, double centerX)
    {
        if (Math.Abs(pointX - centerX) < 12d)
        {
            return "middle";
        }

        return pointX > centerX ? "start" : "end";
    }

    // ── Table row builders: delegated to PlayerSheetExportHelper ─────────────────

    private IReadOnlyList<PlayerSheetRowV2> BuildPlayerSheetOffensiveRows()
    {
        if (Profile is null || Global is null || Offense is null || Defense is null || Passing is null || Sanctions is null || Goalkeeper is null || Technical is null)
        {
            return [];
        }

        if (Profile.IsGoalkeeper)
        {
            var totalSaves = Goalkeeper.Arrets + Goalkeeper.ArretsPenalty;
            var tirs = Goalkeeper.TirsSubis;
            return
            [
                new PlayerSheetRowV2("Matchs", Profile.MatchesPlayed.ToString(), string.Empty, "info"),
                new PlayerSheetRowV2("Arrets", totalSaves.ToString(), $"{Goalkeeper.Arrets} jeu + {Goalkeeper.ArretsPenalty} sur 7m", "positive"),
                new PlayerSheetRowV2("Taux d'arret", PlayerSheetExportHelper.FormatRateOrDash(Goalkeeper.TauxArret, tirs), $"{totalSaves} / {tirs}", Goalkeeper.TauxArret >= 45 ? "positive" : "warning"),
                new PlayerSheetRowV2("Stop 7m", PlayerSheetExportHelper.FormatRateOrDash(Technical.GoalkeeperPenaltyStopRate, Goalkeeper.ArretsPenalty + Goalkeeper.ButsPenalty), $"{Goalkeeper.ArretsPenalty} / {Goalkeeper.ArretsPenalty + Goalkeeper.ButsPenalty}", Technical.GoalkeeperPenaltyStopRate >= 40 ? "good" : "warning"),
                new PlayerSheetRowV2("Passes decisives", Goalkeeper.PasseDecisives.ToString(), string.Empty, "good"),
                new PlayerSheetRowV2("Buts", Goalkeeper.Buts.ToString(), string.Empty, "neutral"),
            ];
        }

        // Retrieve 7m obtenus and Sanctions obtenues from LeagueAnalytics V2 data.
        var v2Offense = LeagueAnalytics?.Analytics?.Offense;
        var penWonMetric = v2Offense?.FirstOrDefault(m => m.MetricCode == "PENALTIES_WON");
        var sanctDrawnMetric = v2Offense?.FirstOrDefault(m => m.MetricCode == "SANCTIONS_DRAWN");

        var penWonVal = penWonMetric?.CountValue ?? -1;
        var penWonUnavail = penWonMetric?.IsUnavailable ?? true;
        var sanctDrawnVal = sanctDrawnMetric?.CountValue ?? -1;
        var sanctDrawnUnavail = sanctDrawnMetric?.IsUnavailable ?? true;

        return PlayerSheetExportHelper.BuildOffensiveRows(
            Profile, Global, Offense, Passing, Technical,
            penWonVal, penWonUnavail,
            sanctDrawnVal, sanctDrawnUnavail);
    }

    private IReadOnlyList<PlayerSheetRowV2> BuildPlayerSheetDefensiveRows()
    {
        if (Profile is null || Global is null || Offense is null || Defense is null || Passing is null || Sanctions is null || Goalkeeper is null || Technical is null)
        {
            return [];
        }

        if (Profile.IsGoalkeeper)
        {
            return
            [
                new PlayerSheetRowV2("Tirs subis", Goalkeeper.TirsSubis.ToString(), string.Empty, "neutral"),
                new PlayerSheetRowV2("Buts encaisses", (Goalkeeper.ButsPris + Goalkeeper.ButsPenalty).ToString(), $"{Goalkeeper.ButsPris} jeu + {Goalkeeper.ButsPenalty} sur 7m", "warning"),
                new PlayerSheetRowV2("Pertes de balle", Goalkeeper.PerteDeBalle.ToString(), string.Empty, Goalkeeper.PerteDeBalle > 5 ? "warning" : "neutral"),
                new PlayerSheetRowV2("Sanctions", Technical.Sanctions.ToString(), string.Empty, Technical.Sanctions > 3 ? "danger" : "neutral"),
            ];
        }

        return PlayerSheetExportHelper.BuildDefensiveRows(Profile, Defense, Sanctions);
    }

    private static string FormatRateOrDash(double rate, int denominator)
        => PlayerSheetExportHelper.FormatRateOrDash(rate, denominator);

    private static string FormatNumber(double value, string format)
    {
        return value.ToString(format, CultureInfo.InvariantCulture);
    }

    private static string GetSheetToneColor(string? tone)
    {
        return tone?.ToLowerInvariant() switch
        {
            "positive" => ChartPalette.Positive,
            "good" => ChartPalette.Primary,
            "warning" => ChartPalette.Warning,
            "danger" => ChartPalette.Danger,
            "info" => ChartPalette.Info,
            _ => ChartPalette.Slate
        };
    }

    private static string EscapeXml(string value) => value.Replace("&", "&amp;").Replace("<", "&lt;").Replace(">", "&gt;").Replace("\"", "&quot;").Replace("'", "&apos;");

    private static string Slugify(string value) => string.Join("-", value.Trim().ToLowerInvariant().Split(new[] { ' ', '/', '\\', '.', ',', ';', ':', '_' }, StringSplitOptions.RemoveEmptyEntries));

    private static string FormatSvgNumber(double value) => value.ToString("0.##", CultureInfo.InvariantCulture);

    // PlayerSheetRowV2 and PlayerSheetRadarAxis are defined in Models/Analytics/PlayerSheetExportModels.cs

    private RenderFragment TableHeader(string column, string label, Action<string> onSort) => builder =>
    {
        builder.OpenElement(0, "button");
        builder.AddAttribute(1, "type", "button");
        builder.AddAttribute(2, "class", $"table-sort-button {(PlayerMatchSort.IsActive(column) ? "is-active" : string.Empty)}");
        builder.AddAttribute(3, "onclick", EventCallback.Factory.Create(this, () => onSort(column)));
        builder.AddAttribute(4, "aria-label", PlayerMatchSort.SortButtonLabel(column, label));
        builder.AddAttribute(5, "aria-pressed", PlayerMatchSort.IsActive(column));
        builder.AddContent(6, label);

        var glyph = PlayerMatchSort.Glyph(column);
        if (!string.IsNullOrWhiteSpace(glyph))
        {
            builder.OpenElement(7, "span");
            builder.AddAttribute(8, "class", "sort-indicator");
            builder.AddAttribute(9, "aria-hidden", "true");
            builder.AddContent(10, glyph);
            builder.CloseElement();
        }

        builder.CloseElement();
    };

    private static string FormatRate(double value) => value.ToString("0.#");
}
