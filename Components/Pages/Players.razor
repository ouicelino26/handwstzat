    private async Task SetActiveSection(string section)
    {
        ActiveSection = section;
        if (section == "zones")
            await EnsureCourtLoadedAsync();
        if (section == "graphs")
        {
            await EnsureTrajectoryLoadedAsync();
            await EnsureTimelineLoadedAsync();
        }
        await InvokeAsync(StateHasChanged);
    }

    private async Task EnsureCourtLoadedAsync()
    {
        if (IsCourtLoaded || IsSpatialLoading || !SelectedPlayerId.HasValue)
            return;
        await LoadSpatialForFocusAsync(null);
        IsCourtLoaded = true;
    }

    private async Task EnsureTrajectoryLoadedAsync()
    {
        if (IsTrajectoryLoaded || IsTrajectoryLoading) return;
        IsTrajectoryLoading = true;
        var myToken = System.Threading.Interlocked.Increment(ref _trajectoryLoadToken);
        try
        {
            TrajectoryPoints = BuildTrajectoryPoints();
            if (_trajectoryLoadToken != myToken) return;
            IsTrajectoryLoaded = true;
        }
        finally
        {
            if (_trajectoryLoadToken == myToken)
                IsTrajectoryLoading = false;
            StateHasChanged();
        }
        await Task.CompletedTask;
    }

    private IReadOnlyList<PlayerTrajectoryPoint> BuildTrajectoryPoints()
    {
        if (PlayerMatches.Count == 0) return Array.Empty<PlayerTrajectoryPoint>();
        var teamName = Profile?.TeamName ?? string.Empty;
        var isGoalkeeper = Profile?.IsGoalkeeper == true;
        return TrajectoryPointBuilder.BuildPoints(PlayerMatches, teamName, ActiveTrajectoryMetric, isGoalkeeper);
    }

