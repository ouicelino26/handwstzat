        ApplyGlobalScope();
        // C4 — Deep-link query params override global scope on direct navigation
        ApplyDeepLinkScope();
        ScopeService.Changed += HandleGlobalScopeChanged;
        await LoadAsync(refreshReferenceData: true);
        CommandBarService.Register(() => { OpenFilterDrawer(); return Task.CompletedTask; }, PlayerDirectory.Count > 0 ? (int?)PlayerDirectory.Count : null, "joueuses");
