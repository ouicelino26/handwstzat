    protected override async Task OnInitializedAsync()
    {
        ApplyGlobalScope();
        ScopeService.Changed += HandleGlobalScopeChanged;
        await LoadAsync(refreshReferenceData: true);
    }

    private Task OnDirectoryScopeChangedAsync()
    {
        PublishGlobalScope();
        return ApplyFiltersAsync();
    }

    private async Task OnSearchChangedAsync(ChangeEventArgs args)
    {
        Search = args.Value?.ToString() ?? string.Empty;
        await DebounceSearchAsync();
    }

    private async Task DebounceSearchAsync()
    {
        var cts = new CancellationTokenSource();
        var previous = Interlocked.Exchange(ref _searchDebounceCts, cts);
        previous?.Cancel();
        previous?.Dispose();

        try
        {
            await Task.Delay(SearchDebounceDelay, cts.Token);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        if (cts.IsCancellationRequested)
        {
            return;
        }

        await ApplyFiltersAsync();
    }

    private async Task ApplyFiltersAsync()
    {
        SelectedPlayerId = null;
        await LoadAsync(refreshReferenceData: false);
    }

    private void ToggleDirectoryDrawer()
    {
        IsDirectoryDrawerOpen = !IsDirectoryDrawerOpen;
    }

    private async Task ResetFiltersAsync()
    {
        CompetitionId = null;
        TeamId = null;
        PositionId = null;
        Season = null;
        Day = null;
        Search = string.Empty;
        PlayerMatchSearch = string.Empty;
        PlayerMatchSort = new TableSortState("date", SortDirection.Desc);
        SelectedPlayerId = null;
        ActiveSection = "overview";
        IsDirectoryDrawerOpen = true;
        IsPlayerListOpen = true;
        PublishGlobalScope();
        await LoadAsync(refreshReferenceData: true);
    }

    private async Task SelectPlayerAsync(int playerId)
    {
        SelectedPlayerId = playerId;
        IsDirectoryDrawerOpen = false;
        IsPlayerListOpen = false;
        await LoadPlayerDetailsAsync();
    }

    private Task SetActiveSection(string section)
    {
        ActiveSection = section;
        return InvokeAsync(StateHasChanged);
    }

    private async Task HandleZoneSelectionAsync(string zoneKey)
    {
        if (!SelectedPlayerId.HasValue || Spatial is null || string.IsNullOrWhiteSpace(zoneKey))
        {
            return;
        }

        var normalizedZoneKey = zoneKey.Trim();
        var nextFocusKey = string.Equals(SpatialFocusKey, normalizedZoneKey, StringComparison.OrdinalIgnoreCase)
            ? null
            : normalizedZoneKey;

        ActiveZoneKey = normalizedZoneKey;
        await LoadSpatialForFocusAsync(nextFocusKey);
    }

    private async Task ResetSpatialFocusAsync()
    {
        if (!HasSpatialFocus)
        {
            return;
        }

        await LoadSpatialForFocusAsync(null);
    }

    private async Task LoadSpatialForFocusAsync(string? focusZoneKey)
    {
        if (!SelectedPlayerId.HasValue)
        {
            return;
        }

        var playerId = SelectedPlayerId.Value;
        var loadToken = System.Threading.Interlocked.Increment(ref SpatialLoadToken);
        var options = BuildSpatialQueryOptions(focusZoneKey);

        IsSpatialLoading = true;
        await InvokeAsync(StateHasChanged);
        await Task.Yield();

        try
        {
            var spatialTask = StatsApiClient.GetPlayerSpatialAsync(playerId, options);
            var spatial = await spatialTask;

            if (loadToken != SpatialLoadToken || !SelectedPlayerId.HasValue || SelectedPlayerId.Value != playerId)
            {
                return;
            }

            Spatial = spatial;
            SpatialFocusKey = focusZoneKey;
            ActiveZoneKey = ResolveActiveZoneKey(focusZoneKey);
            ErrorMessage = null;
        }
        catch (Exception ex)
        {
            if (loadToken != SpatialLoadToken || !SelectedPlayerId.HasValue || SelectedPlayerId.Value != playerId)
            {
                return;
            }

            ErrorMessage = ex.Message;
        }
        finally
        {
            if (loadToken == SpatialLoadToken && SelectedPlayerId.HasValue && SelectedPlayerId.Value == playerId)
            {
                IsSpatialLoading = false;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private StatsQueryOptionsDto BuildSpatialQueryOptions(string? focusZoneKey)
    {
        var options = BuildOptions();

        if (string.IsNullOrWhiteSpace(focusZoneKey))
        {
            return options;
        }

        if (SpatialZoneVisuals.IsTriggerZoneKey(focusZoneKey))
        {
            options.Trigger = SpatialZoneVisuals.ToBackendTriggerKey(focusZoneKey);
        }
        else
        {
            options.ShootShade = focusZoneKey.Trim();
        }

        return options;
    }

    private string? ResolveActiveZoneKey(string? preferredKey = null)
    {
        var allZoneKeys = GoalZones
            .Concat(TriggerZones)
            .Select(zone => zone.Key)
            .Where(key => !string.IsNullOrWhiteSpace(key))
            .ToHashSet(StringComparer.OrdinalIgnoreCase);

        if (!string.IsNullOrWhiteSpace(preferredKey) && allZoneKeys.Contains(preferredKey))
        {
            return preferredKey;
        }

        if (!string.IsNullOrWhiteSpace(ActiveZoneKey) && allZoneKeys.Contains(ActiveZoneKey))
        {
            return ActiveZoneKey;
        }

        return GoalZones.FirstOrDefault(zone => zone.Attempts > 0)?.Key
            ?? TriggerZones.FirstOrDefault(zone => zone.Attempts > 0)?.Key
            ?? GoalZones.FirstOrDefault()?.Key
            ?? TriggerZones.FirstOrDefault()?.Key;
    }

    private Task OnPlayerMatchSearchChanged(ChangeEventArgs args)
    {
        PlayerMatchSearch = args.Value?.ToString() ?? string.Empty;
        return InvokeAsync(StateHasChanged);
    }

    private bool CanExportPlayerSheet =>
        Profile is not null
        && Global is not null
        && Offense is not null
        && Defense is not null
        && Passing is not null
        && Sanctions is not null
        && Goalkeeper is not null
        && Technical is not null
        && SelectedPlayerId.HasValue;

    private async Task ExportPlayerSheetAsync()
    {
        if (!CanExportPlayerSheet)
        {
            return;
        }

        var loadStartedAt = DateTimeOffset.UtcNow;

        try
        {
            await BusyUiHelper.EnterAsync(() => IsPlayerSheetExportBusy = true, () => InvokeAsync(StateHasChanged));

            PositionProfileResponseDto? positionProfile = null;
            try
            {
                positionProfile = await PlayersApiClient.GetPlayerPositionProfileAsync(SelectedPlayerId!.Value, BuildPlayerSheetPositionProfileOptions());
            }
            catch
            {
                positionProfile = null;
            }

            // Attempt to embed photo as base64 data URI so the exported SVG is self-contained.
            string? photoDataUri = null;
            try
            {
                var rawUrl = ResolvePlayerPhotoUrl(Profile!.PlayerPhoto, Profile.PlayerId, Profile.FullName, Profile.TeamName);
                if (!string.IsNullOrWhiteSpace(rawUrl))
                {
                    photoDataUri = await LoadPhotoAsDataUriAsync(rawUrl);
                }
            }
            catch
            {
                photoDataUri = null; // fallback to initials
            }

            await JS.InvokeVoidAsync(
                "handwstatExports.downloadTextFile",
                BuildPlayerSheetFileName("svg"),
                "image/svg+xml;charset=utf-8",
                BuildPlayerSheetSvg(positionProfile, photoDataUri));
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
        finally
        {
            await BusyUiHelper.ExitAsync(() => IsPlayerSheetExportBusy = false, () => InvokeAsync(StateHasChanged), loadStartedAt);
        }
    }

    /// <summary>
    /// Load a player photo and return a base64 data URI suitable for embedding in SVG.
    /// Supports package-bundled assets (wwwroot relative paths) and absolute HTTPS URLs.
    /// Returns null on failure — caller falls back to initials.
    /// </summary>
    private static async Task<string?> LoadPhotoAsDataUriAsync(string photoUrl)
    {
        byte[]? bytes = null;

        if (photoUrl.StartsWith("http://", StringComparison.OrdinalIgnoreCase)
            || photoUrl.StartsWith("https://", StringComparison.OrdinalIgnoreCase))
        {
            // Remote URL — download via HttpClient would require injecting it here.
            // For now, return null (initials fallback) for remote URLs in exported SVG.
            return null;
        }

        // Local asset bundled in the MAUI package (wwwroot/* path).
        // Strip leading slash so FileSystem.OpenAppPackageFileAsync can resolve it.
        var packagePath = photoUrl.TrimStart('/');
        try
        {
            using var stream = await FileSystem.OpenAppPackageFileAsync(packagePath);
            using var ms = new System.IO.MemoryStream();
            await stream.CopyToAsync(ms);
            bytes = ms.ToArray();
        }
        catch
        {
            return null;
        }

        if (bytes is null || bytes.Length == 0)
        {
            return null;
        }

        // Detect MIME type from first bytes (JPEG: FF D8 / PNG: 89 50 4E 47)
        var mime = bytes.Length >= 2 && bytes[0] == 0xFF && bytes[1] == 0xD8
            ? "image/jpeg"
            : bytes.Length >= 4 && bytes[0] == 0x89 && bytes[1] == 0x50 && bytes[2] == 0x4E && bytes[3] == 0x47
                ? "image/png"
                : "image/jpeg"; // default

        return $"data:{mime};base64,{Convert.ToBase64String(bytes)}";
    }

    private async Task LoadAsync(bool refreshReferenceData)
    {
        if (!AuthService.Session.IsAuthenticated)
        {
            ReferenceData = AnalyticsReferenceData.Empty;
            PlayerDirectory = [];
            await LoadPlayerDetailsAsync(manageBusyState: false);
            return;
        }

        var loadStartedAt = DateTimeOffset.UtcNow;

        try
        {
            await BusyUiHelper.EnterAsync(() => IsBusy = true, () => InvokeAsync(StateHasChanged));
            ErrorMessage = null;

            if (refreshReferenceData || ReferenceData == AnalyticsReferenceData.Empty)
            {
                ReferenceData = await ReferenceDataService.GetReferenceDataAsync(refreshReferenceData);
            }

            if (!HasDirectoryCriteria)
            {
                if (PlayerIdFromQuery.HasValue)
                {
                    var linkedPlayer = await PlayersApiClient.GetPlayerAsync(PlayerIdFromQuery.Value);
                    PlayerDirectory = linkedPlayer is null ? [] : [linkedPlayer];
                    SelectedPlayerId = linkedPlayer?.PlayerId;
                    await LoadPlayerDetailsAsync(manageBusyState: false);
                    return;
                }

                ScopedMatches = [];
                PlayerDirectory = [];
                await LoadPlayerDetailsAsync(manageBusyState: false);
                return;
            }

            await LoadFilterScopesAsync();

            var filtersAdjusted = false;

            if (CompetitionId.HasValue && AvailableCompetitions.All(item => item.CompetitionId != CompetitionId.Value))
            {
                CompetitionId = null;
                filtersAdjusted = true;
            }

            if (TeamId.HasValue && AvailableTeams.All(item => item.TeamId != TeamId.Value))
            {
                TeamId = null;
                filtersAdjusted = true;
            }

            if (filtersAdjusted)
            {
                await LoadFilterScopesAsync();
            }

            if (!string.IsNullOrWhiteSpace(Season) && !SeasonOptions.Contains(Season, StringComparer.OrdinalIgnoreCase))
            {
                Season = null;
            }

            if (!string.IsNullOrWhiteSpace(Day) && !DayOptions.Contains(Day, StringComparer.OrdinalIgnoreCase))
            {
                Day = null;
            }

            PlayerDirectory = await PlayersApiClient.GetPlayersAsync(
                teamId: TeamId,
                positionId: PositionId,
                competitionId: CompetitionId,
                year: Year,
                season: Season,
                day: Day,
                search: Search,
                pageSize: IsCompetitionOnlyDirectoryFilter ? 1000 : 250);

            if (PlayerIdFromQuery.HasValue && PlayerDirectory.Any(player => player.PlayerId == PlayerIdFromQuery.Value))
            {
                SelectedPlayerId = PlayerIdFromQuery.Value;
            }

            SelectedPlayerId ??= PlayerDirectory.FirstOrDefault()?.PlayerId;

            if (SelectedPlayerId.HasValue && PlayerDirectory.All(player => player.PlayerId != SelectedPlayerId.Value))
            {
                SelectedPlayerId = PlayerDirectory.FirstOrDefault()?.PlayerId;
            }

            await LoadPlayerDetailsAsync(manageBusyState: false);
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
        finally
        {
            await BusyUiHelper.ExitAsync(() => IsBusy = false, () => InvokeAsync(StateHasChanged), loadStartedAt);
        }
    }

    public void Dispose()
    {
        ScopeService.Changed -= HandleGlobalScopeChanged;
        var cts = Interlocked.Exchange(ref _searchDebounceCts, null);
        cts?.Cancel();
        cts?.Dispose();
    }

    private void HandleGlobalScopeChanged()
    {
        if (_publishingScope)
        {
            return;
        }

        _ = InvokeAsync(async () =>
        {
            ApplyGlobalScope();
            SelectedPlayerId = null;
            await LoadAsync(refreshReferenceData: false);
        });
    }

    private void ApplyGlobalScope()
    {
        CompetitionId = ScopeService.Current.CompetitionId;
        TeamId = ScopeService.Current.TeamId;
        Season = ScopeService.Current.Season;
        Day = ScopeService.Current.Day;
    }

    private void PublishGlobalScope()
    {
        _publishingScope = true;
        try
        {
            ScopeService.Update(new AnalysisScopeSnapshot(
                CompetitionId,
                AvailableCompetitions.FirstOrDefault(item => item.CompetitionId == CompetitionId)?.CompetitionName,
                TeamId,
                AvailableTeams.FirstOrDefault(item => item.TeamId == TeamId)?.TeamName,
                Season,
                Day));
        }
        finally
        {
            _publishingScope = false;
        }
    }

    private async Task LoadPlayerDetailsAsync(bool manageBusyState = true)
    {
        System.Threading.Interlocked.Increment(ref SpatialLoadToken);
        IsSpatialLoading = false;

        if (!SelectedPlayerId.HasValue)
        {
            Profile = null;
            Global = null;
            Offense = null;
            Defense = null;
            Passing = null;
            Sanctions = null;
            Goalkeeper = null;
            Technical = null;
            LeagueAnalytics = null;
            Spatial = null;
            ActiveZoneKey = null;
            SpatialFocusKey = null;
            IsSpatialLoading = false;
            PlayerMatches = [];
            return;
        }

        var loadStartedAt = DateTimeOffset.UtcNow;

        try
        {
            if (manageBusyState)
            {
                await BusyUiHelper.EnterAsync(() => IsBusy = true, () => InvokeAsync(StateHasChanged));
            }
            ErrorMessage = null;

            var options = BuildOptions();

            var profileTask = PlayersApiClient.GetPlayerProfileAsync(SelectedPlayerId.Value, options);
            var globalTask = StatsApiClient.GetPlayerGlobalAsync(SelectedPlayerId.Value, options);
            var offenseTask = StatsApiClient.GetPlayerOffenseAsync(SelectedPlayerId.Value, options);
            var defenseTask = StatsApiClient.GetPlayerDefenseAsync(SelectedPlayerId.Value, options);
            var passingTask = StatsApiClient.GetPlayerPassingAsync(SelectedPlayerId.Value, options);
            var sanctionsTask = StatsApiClient.GetPlayerSanctionsAsync(SelectedPlayerId.Value, options);
            var goalkeeperTask = StatsApiClient.GetPlayerGoalkeeperAsync(SelectedPlayerId.Value, options);
            var technicalTask = StatsApiClient.GetPlayerTechnicalAsync(SelectedPlayerId.Value, options);
            var leagueV2Task = LeagueAnalyticsService.LoadV2Async(SelectedPlayerId.Value, options);
            var spatialTask = StatsApiClient.GetPlayerSpatialAsync(SelectedPlayerId.Value, options);
            var matchesTask = PlayersApiClient.GetPlayerMatchesAsync(SelectedPlayerId.Value, options);

            await Task.WhenAll(profileTask, globalTask, offenseTask, defenseTask, passingTask, sanctionsTask, goalkeeperTask, technicalTask, spatialTask, matchesTask, leagueV2Task);

            Profile = profileTask.Result;
            Global = globalTask.Result;
            Offense = offenseTask.Result;
            Defense = defenseTask.Result;
            Passing = passingTask.Result;
            Sanctions = sanctionsTask.Result;
            Goalkeeper = goalkeeperTask.Result;
            Technical = technicalTask.Result;
            Spatial = spatialTask.Result;
            PlayerMatches = matchesTask.Result;
            LeagueAnalytics = LeagueAnalyticsService.Resolve(
                SelectedPlayerId.Value,
                leagueV2Task.Result,
                new LeagueV1Snapshot(
                    Global!,
                    Offense!,
                    Defense!,
                    Passing!,
                    Sanctions!,
                    Goalkeeper!,
                    Technical!,
                    Profile?.IsGoalkeeper == true),
                BuildLeagueScope());
            SpatialFocusKey = null;
            ActiveZoneKey = ResolveActiveZoneKey();
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
        finally
        {
            if (manageBusyState)
            {
                await BusyUiHelper.ExitAsync(() => IsBusy = false, () => InvokeAsync(StateHasChanged), loadStartedAt);
            }
        }
    }

