                RankContext(p => p.TurnoverCount, higherIsBetter: false) + " · " + HandballKpiHelper.FormatPerMatchContext(technicalLosses, matches, "pertes"),
                Min: 0, Max: 8),
            new BarGaugeKpiItem(
                "Sanctions / match",
                HandballKpiHelper.FormatNumber(HandballKpiHelper.PerMatch(totalSanctions, matches)),
                HandballKpiHelper.PerMatch(totalSanctions, matches),
                "2 min + avertissements + exclusions. Valeur plus faible = meilleure maîtrise.",
                HandballKpiHelper.SanctionsTone(HandballKpiHelper.PerMatch(totalSanctions, matches), false),
                RankContext(p => p.SanctionCount, higherIsBetter: false) + " · " + $"{Sanctions.DeuxMinutes}×2min · {Sanctions.Avertissements} avert.",
                Min: 0, Max: 3)
        ];
    }

    // ── Brief : GARDIENNE — section arrêts ──
    // 4 KPI : arrêts totaux · taux arrêt jeu · taux arrêt 7m · arrêts/match
    private IReadOnlyList<BarGaugeKpiItem> BuildBriefGoalkeeperKpis()
    {
        if (Profile is null || !Profile.IsGoalkeeper || Goalkeeper is null || Technical is null)
        {
            return [];
        }

        var penaltyStopRate = Technical.GoalkeeperPenaltyStopRate;
        var matches = Profile.MatchesPlayed;
        var totalSaves = Goalkeeper.Arrets + Goalkeeper.ArretsPenalty;
        var openPlayShotsFaced = Goalkeeper.Arrets + Goalkeeper.ButsPris;
        var openPlaySaveRate = HandballKpiHelper.Share(Goalkeeper.Arrets, Math.Max(openPlayShotsFaced, 1));
        var penaltyShotsFaced = Goalkeeper.ArretsPenalty + Goalkeeper.ButsPenalty;

        return
        [
            new BarGaugeKpiItem(
                "Arrêts totaux",
                totalSaves.ToString(),
                totalSaves,
                "Arrêts dans le jeu + arrêts sur 7m.",
                HandballKpiHelper.GoalkeeperStopsPerMatchTone(HandballKpiHelper.PerMatch(totalSaves, matches)),
                RankContext(p => p.SaveCount) + " · " + $"{Goalkeeper.Arrets} jeu + {Goalkeeper.ArretsPenalty} sur 7m",
                Max: Math.Max(totalSaves + 5, 50)),
            new BarGaugeKpiItem(
                "Taux arrêt jeu",
                FormatRate(openPlaySaveRate) + "%",
                openPlaySaveRate,
                "Arrêts dans le jeu sur tirs subis dans le jeu.",
                HandballKpiHelper.GoalkeeperSaveRateTone(openPlaySaveRate),
                RankContext(p => p.GoalkeeperSaveRate) + " · " + HandballKpiHelper.FormatBase(Goalkeeper.Arrets, Math.Max(openPlayShotsFaced, 1), "arrêts"),
                Max: 60),
            new BarGaugeKpiItem(
                "Taux arrêt 7m",
                FormatRate(penaltyStopRate) + "%",
                penaltyStopRate,
                "Arrêts sur penalties. Médiane : 39%",
                HandballKpiHelper.GoalkeeperPenaltyStopRateTone(penaltyStopRate),
                RankContext(p => p.GoalkeeperSaveRate) + " · " + HandballKpiHelper.FormatBase(Goalkeeper.ArretsPenalty, Math.Max(penaltyShotsFaced, 1), "7m arrêtés"),
                Max: 80),
            new BarGaugeKpiItem(
                "Arrêts / match",
                HandballKpiHelper.FormatNumber(HandballKpiHelper.PerMatch(totalSaves, matches)),
                HandballKpiHelper.PerMatch(totalSaves, matches),
                "Volume d'arrêts rapporté aux matchs joués.",
                HandballKpiHelper.GoalkeeperStopsPerMatchTone(HandballKpiHelper.PerMatch(totalSaves, matches)),
                RankContext(p => p.SaveCount) + " · " + HandballKpiHelper.FormatPerMatchContext(totalSaves, matches, "arrêts"),
                Max: 25)
        ];
    }

    // ── Brief : AVEC BALLON (gardienne uniquement) ──
    // 3 KPI : passes déc. · buts · pertes de balle
    private IReadOnlyList<BarGaugeKpiItem> BuildBriefBallKpis()
    {
        if (Profile is null || !Profile.IsGoalkeeper || Goalkeeper is null || Global is null)
        {
            return [];
        }

        var matches = Profile.MatchesPlayed;
        var turnovers = (Goalkeeper.PerteDeBalle) + (Goalkeeper.MauvaisePasse);

        return
        [
            new BarGaugeKpiItem(
                "Passes déc.",
                Goalkeeper.PasseDecisives.ToString(),
                Goalkeeper.PasseDecisives,
                "Passes directement suivies d'un but.",
                HandballKpiHelper.DirectActionsTone(HandballKpiHelper.PerMatch(Goalkeeper.PasseDecisives, matches), true),
                HandballKpiHelper.FormatPerMatchContext(Goalkeeper.PasseDecisives, matches, "passes"),
                Max: Math.Max(Goalkeeper.PasseDecisives + 2, 10)),
            new BarGaugeKpiItem(
                "Buts",
                Goalkeeper.Buts.ToString(),
                Goalkeeper.Buts,
