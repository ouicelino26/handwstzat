    private IReadOnlyList<PlayerGameAnalysisRow> FilteredGameRows
    {
        get
        {
            var rows = AllGameRows.AsEnumerable();

            // Fenêtre
            var sorted = rows.OrderBy(r => r.Identity.Date).ThenBy(r => r.Identity.MatchId).ToList();
            rows = GamesWindow switch
            {
                PlayerGamesWindow.Last5 => sorted.TakeLast(5),
                PlayerGamesWindow.Last10 => sorted.TakeLast(10),
                _ => sorted
            };

            // Résultat
            if (GamesResultFilter != PlayerGamesResultFilter.All)
            {
                var targetResult = GamesResultFilter switch
                {
                    PlayerGamesResultFilter.Win => PlayerMatchResult.Win,
                    PlayerGamesResultFilter.Draw => PlayerMatchResult.Draw,
                    PlayerGamesResultFilter.Loss => PlayerMatchResult.Loss,
                    _ => PlayerMatchResult.Unknown
                };
                rows = rows.Where(r => r.Identity.Result == targetResult);
            }

            // Recherche
            if (!string.IsNullOrWhiteSpace(GamesSearch))
            {
                var q = GamesSearch.Trim().ToLowerInvariant();
                rows = rows.Where(r =>
                    (r.Identity.OpponentName?.ToLowerInvariant().Contains(q) ?? false) ||
                    (r.Identity.CompetitionName?.ToLowerInvariant().Contains(q) ?? false) ||
                    (r.Identity.Season?.ToLowerInvariant().Contains(q) ?? false) ||
                    r.Identity.Day.ToString().Contains(q));
            }

            // Tri
            rows = GamesSort switch
            {
                "date_asc" => rows.OrderBy(r => r.Identity.Date),
                "date_desc" => rows.OrderByDescending(r => r.Identity.Date),
                "goals_desc" => rows.OrderByDescending(r => r.FieldMetrics?.Goals ?? r.GkMetrics?.Saves ?? 0),
                "time_desc" => rows.OrderByDescending(r => r.PlayingTime.Minutes ?? -1),
                _ => rows.OrderByDescending(r => r.Identity.Date)
            };

            return rows.ToList();
        }
    }

