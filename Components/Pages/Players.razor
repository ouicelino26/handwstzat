    private static string? ResolveFlagAssetUrl(string? nationality)
    {
        if (string.IsNullOrWhiteSpace(nationality))
        {
            return null;
        }

        var key = NormalizeAssetKey(nationality);
        var sourceFileName = FlagFileByKey.TryGetValue(key, out var mappedFile)
            ? mappedFile
            : $"{nationality.Trim()}.png";
        var fileName = ToSafeFlagFileName(sourceFileName);

        return $"/images/flags/{fileName}";
    }

    private static string? ResolveImageAssetUrl(string? value, string localFolder)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return null;
        }

        var cleanValue = value.Trim().Replace('\\', '/');
        if (cleanValue.StartsWith("http://", StringComparison.OrdinalIgnoreCase)
            || cleanValue.StartsWith("https://", StringComparison.OrdinalIgnoreCase))
        {
            return cleanValue;
        }

        if (cleanValue.StartsWith("/", StringComparison.Ordinal))
        {
            return EscapeAssetPath(cleanValue);
        }

        if (cleanValue.StartsWith("images/", StringComparison.OrdinalIgnoreCase))
        {
            return EscapeAssetPath("/" + cleanValue);
        }

        var fileName = cleanValue.Split('/', StringSplitOptions.RemoveEmptyEntries).LastOrDefault() ?? cleanValue;
        return $"{localFolder}/{EscapePathSegment(fileName)}";
    }

    private static string EscapeAssetPath(string path)
    {
        var prefix = path.StartsWith("/", StringComparison.Ordinal) ? "/" : string.Empty;
        var segments = path.TrimStart('/').Split('/', StringSplitOptions.RemoveEmptyEntries);
        return prefix + string.Join("/", segments.Select(EscapePathSegment));
    }

    private static string EscapePathSegment(string segment)
    {
        return Uri.EscapeDataString(segment);
    }

    private static string ToSafeFlagFileName(string value)
    {
        var stem = System.IO.Path.GetFileNameWithoutExtension(value);
        if (string.IsNullOrWhiteSpace(stem))
        {
            stem = value;
        }

        var decomposed = stem.Trim().Normalize(NormalizationForm.FormD);
        var builder = new StringBuilder(decomposed.Length);
        var previousWasSeparator = false;

        foreach (var character in decomposed)
        {
            if (CharUnicodeInfo.GetUnicodeCategory(character) == UnicodeCategory.NonSpacingMark)
            {
                continue;
            }

            var lower = char.ToLowerInvariant(character);
            if ((lower >= 'a' && lower <= 'z') || char.IsDigit(lower))
            {
                builder.Append(lower);
                previousWasSeparator = false;
                continue;
            }

            if (!previousWasSeparator)
            {
                builder.Append('-');
                previousWasSeparator = true;
            }
        }

        var slug = builder.ToString().Trim('-');
        return string.IsNullOrWhiteSpace(slug) ? "unknown.png" : $"{slug}.png";
    }

    private static string NormalizeAssetKey(string value)
    {
        var decomposed = value.Trim().Normalize(NormalizationForm.FormD);
        var builder = new StringBuilder(decomposed.Length);
        var previousWasSpace = false;

        foreach (var character in decomposed)
        {
            if (CharUnicodeInfo.GetUnicodeCategory(character) == UnicodeCategory.NonSpacingMark)
            {
                continue;
            }

            if (char.IsLetterOrDigit(character))
            {
                builder.Append(char.ToLowerInvariant(character));
                previousWasSpace = false;
                continue;
            }

            if (!previousWasSpace)
            {
                builder.Append(' ');
                previousWasSpace = true;
            }
        }

        return builder.ToString().Trim();
    }

    private static string GetInitials(string? fullName)
    {
        var parts = (fullName ?? "?").Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return string.Concat(parts.Take(2).Select(part => char.ToUpperInvariant(part[0])));
    }

