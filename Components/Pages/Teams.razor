@page "/teams"
@inject ReferenceDataService ReferenceDataService
@inject StatsApiClient StatsApiClient
@inject MatchesApiClient MatchesApiClient
@inject MatchEventsApiClient MatchEventsApiClient
@inject IApiAuthService AuthService
@inject AnalysisScopeService ScopeService
@inject CommandBarService CommandBarService
@implements IDisposable

<PageTitle>Squads</PageTitle>

<div class="squad-workspace" data-workspace="squads">
    @if (!AuthService.Session.IsAuthenticated)
    {
        <AccessRequiredCard Message="Connectez-vous pour ouvrir les bilans d'equipe et la production des joueuses." />
    }
    else
    {
        <div class="studio-subtoolbar">
            <div class="studio-subtoolbar__spacer"></div>
            <button type="button" class="btn btn-ghost btn-sm" @onclick="() => _filterOpen = true">
                <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" style="fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;flex-shrink:0"><path d="M4 6h16M7 12h10M10 18h4"></path></svg>
                Filtrer
            </button>
        </div>

        @if (_filterOpen)
        {
            <div class="filter-drawer-overlay" @onclick="CloseFilterDrawer" role="dialog" aria-modal="true" aria-label="Filtres équipes">
                <div class="filter-drawer" @onclick:stopPropagation="true">
                    <header class="filter-drawer__head">
                        <h3 class="filter-drawer__title">Filtres</h3>
                        <button type="button" class="filter-drawer__close" @onclick="CloseFilterDrawer">×</button>
                    </header>
                    <div class="filter-drawer__body">
                        <div class="filter-section">
                            <span class="filter-section__label">Équipe</span>
                            <select class="form-select" @bind="TeamId" @bind:after="OnScopeSelectionChangedAsync">
                                <option value="">Sélectionner une équipe…</option>
                                @foreach (var team in AvailableTeams)
                                {
                                    <option value="@team.TeamId">@team.TeamName</option>
                                }
                            </select>
                        </div>
                        <div class="filter-section">
                            <span class="filter-section__label">Compétition</span>
                            <select class="form-select" @bind="CompetitionId" @bind:after="OnScopeSelectionChangedAsync">
                                <option value="">Toutes</option>
                                @foreach (var competition in AvailableCompetitions)
                                {
                                    <option value="@competition.CompetitionId">@competition.CompetitionName</option>
                                }
                            </select>
                        </div>
                        <div class="filter-section">
                            <span class="filter-section__label">Saison</span>
                            <select class="form-select" @bind="Season" @bind:after="OnScopeSelectionChangedAsync">
                                <option value="">Toutes</option>
                                @foreach (var season in SeasonOptions)
                                {
                                    <option value="@season">@season</option>
                                }
                            </select>
                        </div>
                        <div class="filter-section">
                            <span class="filter-section__label">Journée</span>
                            <select class="form-select" @bind="Day" @bind:after="OnScopeSelectionChangedAsync">
                                <option value="">Toutes</option>
                                @foreach (var day in DayOptions)
                                {
                                    <option value="@day">@day</option>
                                }
                            </select>
                        </div>
                        @if (ActiveSection == "roster")
                        {
                            <div class="filter-section">
                                <span class="filter-section__label">Poste effectif</span>
                                <select class="form-select" @bind="PositionId" @bind:after="OnRosterScopeChangedAsync">
                                    <option value="">Tous</option>
                                    @foreach (var position in AvailablePositions)
                                    {
                                        <option value="@position.Id">@position.Name</option>
                                    }
                                </select>
                            </div>
                        }
                    </div>
                    <footer class="filter-drawer__foot">
                        <div class="filter-drawer__foot-actions">
                            <button type="button" class="ghost-button" @onclick="async () => { await ResetAsync(); CloseFilterDrawer(); }">Réinitialiser</button>
                            <button type="button" class="primary-button" @onclick="CloseFilterDrawer">Appliquer</button>
                        </div>
                    </footer>
                </div>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <StateCard Kicker="Erreur"
                       Title="Impossible de charger l'équipe"
                       Message="@ErrorMessage"
                       Tone="error" />
        }
        else if (IsBusy && TeamStats is null)
        {
            <StateCard Kicker="Chargement"
                       Title="Mise à jour du bilan d'équipe"
                       Message="Les KPI, joueuses et matchs se recalculent pour le contexte choisi."
                       Tone="loading" />
        }
        else if (TeamStats is null)
        {
            <StateCard Kicker="Aucune équipe"
                       Title="Choisissez une équipe pour charger son bilan"
                       Message="Utilisez le bouton Filtrer pour sélectionner une équipe, une compétition ou une saison."
                       Tone="empty" />
        }
        else
        {
            @if (IsBusy)
            {
                <PageLoader Kicker="Chargement"
                            Title="Actualisation de l'équipe"
                            Message="Les statistiques collectives et les graphes se recalculent." />
            }

            <div class="team-profile" style="margin-bottom:1.75rem;">
                <div class="team-code-badge">
                    @if (!string.IsNullOrWhiteSpace(SelectedTeamLogoUrl))
                    {
                        <img src="@SelectedTeamLogoUrl"
                             alt="@($"Logo {TeamStats.TeamName}")"
                             loading="lazy"
                             onerror="this.onerror=null;this.src=this.src.includes('/2025-2026/')?this.src.replace('/2025-2026/','/2024-2025/'):this.src.replace('/2024-2025/','/2025-2026/');" />
                    }
                    else
                    {
                        <span>@(TeamStats.TeamCode ?? "HWS")</span>
                    }
                </div>
                <div class="team-profile__info">
                    <div class="team-profile__code">@(CompetitionId.HasValue ? AvailableCompetitions.FirstOrDefault(c => c.CompetitionId == CompetitionId.Value)?.CompetitionName ?? "Toutes compétitions" : "Toutes compétitions") · @(Season ?? "Toutes saisons")</div>
                    <div class="team-profile__name">@TeamStats.TeamName</div>
                    <div class="team-profile__record">
                        <span class="badge badge--fort">@TeamStats.Wins V</span>
                        <span class="badge badge--neutral">@TeamStats.Draws N</span>
                        <span class="badge badge--faible">@TeamStats.Losses D</span>
                        <span class="text-muted" style="font-size:0.8125rem;">· @TeamStats.MatchesPlayed matchs joués</span>
                    </div>
                </div>
            </div>

            <div class="section-header">
                <div class="section-header__badge"></div>
                <h3 class="section-header__title">Bilan saison</h3>
            </div>
            <div class="stats-grid stats-grid--compact" style="margin-bottom:2rem;">
                <div class="stats-grid__item">
                    <span class="stats-grid__value">@TeamStats.MatchesPlayed</span>
                    <span class="stats-grid__label">Matchs</span>
                </div>
                <div class="stats-grid__item">
                    <span class="stats-grid__value">@TeamStats.Wins</span>
                    <span class="stats-grid__label">Victoires</span>
                </div>
                <div class="stats-grid__item">
                    <span class="stats-grid__value">@TeamStats.Draws</span>
                    <span class="stats-grid__label">Nuls</span>
                </div>
                <div class="stats-grid__item">
                    <span class="stats-grid__value">@TeamStats.Losses</span>
                    <span class="stats-grid__label">Défaites</span>
                </div>
                <div class="stats-grid__item stats-grid__item--positive">
                    <span class="stats-grid__value">@TeamStats.GoalsFor</span>
                    <span class="stats-grid__label">Buts marqués</span>
                </div>
                <div class="stats-grid__item stats-grid__item--negative">
                    <span class="stats-grid__value">@TeamStats.GoalsAgainst</span>
                    <span class="stats-grid__label">Buts encaissés</span>
                </div>
                <div class="stats-grid__item">
                    <span class="stats-grid__value">@TeamStats.Overview.AssistCount</span>
                    <span class="stats-grid__label">Passes déc.</span>
                </div>
                <div class="stats-grid__item">
                    <span class="stats-grid__value">@TeamStats.Overview.InterceptionCount</span>
                    <span class="stats-grid__label">Interceptions</span>
                </div>
            </div>

            @if (ShowTeamSummaryKpis)
            {
                <div class="section-header">
                    <div class="section-header__badge"></div>
                    <h3 class="section-header__title">Indicateurs clés</h3>
                </div>
                <div style="margin-bottom:2rem;">
                    <KpiTileGrid Items="@TeamKpis" />
                </div>
            }

            @if (ShowTeamSummaryCharts)
            {
                <div class="charts-row">
                    <div class="chart-card">
                        <div class="section-header" style="margin-bottom:0.875rem;">
                            <h3 class="section-header__title">Contribution aux buts</h3>
                        </div>
                        <ApexChart @key="TeamId" TItem="SliceValue" Height="310" Options="@GetTeamContributionChartOptions()">
                            <ApexPointSeries TItem="SliceValue"
                                             Items="@TeamContributionDistribution"
                                             Name="Contribution"
                                             SeriesType="SeriesType.Donut"
                                             XValue="slice => slice.Label"
                                             YValue="slice => (decimal?)slice.Value" />
                        </ApexChart>
                    </div>
                    <div class="chart-card">
                        <div class="section-header" style="margin-bottom:0.875rem;">
                            <h3 class="section-header__title">Profil collectif</h3>
                        </div>
                        <ApexChart TItem="MetricPlotPoint" Height="310" Options="@GetTeamProfileChartOptions()">
                            <ApexPointSeries TItem="MetricPlotPoint"
                                             Items="@TeamProfileSeries"
                                             Name="@TeamStats.TeamName"
                                             SeriesType="SeriesType.Bar"
                                             XValue="point => point.Label"
                                             YValue="point => (decimal?)point.Value" />
                        </ApexChart>
                    </div>
                </div>
            }

            @if (ShowTeamAnalystPanels)
            {
                <div class="chart-card" style="margin-bottom:2rem;">
                    <div class="section-header" style="margin-bottom:0.875rem;">
                        <h3 class="section-header__title">Joueuses décisives</h3>
                        <span class="badge badge--neutral" style="margin-left:auto;">Actions directes / match</span>
                    </div>
                    <ApexChart TItem="MetricPlotPoint" Height="310" Options="@GetTeamImpactChartOptions()">
                        <ApexPointSeries TItem="MetricPlotPoint"
                                         Items="@TeamPlayerImpactSeries"
                                         Name="Actions directes"
                                         SeriesType="SeriesType.Bar"
                                         XValue="point => point.Label"
                                         YValue="point => (decimal?)point.Value" />
                    </ApexChart>
                </div>
            }

            <div class="section-header">
                <div class="section-header__badge"></div>
                <h3 class="section-header__title">Effectif &amp; résultats</h3>
            </div>
            <div class="tabs-wrapper">
                <div class="tab-bar tab-bar--raised">
                    <button type="button"
                            class="tab @(ActiveSection == "roster" ? "active" : string.Empty)"
                            @onclick='() => SetActiveSection("roster")'
                            disabled="@IsBusy">
                        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                        Effectif
                    </button>
                    <button type="button"
                            class="tab @(ActiveSection == "matches" ? "active" : string.Empty)"
                            @onclick='() => SetActiveSection("matches")'
                            disabled="@IsBusy">
                        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>
                        Games
                        @if (TeamMatches.Count > 0)
                        {
                            <span class="tab__count">@TeamMatches.Count</span>
                        }
                    </button>
                </div>

                @if (ActiveSection == "roster")
                {
                    <div class="tab-panel active">
                        @{
                            var topPerformers = TeamPlayers
                                .OrderByDescending(p => HandballKpiHelper.DirectContributions(p))
                                .Take(4).ToList();
                            var extraPerformers = TeamPlayers
                                .OrderByDescending(p => HandballKpiHelper.DirectContributions(p))
                                .Skip(4).ToList();
                        }
                        @if (topPerformers.Count > 0)
                        {
                            <section class="team-performers-section" aria-labelledby="team-performers-title">
                                <div class="team-performers-section__header">
                                    <div>
                                        <span class="team-performers-section__eyebrow">Joueuses clés</span>
                                        <h3 id="team-performers-title">Lecture rapide de l'effectif</h3>
                                        <p>Les joueuses les plus impactantes avant le tableau complet.</p>
                                    </div>
                                    @if (extraPerformers.Count > 0)
                                    {
                                        <button type="button" class="btn btn-ghost btn-sm" @onclick="ToggleAllPerformers">
                                            @(_showAllPerformers ? "Réduire" : "Voir toutes les joueuses")
                                        </button>
                                    }
                                </div>
                                <div class="team-performer-grid">
                                    @foreach (var player in topPerformers)
                                    {
                                        @PerformerCard(player)
                                    }
                                    @if (_showAllPerformers)
                                    {
                                        @foreach (var player in extraPerformers)
                                        {
                                            @PerformerCard(player)
                                        }
                                    }
                                </div>
                            </section>
                        }

                        @{
                            var rosterRows = FilteredRosterPlayers.ToArray();
                        }
                        <div class="table-wrapper" style="border:none;border-radius:0;">
                            <div style="padding:0.75rem 1rem 0;">
                                <label class="filter-field table-search">
                                    <span>Filtrer le tableau</span>
                                    <input value="@RosterSearch" @oninput="OnRosterSearchChanged" placeholder="Joueuse, poste ou équipe" />
                                </label>
                            </div>
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        <th class="col-jersey-num">#</th>
                                        <th>@TableHeader("name", "Joueuse", SetRosterSort)</th>
                                        <th>@TableHeader("position", "Poste", SetRosterSort)</th>
                                        <th class="numeric">@TableHeader("matches", "Matchs", SetRosterSort)</th>
                                        <th class="numeric">@TableHeader("goals", "Buts", SetRosterSort)</th>
                                        <th class="numeric">@TableHeader("assists", "Passes", SetRosterSort)</th>
                                        <th class="numeric">@TableHeader("interceptions", "Intercept.", SetRosterSort)</th>
                                        <th class="numeric">@TableHeader("saves", "Arrêts", SetRosterSort)</th>
                                        <th class="numeric">@TableHeader("turnovers", "Pertes", SetRosterSort)</th>
                                        <th class="numeric">@TableHeader("shot", "Eff. %", SetRosterSort)</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var player in rosterRows)
                                    {
                                        <tr>
                                            <td class="col-jersey-num">@(player.Number?.ToString() ?? "—")</td>
                                            <td>
                                                <div class="player-cell">
                                                    <div class="player-cell__avatar">
                                                        <span>@GetInitials(player.FullName)</span>
                                                    </div>
                                                    <span class="player-cell__name">@player.FullName</span>
                                                </div>
                                            </td>
                                            <td><span class="badge badge--neutral">@(player.PositionCode ?? player.PositionName ?? "-")</span></td>
                                            <td class="numeric">@player.MatchesPlayed</td>
                                            <td class="numeric @TableHeatToneHelper.HeatClass(rosterRows, row => (double?)row.TotalGoals, player)" style="font-family:var(--font-display);font-weight:700;">@player.TotalGoals</td>
                                            <td class="numeric @TableHeatToneHelper.HeatClass(rosterRows, row => (double?)row.AssistCount, player)">@player.AssistCount</td>
                                            <td class="numeric @TableHeatToneHelper.HeatClass(rosterRows, row => (double?)row.InterceptionCount, player)">@player.InterceptionCount</td>
                                            <td class="numeric @TableHeatToneHelper.HeatClass(rosterRows, row => (double?)row.SaveCount, player)">@player.SaveCount</td>
                                            <td class="numeric @TableHeatToneHelper.HeatClass(rosterRows, row => (double?)row.TurnoverCount, player, higherIsBetter: false)">@player.TurnoverCount</td>
                                            <td class="numeric" title="@(player.IsGoalkeeper ? "% arrêts" : "% tir")">@(player.IsGoalkeeper ? (player.GoalkeeperSaveRate > 0 ? $"{FormatRate(player.GoalkeeperSaveRate)}%" : "—") : (player.ShotSuccessRate > 0 ? $"{FormatRate(player.ShotSuccessRate)}%" : "—"))</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
                else
                {
                    <div class="tab-panel active" style="padding:1.5rem;">
                        @if (TeamMatches.Count == 0)
                        {
                            <StateCard Kicker="Aucun match"
                                       Title="La sélection courante ne retourne aucune rencontre"
                                       Message="Essayez une autre équipe, une autre saison ou un autre jour."
                                       Tone="empty"
                                       CssClass="empty-card-inline" />
                        }
                        else
                        {
                            <div class="match-results-grid">
                                @foreach (var match in TeamMatches)
                                {
                                    var _isOurHome = string.Equals(match.Team1Name, TeamStats.TeamName, StringComparison.OrdinalIgnoreCase);
                                    var _scoreKnown = match.Team1Score.HasValue && match.Team2Score.HasValue;
                                    var _ourScore = _isOurHome ? (match.Team1Score ?? 0) : (match.Team2Score ?? 0);
                                    var _theirScore = _isOurHome ? (match.Team2Score ?? 0) : (match.Team1Score ?? 0);
                                    var _isWin = _scoreKnown && _ourScore > _theirScore;
                                    var _isLoss = _scoreKnown && _ourScore < _theirScore;
                                    var _homeLogoUrl = TeamLogoAssetResolver.ResolveByName(ReferenceData.Teams, match.Team1Name, Season);
                                    var _awayLogoUrl = TeamLogoAssetResolver.ResolveByName(ReferenceData.Teams, match.Team2Name, Season);
                                    <div class="result-card" @key="match.MatchId">
                                        <div class="result-card__header">
                                            <span>@(string.IsNullOrWhiteSpace(match.Day) ? "" : $"{match.Day} · ")@(match.CompetitionName ?? "Compétition")</span>
                                            <span>@(match.Date?.ToString("d MMM yyyy") ?? "")</span>
                                        </div>
                                        <div class="result-card__body">
                                            <span class="result-card__team" style="@(_isOurHome && _isWin ? "font-weight:700;color:var(--court-400);" : _isOurHome && _isLoss ? "font-weight:700;color:var(--danger-400);" : "")">
                                                @if (!string.IsNullOrWhiteSpace(_homeLogoUrl))
                                                {
                                                    <img class="result-team-logo" src="@_homeLogoUrl" alt="" loading="lazy" />
                                                }
                                                @match.Team1Name
                                            </span>
                                            <div class="result-card__score">
                                                <span class="@(_isOurHome && _isWin ? "result-card__score--win" : _isOurHome && _isLoss ? "result-card__score--loss" : "")">@(match.Team1Score.HasValue ? match.Team1Score.Value.ToString() : "—")</span>
                                                <span class="result-card__score-sep">–</span>
                                                <span class="@(!_isOurHome && _isWin ? "result-card__score--win" : !_isOurHome && _isLoss ? "result-card__score--loss" : "")">@(match.Team2Score.HasValue ? match.Team2Score.Value.ToString() : "—")</span>
                                            </div>
                                            <span class="result-card__team result-card__team--away" style="@(!_isOurHome && _isWin ? "font-weight:700;color:var(--court-400);" : !_isOurHome && _isLoss ? "font-weight:700;color:var(--danger-400);" : "")">
                                                @match.Team2Name
                                                @if (!string.IsNullOrWhiteSpace(_awayLogoUrl))
                                                {
                                                    <img class="result-team-logo" src="@_awayLogoUrl" alt="" loading="lazy" />
                                                }
                                            </span>
                                        </div>
                                        <div class="result-card__footer">
                                            <span class="badge @(_isWin ? "badge--fort" : _isLoss ? "badge--faible" : "badge--neutral")">@(_scoreKnown ? (_isWin ? "Victoire" : _isLoss ? "Défaite" : "Nul") : "Score N/D")</span>
                                            <a href="/matches?matchId=@match.MatchId" style="margin-left:auto;font-size:0.75rem;color:var(--text-muted);text-decoration:none;">Voir →</a>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        }
    }
</div>

@code {
    private AnalyticsReferenceData ReferenceData { get; set; } = AnalyticsReferenceData.Empty;
    private TeamStatsDto? TeamStats { get; set; }
    private MatchSummaryDto? SelectedMatchSummary { get; set; }
    private IReadOnlyList<PlayerGlobalStatsDto> TeamPlayers { get; set; } = [];
    private IReadOnlyList<PlayerGlobalStatsDto> RosterPlayers { get; set; } = [];
    private IReadOnlyList<MatchListItemDto> CompetitionOptionMatches { get; set; } = [];
    private IReadOnlyList<MatchListItemDto> TeamOptionMatches { get; set; } = [];
    private IReadOnlyList<MatchListItemDto> ScopedMatches { get; set; } = [];
    private IReadOnlyList<MatchListItemDto> TeamMatches { get; set; } = [];
    private IReadOnlyList<ScoreTimelinePoint> SelectedMatchTimeline { get; set; } = [];
    private bool IsBusy { get; set; }
    private bool IsSelectedMatchLoading { get; set; }
    private string? ErrorMessage { get; set; }
    private int? TeamId { get; set; }
    private int? CompetitionId { get; set; }
    private int? PositionId { get; set; }
    private int? Year { get; set; }
    private string? Season { get; set; }
    private string? Day { get; set; }
    private int? SelectedMatchId { get; set; }
    private long SelectedMatchLoadToken { get; set; }
    private string ActiveSection { get; set; } = "roster";
    private string ActiveLens { get; set; } = AudienceLens.Club;
    private string RosterSearch { get; set; } = string.Empty;
    private TableSortState RosterSort { get; set; } = new("goals", SortDirection.Desc);
    private bool _publishingScope;
    private bool _filterOpen;
    private bool _showAllPerformers;

    [Parameter, SupplyParameterFromQuery(Name = "teamId")]
    public int? TeamIdFromQuery { get; set; }

    private MatchListItemDto? SelectedMatch => TeamMatches.FirstOrDefault(match => match.MatchId == SelectedMatchId);
    private IReadOnlyList<string> SeasonOptions => MatchFilterCatalog.GetSeasons(ScopedMatches);
    private IReadOnlyList<string> DayOptions => MatchFilterCatalog.GetDays(ScopedMatches, Season);
    private IReadOnlyList<CompetitionDto> AvailableCompetitions => SmartFilterCatalog.GetCompetitions(
        ReferenceData,
        MatchFilterCatalog.ApplySeasonAndDay(CompetitionOptionMatches, Season, Day),
        TeamId.HasValue || !string.IsNullOrWhiteSpace(Season) || !string.IsNullOrWhiteSpace(Day));
    private IReadOnlyList<TeamDto> AvailableTeams => SmartFilterCatalog.GetTeams(
        ReferenceData,
        MatchFilterCatalog.ApplySeasonAndDay(TeamOptionMatches, Season, Day),
        CompetitionId.HasValue || !string.IsNullOrWhiteSpace(Season) || !string.IsNullOrWhiteSpace(Day));
    private string? SelectedTeamLogoUrl => TeamLogoAssetResolver.ResolveByTeam(
        TeamStats is null
            ? null
            : ReferenceData.Teams.FirstOrDefault(team => team.TeamId == TeamStats.TeamId),
        Season);
    private IReadOnlyList<LookupItemDto> AvailablePositions => SmartFilterCatalog.GetPositions(ReferenceData.Positions, RosterPlayers, PositionId.HasValue || TeamPlayers.Count > 0);
    private IReadOnlyList<ScopeSummaryItem> TeamScopeItems =>
    [
        new(
            "Equipe",
            TeamId.HasValue
                ? AvailableTeams.FirstOrDefault(item => item.TeamId == TeamId.Value)?.TeamName ?? "Selection"
                : "Selectionner"),
        new(
            "Competition",
            CompetitionId.HasValue
                ? AvailableCompetitions.FirstOrDefault(item => item.CompetitionId == CompetitionId.Value)?.CompetitionName ?? "Selection"
                : "Toutes"),
        new("Saison", string.IsNullOrWhiteSpace(Season) ? "Toutes" : Season),
        new("Journee", string.IsNullOrWhiteSpace(Day) ? "Toutes" : Day),
        new("Onglet", ActiveSection == "roster" ? "Effectif" : "Matchs")
    ];
    private IReadOnlyList<ScopeSummaryItem> SelectedTeamScopeItems => TeamStats is null
        ? []
        :
        [
            new("Equipe", TeamStats.TeamName ?? "Equipe"),
            new("Matchs", TeamStats.MatchesPlayed.ToString()),
            new("Buts pour", TeamStats.GoalsFor.ToString()),
            new("Buts contre", TeamStats.GoalsAgainst.ToString()),
            new("Effectif", TeamPlayers.Count.ToString()),
            new("Sections", ActiveSection == "roster" ? "Vue effectif" : "Vue match")
        ];
