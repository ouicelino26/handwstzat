        var rating = FormatRating(player);
        var heroLabel = isGk ? "Arrêts" : "Buts";
        var heroValue = isGk ? player.SaveCount : player.TotalGoals;
        var effRate = isGk ? player.GoalkeeperSaveRate : player.ShotSuccessRate;
        var effLabel = isGk ? "arrêt" : "tir";

        builder.OpenElement(0, "article");
        builder.AddAttribute(1, "class", cardClass);
        builder.AddMarkupContent(2, $"""
            <div class="team-performer-card__header">
                <div class="team-performer-card__avatar"><span>{System.Net.WebUtility.HtmlEncode(GetInitials(player.FullName))}</span></div>
                <div class="team-performer-card__identity">
                    <span class="team-performer-card__position">{System.Net.WebUtility.HtmlEncode(player.PositionCode ?? player.PositionName ?? "?")}</span>
                    <h4>{System.Net.WebUtility.HtmlEncode(player.FullName)}</h4>
                    <span class="team-performer-card__team">{System.Net.WebUtility.HtmlEncode(player.TeamName ?? "")}</span>
                </div>
                <span class="team-performer-card__rating">{System.Net.WebUtility.HtmlEncode(rating)}</span>
            </div>
            <div class="team-performer-card__hero">
                <div>
                    <span class="team-performer-card__hero-label">{heroLabel}</span>
                    <strong>{heroValue}</strong>
                </div>
                <div class="team-performer-card__efficiency">
                    <strong>{FormatRate(effRate)}%</strong>
                    <span>{effLabel}</span>
                </div>
            </div>
            <div class="team-performer-card__stats">
                <div><strong>{player.AssistCount}</strong><span>Passes</span></div>
                <div><strong>{player.InterceptionCount}</strong><span>Inter.</span></div>
                <div><strong>{player.TurnoverCount}</strong><span>Pertes</span></div>
                <div><strong>{player.MatchesPlayed}</strong><span>Matchs</span></div>
