    private static string GetInitials(string? name) =>
        string.Concat((name ?? "?").Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(part => char.ToUpperInvariant(part[0])));

    private static string GetPerformerSignal(PlayerGlobalStatsDto player)
    {
        var isGk = player.IsGoalkeeper;
        if (isGk) return "Impact gardienne";
        if (player.AssistCount > player.TotalGoals && player.AssistCount > player.InterceptionCount) return "Création centrale";
        if (player.InterceptionCount > player.TotalGoals) return "Défense solide";
        if (player.TotalGoals > 20) return "Leader offensive";
        return "Joueuse clé";
    }

    private static string FormatRating(PlayerGlobalStatsDto player)
    {
        var contributions = HandballKpiHelper.DirectContributions(player);
        var perMatch = player.MatchesPlayed > 0 ? contributions / player.MatchesPlayed : 0;
        return (Math.Min(perMatch, 9.9)).ToString("0.0");
    }

    private RenderFragment PerformerCard(PlayerGlobalStatsDto player) => builder =>
    {
        var isGk = player.IsGoalkeeper;
        var isDefense = !isGk && player.InterceptionCount > player.TotalGoals;
