    private static string BuildFinalScoreLabel(MatchListItemDto match, IReadOnlyList<ScoreTimelinePoint> timeline)
    {
        var s1 = match.Team1Score ?? timeline.LastOrDefault()?.Team1Score;
        var s2 = match.Team2Score ?? timeline.LastOrDefault()?.Team2Score;
        return s1.HasValue && s2.HasValue ? $"{s1.Value} - {s2.Value}" : "— - —";
    }

    protected override async Task OnInitializedAsync()
    {
        CommandBarService.Register(() => { _filterOpen = !_filterOpen; StateHasChanged(); return Task.CompletedTask; });

