<nav class="studio-domain-nav" aria-label="Domaines principaux">
    @foreach (var item in AppNavigationCatalog.Primary)
    {
        <NavLink href="@item.Href"
                 Match="@item.Match"
                 class="studio-nav-item"
                 @onclick="NotifyNavigationAsync"
                 title="@item.Label"
                 aria-label="@item.Label">
            <span class="studio-nav-item__index" aria-hidden="true">@item.Index</span>
            <span class="studio-nav-item__icon" aria-hidden="true">@((MarkupString)item.IconMarkup)</span>
            <span class="studio-nav-item__label">@item.Label</span>
            <span class="studio-nav-item__kicker">@item.Kicker</span>
        </NavLink>
    }
</nav>

@code {
    [Parameter]
    public EventCallback OnNavigate { get; set; }

    private Task NotifyNavigationAsync() => OnNavigate.InvokeAsync();
}
