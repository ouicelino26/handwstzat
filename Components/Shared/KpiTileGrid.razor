@if (Items.Count > 0)
{
    <div class="kpi-tile-grid @CssClass" role="list" aria-label="Indicateurs cles">
        @foreach (var item in Items)
        {
            <div class="kpi-tile @GetColorModifier(item.Tone)" role="listitem">
                <span class="kpi-tile__label">@KpiCopy.Label(item.Label)</span>
                <span class="kpi-tile__value">@item.Value</span>
                @{
                    var sub = KpiCopy.Caption(item.Caption);
                }
                @if (!string.IsNullOrWhiteSpace(sub))
                {
                    <span class="kpi-tile__sub">@sub</span>
                }
                @{
                    var ctx = KpiCopy.Context(item.Context);
                }
                @if (!string.IsNullOrWhiteSpace(ctx))
                {
                    <span class="kpi-tile__sub">@ctx</span>
                }
            </div>
        }
    </div>
}

@code {
    [Parameter] public IReadOnlyList<KpiTile> Items { get; set; } = [];
    [Parameter] public string CssClass { get; set; } = string.Empty;

    private static string GetColorModifier(string tone) => tone?.ToLowerInvariant() switch
    {
        "positive" => "kpi-tile--court",
        "good"     => "kpi-tile--electric",
        "warning"  => "kpi-tile--warning",
        "danger"   => "kpi-tile--danger",
        _          => string.Empty
    };
}
