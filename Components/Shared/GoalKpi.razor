@using System.Globalization

<div class="court-studio @(IsLoading ? "is-loading" : string.Empty)" aria-busy="@(IsLoading ? "true" : "false")">
    @if (!HideModeBar)
    {
        <header class="court-studio__head">
            <div>
                <span>Analyse spatiale</span>
                <h3>Zones et declenchements</h3>
                <p>Selectionnez un secteur pour isoler son volume, son efficacite et ses issues.</p>
            </div>

            <div class="court-studio__modes" role="group" aria-label="Filtre spatial">
                <button type="button"
                        class="map-mode-button @(IsViewModeActive(ViewModeBoth) ? "is-active" : string.Empty)"
                        aria-pressed="@(IsViewModeActive(ViewModeBoth))"
                        @onclick="() => SetViewModeAsync(ViewModeBoth)">
                    Les deux
                </button>
                <button type="button"
                        class="map-mode-button @(IsViewModeActive(ViewModeGoal) ? "is-active" : string.Empty)"
                        aria-pressed="@(IsViewModeActive(ViewModeGoal))"
                        @onclick="() => SetViewModeAsync(ViewModeGoal)">
                    Buts
                </button>
                <button type="button"
                        class="map-mode-button @(IsViewModeActive(ViewModeTrigger) ? "is-active" : string.Empty)"
                        aria-pressed="@(IsViewModeActive(ViewModeTrigger))"
                        @onclick="() => SetViewModeAsync(ViewModeTrigger)">
                    Déclenchements
                </button>
            </div>
        </header>
    }

    @if (HideZeroZones)
    {
        <p class="tiny-note spatial-focus-note">Vue ciblee: seules les zones actives et la zone selectionnee restent visibles.</p>
    }

    @if (IsLoading)
    {
        <p class="tiny-note spatial-loading-note">Chargement des zones associees...</p>
    }

    @if (ShowGoalMap && ShowTriggerMap)
    {
        @* Mode "Les deux" : but en haut, terrain de déclenchement en dessous dans le même panneau *@
        <section class="court-stage court-stage--combined">
            <header class="court-stage__head">
                <div>
                    <span>Vue combinée</span>
                    <h4>But · Déclenchements</h4>
                </div>

                <div class="heat-legend">
                    <span>@LegendStartLabel</span>
                    <span>@LegendMiddleLabel</span>
                    <span>@LegendEndLabel</span>
                </div>
            </header>

            <div class="court-stage__sub-head" aria-hidden="true">
                <span class="court-stage__sub-label">Précision par secteur du but</span>
            </div>

            <div class="goal-map-wrap">
                <svg class="goal-map" viewBox="0 0 1288 617" role="img" aria-label="Carte de precision du but">
                    <defs>
                        <linearGradient id="gkpi-grad-right" x1="963.25" y1="161" x2="963.25" y2="623" gradientUnits="userSpaceOnUse">
                            <stop stop-color="#B7D5C8" />
                            <stop offset="1" stop-color="#B7D5C8" stop-opacity="0" />
                        </linearGradient>
                        <linearGradient id="gkpi-grad-top" x1="641.5" y1="159" x2="641.5" y2="245" gradientUnits="userSpaceOnUse">
                            <stop stop-color="#B7D5C8" />
                            <stop offset="1" stop-color="#B7D5C8" stop-opacity="0" />
                        </linearGradient>
                    </defs>
                    <title>Carte de precision du but</title>
                    <desc>Zones de tir avec taux de reussite par secteur du but</desc>
                    <rect width="1288" height="617" class="goal-bg" fill="white" pointer-events="none" />

                    @foreach (var zone in GoalGeometries)
                    {
                        var stat = GetGoalZone(zone.Key);
                        if (!ShouldRenderZone(zone.Key, stat))
                        {
                            continue;
                        }

                        if (zone.Shape == SvgShape.Rect)
                        {
                            <rect x="@Format(zone.X)"
                                  y="@Format(zone.Y)"
                                  width="@Format(zone.Width)"
                                  height="@Format(zone.Height)"
                                  rx="6"
                                  class="zone-shape @(IsActive(zone.Key) ? "zone-active" : string.Empty)"
                                  fill="@GetGoalFillColor(stat)"
                                  stroke="@GetStrokeColor(zone.Key)"
                                  stroke-width="@GetStrokeWidth(zone.Key)"
                                  role="button"
                                  tabindex="0"
                                  aria-label="@GetZoneAccessibleLabel(zone.Key)"
                                  aria-pressed="@IsZoneActive(zone.Key).ToString().ToLowerInvariant()"
                                  @onclick="() => SelectZoneAsync(zone.Key)"
                                  @onkeydown="@(e => HandleZoneKeyDownAsync(zone.Key, e))">
                                <title>@GetTooltip(zone.Key, stat)</title>
                            </rect>
                        }
                        else if (zone.Shape == SvgShape.Path)
                        {
                            <path d="@zone.Data"
                                  class="zone-shape @(IsActive(zone.Key) ? "zone-active" : string.Empty)"
                                  fill="@GetGoalFillColor(stat)"
                                  stroke="@GetStrokeColor(zone.Key)"
                                  stroke-width="@GetStrokeWidth(zone.Key)"
                                  role="button"
                                  tabindex="0"
                                  aria-label="@GetZoneAccessibleLabel(zone.Key)"
                                  aria-pressed="@IsZoneActive(zone.Key).ToString().ToLowerInvariant()"
                                  @onclick="() => SelectZoneAsync(zone.Key)"
                                  @onkeydown="@(e => HandleZoneKeyDownAsync(zone.Key, e))">
                                <title>@GetTooltip(zone.Key, stat)</title>
                            </path>
                        }
                        else
                        {
                            <polygon points="@zone.Data"
                                     class="zone-shape @(IsActive(zone.Key) ? "zone-active" : string.Empty)"
                                     fill="@GetGoalFillColor(stat)"
                                     stroke="@GetStrokeColor(zone.Key)"
                                     stroke-width="@GetStrokeWidth(zone.Key)"
                                     role="button"
                                     tabindex="0"
                                     aria-label="@GetZoneAccessibleLabel(zone.Key)"
                                     aria-pressed="@IsZoneActive(zone.Key).ToString().ToLowerInvariant()"
                                     @onclick="() => SelectZoneAsync(zone.Key)"
                                     @onkeydown="@(e => HandleZoneKeyDownAsync(zone.Key, e))">
                                <title>@GetTooltip(zone.Key, stat)</title>
                            </polygon>
                        }

                        <foreignObject x="@Format(zone.LabelX - 24)"
                                       y="@Format(zone.LabelY - 10)"
                                       width="48"
                                       height="20">
                            <div xmlns="http://www.w3.org/1999/xhtml" class="zone-label">
                                @GetLabel(stat)
                            </div>
                        </foreignObject>
                    }

                    @* Decorative overlay — pointer-events: none, sits above zones *@
                    <g pointer-events="none" aria-hidden="true">
                        @* Net horizontal lines *@
                        <path d="M393 244H897M393 293.4L897 287M393 343L897 337.5M393 392.4L897 388.5M393 442H897M393 487L897 491.4M393 541H897" stroke="#040000" stroke-width="0.5" />
                        @* Net vertical lines *@
                        <path d="M393 541V244M476.83 541V244M561 541V244M644.83 541V244M729 541V244M812.83 541V244M897 541V244" stroke="#040000" stroke-width="0.5" />
                        @* Top diagonal net lines *@
                        <path d="M256.5 163.5L392.5 246.5M351.875 162L476 244M446.75 162L560 244M643.5 162V244M826.5 161L729.5 244M923 161L813 246.5M1027.5 159.5L896.5 244" stroke="black" stroke-width="0.5" />
                        @* Right diagonal net lines *@
                        <path d="M1026.5 160L897 244M1031 231.5L897 286.243M1031 310L897 337.475M1027 388.5H897M1027.5 466.5L897 439.732M1027.5 544L897 490.757M1031 624L897 541" stroke="#090000" stroke-width="0.5" />
                        @* Top perspective lines *@
                        <path d="M258 164L1027 160M280 177.306L1004.5 174M302.5 190.667L984 187.5M324 203.973L964.5 200.5M346 217.333L940 216M367 230.64L918.5 229.5M393 244H898" stroke="#040000" stroke-width="0.5" />
                        @* Left depth lines (vertical) *@
                        <path d="M257 613V164M279.621 601.5V177.5M302.333 589V192M324.954 577V205M347.667 565.5V219M370.288 553V233M393 541V244" stroke="#040000" stroke-width="0.5" />
                        @* Left depth lines (horizontal) *@
                        <path d="M257 163.5L393 246.505M257 243L393 294.605M257 317L393 342.9M257 391H393M257 465L393 439.295M257 539L393 487.395M257 613L393 541" stroke="#020202" stroke-width="0.5" />
                        @* Right depth lines (vertical) *@
                        <path d="M897 541V244M918.789 554V229M940.667 568V215.5M961.5 581L964.5 200M984.333 595V187M1005 608V174M1028 622L1027 160" stroke="#040000" stroke-width="0.5" />
                        @* Left side shadow overlay *@
                        <path fill-rule="evenodd" clip-rule="evenodd" d="M258 164L393 246.5V541L258 613V164Z" fill="#0A1F38" fill-opacity="0.28" />
                        @* Right side shadow overlay *@
                        <path fill-rule="evenodd" clip-rule="evenodd" d="M1027 160L897.5 244.5V541L1027 624V160Z" fill="#0A1F38" fill-opacity="0.28" />
                        @* Top shadow overlay *@
                        <path fill-rule="evenodd" clip-rule="evenodd" d="M258 162.5L1025.5 160L898.5 244.5H393.143L258 162.5Z" fill="#05142E" fill-opacity="0.34" />
                        @* Right gradient highlight *@
                        <path d="M898 245L1026.5 161L1030 623L900 542L898 245Z" fill="url(#gkpi-grad-right)" />
                        @* Top gradient highlight *@
                        <path d="M257.5 163.5L1025.5 159L897.5 243.5L391 245L257.5 163.5Z" fill="url(#gkpi-grad-top)" />
                        @* Inner cage dark tint *@
                        <path fill-rule="evenodd" clip-rule="evenodd" d="M257 163H1031V622H257V163Z" fill="#030A1A" fill-opacity="0.1" />
                        @* Crossbar — red base then white dashes *@
                        <path d="M242 156.5L1030.96 152.5" stroke="#C71717" stroke-width="15" />
                        <path d="M242 156.5L1030.96 152.5" stroke="white" stroke-width="15" stroke-dasharray="60 60" />
                        @* Right post *@
                        <line x1="1035.5" y1="624" x2="1034.5" y2="145" stroke="#C71717" stroke-opacity="0.78" stroke-width="15" />
                        <line x1="1035.5" y1="624" x2="1034.5" y2="145" stroke="white" stroke-width="15" stroke-dasharray="60 60" />
                        @* Left post *@
                        <line x1="249.5" y1="613" x2="249.5" y2="153" stroke="#C71717" stroke-opacity="0.78" stroke-width="15" />
                        <line x1="249.5" y1="613" x2="249.5" y2="153" stroke="white" stroke-width="15" stroke-dasharray="60 60" />
                    </g>
                </svg>
            </div>

            <div class="court-stage__sub-head" aria-hidden="true">
                <span class="court-stage__sub-label">Zones de déclenchement</span>
            </div>

            <div class="pitch-map-wrap">
                <svg class="pitch-map" viewBox="0 0 227 150" overflow="hidden" fill="none" role="img" aria-label="Carte terrain des declenchements">
                    <title>Carte terrain des declenchements</title>
                    <desc>Zones de declenchement des tirs avec volume et efficacite par secteur</desc>
                    <g pointer-events="none" aria-hidden="true">
                        <rect width="225.888" height="149.184" transform="translate(226.395 149.183) rotate(179.805)" fill="#1B1B1B"/>
                        <path d="M199.016 29.683L226.236 126.683L1.04509 126.683L26.7795 29.683L199.016 29.683Z" fill="#1B1B1B" fill-opacity="0.65" stroke="white"/>
