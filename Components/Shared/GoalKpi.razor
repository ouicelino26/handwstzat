                        <path d="M99.3947 12.183L104.395 15.3222M99.3947 15.1896L104.395 17.1413M99.3947 17.9883L104.395 18.9678M99.3947 20.787L104.395 20.787M99.3947 23.5856L104.395 22.6135M99.3947 26.3843L104.395 24.4326M99.3947 29.183L104.395 26.441" stroke="white" stroke-width="0.5"/>
                        <path d="M99.3947 29.183L99.3947 12.183M100.226 28.7475L100.226 12.6941M101.061 28.2743L101.061 13.2431M101.893 27.8199L101.893 13.7353M102.728 27.3845L102.728 14.2654M103.56 26.9112L103.56 14.7954M104.395 26.4569L104.395 15.3157" stroke="white" stroke-width="0.5"/>
                        <path fill-rule="evenodd" clip-rule="evenodd" d="M99.3947 12.183L104.395 15.3066L104.395 26.4569L99.3947 29.183L99.3947 12.183Z" fill="#0A1F38" fill-opacity="0.28"/>
                        <path d="M99.3947 12.183L104.395 15.2842L104.395 26.1965L99.3947 29.183L99.3947 12.183Z" fill="#071422"/>
                        <path d="M125.395 12.183L120.395 15.3222M125.395 15.1896L120.395 17.1413M125.395 17.9883L120.395 18.9678M125.395 20.787L120.395 20.787M125.395 23.5856L120.395 22.6135M125.395 26.3843L120.395 24.4326M125.395 29.183L120.395 26.441" stroke="white" stroke-width="0.5"/>
                        <path d="M125.395 29.183L125.395 12.183M124.563 28.7475L124.563 12.6941M123.728 28.2743L123.728 13.2431M122.896 27.8199L122.896 13.7353M122.061 27.3845L122.061 14.2654M121.23 26.9112L121.23 14.7954M120.395 26.4569L120.395 15.3157" stroke="white" stroke-width="0.5"/>
                        <path fill-rule="evenodd" clip-rule="evenodd" d="M125.395 12.183L120.395 15.3066L120.395 26.4569L125.395 29.183L125.395 12.183Z" fill="#0A1F38" fill-opacity="0.28"/>
                        <path d="M125.395 12.183L120.395 15.2842L120.395 26.1965L125.395 29.183L125.395 12.183Z" fill="#071422"/>
                        <line x1="98.3947" y1="29.183" x2="98.3947" y2="11.183" stroke="white" stroke-width="2"/>
                        <line x1="98.3947" y1="29.183" x2="98.3947" y2="11.183" stroke="#E80B0B" stroke-width="2" stroke-dasharray="5 5"/>
                        <line x1="126.395" y1="29.183" x2="126.395" y2="11.183" stroke="white" stroke-width="2"/>
                        <line x1="126.395" y1="29.183" x2="126.395" y2="11.183" stroke="#E80B0B" stroke-width="2" stroke-dasharray="5 5"/>
                        <line x1="97.3947" y1="11.183" x2="127.395" y2="11.183" stroke="white" stroke-width="2"/>
                        <line x1="104.395" y1="26.533" x2="120.395" y2="26.533" stroke="white" stroke-width="0.3"/>
