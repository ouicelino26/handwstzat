                        <line x1="104.395" y1="24.533" x2="120.395" y2="24.533" stroke="white" stroke-width="0.3"/>
                        <line x1="104.395" y1="22.533" x2="120.395" y2="22.533" stroke="white" stroke-width="0.3"/>
                        <line x1="104.395" y1="20.833" x2="120.395" y2="20.833" stroke="white" stroke-width="0.3"/>
                        <path d="M101.395 13.183L123.895 13.183M102.605 14.0336L122.081 14.0336" stroke="white" stroke-width="0.3"/>
