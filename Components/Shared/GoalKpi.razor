                        <line x1="104.395" y1="15.2329" x2="120.395" y2="15.2329" stroke="white" stroke-width="0.3"/>
                        <path d="M116.393 15.1835L119.393 12.1835M118.393 15.1835L121.393 12.1835M111.394 15.1833L111.395 12.183" stroke="white" stroke-width="0.3"/>
                        <line x1="97.3947" y1="11.183" x2="127.395" y2="11.183" stroke="#E80B0B" stroke-width="2" stroke-dasharray="5 5"/>
                        <path fill-rule="evenodd" clip-rule="evenodd" d="M99.3959 12.1839L125.396 12.1833L120.896 15.1839L103.896 15.1839L99.3959 12.1839Z" fill="#05142E" fill-opacity="0.34"/>
                        <path d="M99.5531 12.183L125.396 12.1833L120.895 15.183L104.395 15.183L99.5531 12.183Z" fill="#05142E" fill-opacity="0.34"/>
                        <rect x="99.3947" y="12.183" width="26" height="1" fill="#080D14" fill-opacity="0.88"/>
                        <rect width="17" height="1" transform="matrix(0 -1 -1 0 100.395 29.183)" fill="#080D14" fill-opacity="0.88"/>
                        <rect width="17" height="1" transform="matrix(0 -1 -1 0 125.395 29.183)" fill="#080D14" fill-opacity="0.88"/>
                        <line x1="108.395" y1="58.433" x2="118.395" y2="58.433" stroke="white" stroke-width="1.5"/>
                        <path d="M0.394702 127.183L226.395 127.183L224.395 132.183L3.3947 132.183L0.394702 127.183Z" fill="#B3B3B3"/>
                        <path d="M141.395 126.683C141.395 124.647 140.67 122.632 139.263 120.751C137.856 118.871 135.794 117.162 133.194 115.723C130.594 114.283 127.507 113.142 124.11 112.363C120.713 111.584 117.072 111.183 113.395 111.183C109.718 111.183 106.077 111.584 102.68 112.363C99.2824 113.142 96.1958 114.283 93.5957 115.723C90.9957 117.162 88.9332 118.871 87.5261 120.751C86.1189 122.632 85.3947 124.647 85.3947 126.683L113.395 126.683L141.395 126.683Z" fill="#253AFF" fill-opacity="0.53" stroke="#B7AE11" stroke-width="1"/>
                    </g>
                    @foreach (var zone in TriggerGeometries)
                    {
                        var stat = GetTriggerZone(zone.Key);
                        if (!ShouldRenderZone(zone.Key, stat))
                        {
                            continue;
                        }

                        <path d="@zone.Data"
                              class="zone-shape trigger-zone @(IsActive(zone.Key) ? "zone-active" : string.Empty)"
                              fill="@GetTriggerFillColor(stat)"
                              stroke="@GetStrokeColor(zone.Key)"
                              stroke-width="@GetStrokeWidth(zone.Key)"
                              role="button"
                              tabindex="0"
                              aria-label="@GetZoneAccessibleLabel(zone.Key)"
                              aria-pressed="@IsZoneActive(zone.Key).ToString().ToLowerInvariant()"
                              @onclick="() => SelectZoneAsync(zone.Key)"
                              @onkeydown="@(e => HandleZoneKeyDownAsync(zone.Key, e))">
                            <title>@GetTooltip(zone.Key, stat)</title>
                        </path>
                        @if (stat.Attempts > 0)
                        {
                            @:<text x="@Format(zone.LabelX)" y="@Format(zone.LabelY)" text-anchor="middle" dominant-baseline="middle" pointer-events="none" font-size="5.5" font-weight="700" paint-order="stroke fill" stroke="#000000" stroke-width="1" stroke-linejoin="round" fill="white">@GetLabel(stat)</text>
                        }
                    }
                </svg>
            </div>
        </section>
    }
    else
    {
        @if (ShowGoalMap)
        {
            <section class="court-stage">
                <header class="court-stage__head">
                    <div>
                        <span>Goal frame</span>
                        <h4>Precision par secteur</h4>
                    </div>

                    <div class="heat-legend">
                        <span>@LegendStartLabel</span>
                        <span>@LegendMiddleLabel</span>
                        <span>@LegendEndLabel</span>
                    </div>
                </header>

                <div class="goal-map-wrap">
                    <svg class="goal-map" viewBox="0 0 1288 617" role="img" aria-label="Carte de precision du but">
                        <defs>
                            <linearGradient id="gkpi-grad-right-s" x1="963.25" y1="161" x2="963.25" y2="623" gradientUnits="userSpaceOnUse">
                                <stop stop-color="#B7D5C8" />
                                <stop offset="1" stop-color="#B7D5C8" stop-opacity="0" />
                            </linearGradient>
                            <linearGradient id="gkpi-grad-top-s" x1="641.5" y1="159" x2="641.5" y2="245" gradientUnits="userSpaceOnUse">
                                <stop stop-color="#B7D5C8" />
                                <stop offset="1" stop-color="#B7D5C8" stop-opacity="0" />
                            </linearGradient>
                        </defs>
                        <title>Carte de precision du but</title>
                        <desc>Zones de tir avec taux de reussite par secteur du but</desc>
                        <rect width="1288" height="617" class="goal-bg" fill="white" pointer-events="none" />

                        @foreach (var zone in GoalGeometries)
                        {
                            var stat = GetGoalZone(zone.Key);
                            if (!ShouldRenderZone(zone.Key, stat))
                            {
                                continue;
                            }

                            if (zone.Shape == SvgShape.Rect)
                            {
                                <rect x="@Format(zone.X)"
                                      y="@Format(zone.Y)"
                                      width="@Format(zone.Width)"
                                      height="@Format(zone.Height)"
                                      rx="6"
                                      class="zone-shape @(IsActive(zone.Key) ? "zone-active" : string.Empty)"
                                      fill="@GetGoalFillColor(stat)"
                                      stroke="@GetStrokeColor(zone.Key)"
                                      stroke-width="@GetStrokeWidth(zone.Key)"
                                      role="button"
                                      tabindex="0"
