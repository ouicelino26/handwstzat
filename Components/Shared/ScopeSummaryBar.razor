@using HandWStat.Models.Analytics

@if (Items.Count > 0)
{
    <div class="scope-summary-bar @CssClass">
        @for (int i = 0; i < Items.Count; i++)
        {
            @if (i > 0)
            {
                <div class="scope-summary-bar__divider" aria-hidden="true"></div>
            }
            <div class="scope-summary-bar__item">
                <span class="scope-summary-bar__label">@Items[i].Label</span>
                <span class="scope-summary-bar__value">@Items[i].Value</span>
            </div>
        }
    </div>
}

@code {
    [Parameter] public string? Kicker { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public string? Message { get; set; }
    [Parameter] public IReadOnlyList<ScopeSummaryItem> Items { get; set; } = [];
    [Parameter] public string CssClass { get; set; } = string.Empty;
}
