@using HandWStat.Services.Analytics

@if (Result is { Tier: QualityTier.Low })
{
    <span class="mqi mqi--low" title="Cette statistique repose sur peu d'actions et doit être interprétée avec prudence." role="img" aria-label="Qualité de données limitée">ⓘ</span>
}

@code {
    [Parameter] public QualityTierResult? Result { get; set; }
}
