@inherits AnalyseTabPanelBase

@if (!PlayerId.HasValue)
{
    <StateCard Kicker="En attente"
               Title="Selectionnez une joueuse pour ouvrir l'analyse"
               Message="Le profil poste, le radar et les axes s'afficheront ici apres selection."
               Tone="empty"
               CssClass="empty-card-inline" />
}
else if (IsBusy && PositionProfile is null)
{
    <PageLoader Kicker="Chargement"
                Title="Analyse du profil poste en cours"
                Message="Lecture de la cohorte, du radar et des axes normalises." />
}
else if (!string.IsNullOrWhiteSpace(ErrorMessage))
{
    <StateCard Kicker="Erreur"
               Title="Profil poste indisponible"
               Message="@ErrorMessage"
               Tone="error" />
}
else if (PositionProfile?.SelectedPlayer is null || PositionProfile.MedianProfile is null)
{
    <StateCard Kicker="Profil indisponible"
               Title="Donnees de profil poste insuffisantes"
               Message="Aucune cohorte disponible pour cette joueuse dans le contexte actuel."
               Tone="empty"
               CssClass="empty-card-inline" />
}
else
{
    var selected = PositionProfile.SelectedPlayer;
    var insights = PositionProfileInsights;

    <div class="anlz-tab">
        <ScopeSummaryBar Items="@PositionProfileScopeItems" />

        <CoachCards Kicker="Lecture coach"
                    Title="Ce que le staff doit retenir tout de suite"
                    Subtitle="@insights.ContextualInsight"
                    Cards="@insights.CoachCards" />

        <section class="page-panel position-profile-snapshot-panel">
            <div class="panel-head panel-head-wrap">
                <div>
                    <p class="section-kicker">Snapshot de profil</p>
                    <h4>Lecture synthese</h4>
                </div>
                @if (!string.IsNullOrWhiteSpace(insights.PerformanceLevel))
                {
                    <span class="hero-badge">@insights.PerformanceLevel</span>
                }
            </div>
            <KpiTileGrid Items="@insights.SnapshotKpis" />
        </section>

        @* ── HalfTime MT1/MT2 (B5.9) ── *@
        <section class="page-panel anlz-halftime-section">
            <div class="panel-head">
                <p class="section-kicker">1re MT vs 2e MT</p>
                <h4>Comparaison mi-temps</h4>
            </div>
            @if (IsHalfTimeBusy)
            {
                <div class="ctx-loading"><span>Chargement…</span></div>
            }
            else if (!string.IsNullOrWhiteSpace(HalfTimeErrorMessage))
            {
                <p class="data-na">Données mi-temps indisponibles</p>
            }
            else if (HalfTimeData?.FirstHalf is null && HalfTimeData?.SecondHalf is null)
            {
                <p class="data-na">Aucune donnée de mi-temps</p>
            }
            else
            {
                var _mt1 = HalfTimeData?.FirstHalf;
                var _mt2 = HalfTimeData?.SecondHalf;
                <table class="data-table">
                    <thead><tr><th>Indicateur</th><th class="data-table__num">1re MT</th><th class="data-table__num">2e MT</th></tr></thead>
                    <tbody>
                    @if (!IsGoalkeeper)
                    {
                        <tr class="table-sub-row"><td>Buts</td><td class="data-table__num">@(_mt1?.Goals ?? 0)</td><td class="data-table__num">@(_mt2?.Goals ?? 0)</td></tr>
                        <tr class="table-sub-row"><td>Tirs</td><td class="data-table__num">@(_mt1?.Attempts ?? 0)</td><td class="data-table__num">@(_mt2?.Attempts ?? 0)</td></tr>
                        <tr class="table-sub-row"><td>Réussite</td><td class="data-table__num">@(_mt1?.ShotSuccessRate.HasValue == true ? $"{_mt1.ShotSuccessRate:0.#}%" : "—")</td><td class="data-table__num">@(_mt2?.ShotSuccessRate.HasValue == true ? $"{_mt2.ShotSuccessRate:0.#}%" : "—")</td></tr>
                        <tr class="table-sub-row"><td>Passes déc.</td><td class="data-table__num">@(_mt1?.Assists ?? 0)</td><td class="data-table__num">@(_mt2?.Assists ?? 0)</td></tr>
                        <tr class="table-sub-row"><td>Pertes</td><td class="data-table__num">@(_mt1?.Turnovers ?? 0)</td><td class="data-table__num">@(_mt2?.Turnovers ?? 0)</td></tr>
                    }
                    else
                    {
                        <tr class="table-sub-row"><td>Arrêts</td><td class="data-table__num">@(_mt1?.Saves ?? 0)</td><td class="data-table__num">@(_mt2?.Saves ?? 0)</td></tr>
                        <tr class="table-sub-row"><td>Tirs subis</td><td class="data-table__num">@(_mt1?.ShotsFaced ?? 0)</td><td class="data-table__num">@(_mt2?.ShotsFaced ?? 0)</td></tr>
                        <tr class="table-sub-row"><td>Taux arrêt</td><td class="data-table__num">@(_mt1?.SaveRate.HasValue == true ? $"{_mt1.SaveRate:0.#}%" : "—")</td><td class="data-table__num">@(_mt2?.SaveRate.HasValue == true ? $"{_mt2.SaveRate:0.#}%" : "—")</td></tr>
                    }
                    </tbody>
                </table>
            }
        </section>

        @* ── Clutch (B5.7-B5.8) ── *@
        <section class="page-panel anlz-clutch-section">
            <div class="panel-head">
                <p class="section-kicker">5 dernières minutes · écart ≤ 2</p>
                <h4>Clutch</h4>
            </div>
            @if (IsClutchBusy)
            {
                <div class="ctx-loading"><span>Chargement…</span></div>
            }
            else if (!string.IsNullOrWhiteSpace(ClutchErrorMessage))
            {
                <p class="data-na">Données clutch indisponibles</p>
            }
            else if (ClutchData is null || ClutchData.SampleCount == 0)
            {
                <p class="data-na">Aucune donnée clutch disponible pour ce scope</p>
            }
            else
            {
                var _clutch = ClutchData;
                @if (_clutch.SampleCount < 5)
                {
                    <p class="court-sample-note">Échantillon limité (@_clutch.SampleCount évènements)</p>
                }
                <div class="badge-row">
                    <div class="mini-card"><span>Évènements</span><strong>@_clutch.SampleCount</strong></div>
                </div>
                <table class="data-table">
                    <thead><tr><th>Indicateur</th><th class="data-table__num">Valeur</th></tr></thead>
                    <tbody>
                    @if (!IsGoalkeeper)
                    {
                        <tr class="table-sub-row"><td>Buts</td><td class="data-table__num">@_clutch.Goals</td></tr>
                        <tr class="table-sub-row"><td>Tirs</td><td class="data-table__num">@_clutch.Attempts</td></tr>
                        <tr class="table-sub-row"><td>Réussite</td><td class="data-table__num">@(_clutch.ShotSuccessRate.HasValue ? $"{_clutch.ShotSuccessRate:0.#}%" : "—")</td></tr>
                        <tr class="table-sub-row"><td>Passes déc.</td><td class="data-table__num">@_clutch.Assists</td></tr>
                        <tr class="table-sub-row"><td>Pertes</td><td class="data-table__num">@_clutch.Turnovers</td></tr>
                    }
                    else
                    {
                        <tr class="table-sub-row"><td>Arrêts</td><td class="data-table__num">@_clutch.Saves</td></tr>
                        <tr class="table-sub-row"><td>Tirs subis</td><td class="data-table__num">@_clutch.ShotsFaced</td></tr>
                        <tr class="table-sub-row"><td>Taux arrêt</td><td class="data-table__num">@(_clutch.SaveRate.HasValue ? $"{_clutch.SaveRate:0.#}%" : "—")</td></tr>
                    }
                    </tbody>
                </table>
            }
        </section>

        @* ── GK ScoreState (B5.11) — gardienne uniquement ── *@
        @if (IsGoalkeeper)
        {
            <section class="page-panel anlz-gk-scorestate-section">
                <div class="panel-head">
                    <p class="section-kicker">Gardienne selon le score</p>
                    <h4>Taux d'arrêt par situation</h4>
                </div>
                @if (IsGkScoreStateBusy)
                {
                    <div class="ctx-loading"><span>Chargement…</span></div>
                }
                else if (!string.IsNullOrWhiteSpace(GkScoreStateErrorMessage))
                {
                    <p class="data-na">Données score-état indisponibles</p>
                }
                else if (GkScoreStateData is null || GkScoreStateData.ByScoreState.Count == 0)
                {
                    <p class="data-na">Aucune donnée disponible</p>
                }
                else
                {
                    <table class="data-table">
                        <thead><tr><th>Situation</th><th class="data-table__num">Arrêts</th><th class="data-table__num">Tirs subis</th><th class="data-table__num">Taux arrêt</th></tr></thead>
                        <tbody>
                        @foreach (var _ss in GkScoreStateData.ByScoreState)
                        {
                            var _ssLabel = _ss.ScoreState switch { "Leading" => "En avance", "Tied" => "Égalité", "Trailing" => "Menée", _ => _ss.ScoreState };
                            <tr class="table-sub-row @(!_ss.SampleReliable ? "table-sub-row--warn" : string.Empty)">
                                <td>@_ssLabel @if (!_ss.SampleReliable) { <span class="data-insufficient">⚠</span> }</td>
                                <td class="data-table__num">@_ss.Saves</td>
                                <td class="data-table__num">@_ss.ShotsFaced</td>
                                <td class="data-table__num">@(_ss.SaveRate.HasValue ? $"{_ss.SaveRate:0.#}%" : "—")</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                }
            </section>
        }

        <div class="anlz-charts-row">
            <PositionProfileHistogram @key="AnlzHistogramKey"
                                      Kicker="Histogramme poste"
                                      Title="Valeurs de la joueuse face a la mediane du poste"
                                      ChartKey="@AnlzHistogramKey"
                                      Axes="@PositionProfileChartRows"
                                      HighlightedAxisKeys="@insights.HighlightAxisKeys"
                                      AlertAxisKeys="@insights.AlertAxisKeys"
                                      SelectedSeriesLabel="@selected.FullName"
                                      MedianSeriesLabel="Mediane du poste"
                                      Height="440" />

            <PositionRadarChart @key="AnlzRadarKey"
                                Kicker="Radar normalise"
                                Title="Forme du profil (normalisee)"
                                Subtitle="Forme du profil normalisee face a la mediane du poste."
                                ChartKey="@AnlzRadarKey"
                                Axes="@PositionProfileChartRows"
                                MedianSeries="@PositionProfileChartMedianRadarSeries"
                                HighlightedAxisKeys="@insights.HighlightAxisKeys"
                                AlertAxisKeys="@insights.AlertAxisKeys"
                                SelectedSeriesLabel="@selected.FullName"
                                MedianSeriesLabel="Mediane du poste"
                                AxisCount="@PositionProfileChartRows.Count"
                                Width="720"
                                Height="560" />
        </div>

        <div class="anlz-legend">
            <span class="anlz-legend-dot anlz-legend-dot--player"></span>
            <span>@selected.FullName</span>
            <span class="anlz-legend-dot anlz-legend-dot--median"></span>
            <span>Mediane du poste</span>
        </div>

        <DetailedTable Kicker="Lecture detaillee"
                       Title="Chaque axe du poste"
                       Subtitle="Tri par impact pour faire remonter les ecarts les plus importants avant le match."
                       Rows="@PositionProfileDetailRows"
                       HighlightedAxisKeys="@insights.HighlightAxisKeys"
                       AlertAxisKeys="@insights.AlertAxisKeys" />

        <div class="anlz-export-toolbar">
            <button type="button" class="ghost-button" @onclick="ExportCsvAsync" disabled="@IsBusy">Exporter CSV</button>
        </div>

        @* ── Analyse contextuelle (CAT-19) ── *@
        <section class="page-panel ctx-panel">
            <div class="panel-head">
                <div>
                    <p class="section-kicker">Analyse contextuelle</p>
                    <h4>Selon le contexte de jeu</h4>
                </div>
            </div>

            @if (IsContextBusy)
            {
                <div class="ctx-loading"><span>Chargement des données contextuelles…</span></div>
            }
            else if (!string.IsNullOrWhiteSpace(ContextErrorMessage))
            {
                <StateCard Kicker="Erreur"
                           Title="Données contextuelles indisponibles"
                           Message="@ContextErrorMessage"
                           Tone="error" />
            }
            else if (EventContexts is null)
            {
                <StateCard Kicker="Aucune donnée"
                           Title="Analyse contextuelle non disponible"
                           Message="Aucune donnée contextuelle disponible pour ce scope."
                           Tone="empty"
                           CssClass="empty-card-inline" />
            }
            else
            {
                var _availDims = ContextAnalyticsHelper.GetAvailableDimensions(EventContexts);

                @if (_availDims.Count == 0)
                {
                    <StateCard Kicker="Aucune donnée"
                               Title="Pas de données contextuelles"
                               Message="Aucune donnée contextuelle disponible pour ce scope."
                               Tone="empty"
                               CssClass="empty-card-inline" />
                }
                else
                {
                    <div class="ctx-selector">
                        <span class="ctx-selector__label">Vue par</span>
                        @foreach (var _dim in Enum.GetValues<ContextDimension>())
                        {
                            @if (ContextAnalyticsHelper.GetRows(EventContexts, _dim).Any(r => r.Events > 0))
                            {
                                <button type="button"
                                        class="filter-chip @(ActiveContextDimension == _dim ? "filter-chip--active" : "")"
                                        @onclick="() => ActiveContextDimension = _dim">
                                    @ContextAnalyticsHelper.GetDimensionLabel(_dim)
                                </button>
                            }
                        }
                    </div>
                    var _ctxRows = ContextAnalyticsHelper.GetRows(EventContexts, ActiveContextDimension);
                    <ContextSplitTable Title="@ContextAnalyticsHelper.GetDimensionLabel(ActiveContextDimension)"
                                       Rows="@_ctxRows"
                                       IsGoalkeeper="@IsGoalkeeper" />
                }
            }
        </section>

        @if (IsBusy)
        {
            <div class="anlz-refresh-indicator"><span>Actualisation…</span></div>
        }
    </div>
}
